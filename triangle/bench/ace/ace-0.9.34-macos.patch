+		/* one line per glb: its declared (non-glb) supertypes, sorted */
+		struct type_hierarchy *th = default_type_hierarchy();
+		FILE *df = fopen(getenv("ACE_GLB_DUMP"), "w");
+		int *seen = calloc(th->ntypes, sizeof(int)), gen = 0;
+		struct type **stack = malloc(sizeof(struct type*) * th->ntypes);
+		char **names = malloc(sizeof(char*) * th->ntypes);
+		int i;
+		for(i=0;i<th->ntypes;i++)
+		{
+			struct type *t = th->types[i];
+			if(strncmp(t->name, "g(", 2))continue;
+			int sp = 0, nn = 0, j;
+			gen++;
+			stack[sp++] = t;
+			while(sp)
+			{
+				struct type *u = stack[--sp];
+				for(j=0;j<u->nparents;j++)
+				{
+					struct type *p = u->parents[j];
+					if(seen[p->tnum] == gen)continue;
+					seen[p->tnum] = gen;
+					stack[sp++] = p;
+					if(strncmp(p->name, "g(", 2))names[nn++] = p->name;
+				}
+			}
+			qsort(names, nn, sizeof(char*), strcmp_ptr_for_glb_dump);
+			for(j=0;j<nn;j++)fprintf(df, "%s%s", j?" ":"", names[j]);
+			fprintf(df, "\n");
+		}
+		fclose(df);
+	}
 
