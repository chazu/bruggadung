// What agents say (KNOWLEDGE.md §10). An utterance's content is a structure,
// carried by the "said" event, and whoever is in earshot perceives it.
// Content names no referents: it describes things by kind, features, and
// where they are, and each hearer binds them to referents of its own by
// recognition.

// Every utterance is about something like `what`.
#Utterance: { what: #Body }

// An utterance about something like `what` inside `within`.
#Placing: #Utterance & { within: #Body }

// A question expects an answer from the one it is put to.
#Question: #Utterance & {}

// Where is something like `what`?
#WhereIs: #Question & {}

// Someone shouts the hearer's name (`what`: the hearer, by looks): a call,
// answered with `#Here`, which may be worth putting down what it is doing
// (AGENCY.md §7, a soft interruption).
#Call: #Question & {}
#Here: #Utterance & {}

// Who told you something like `what` is inside `within`? (questioning a
// source, KNOWLEDGE.md §10). The answer is the claim again, with its source.
#WhoToldYou: #Question & #Placing & {}

// How the speaker says it knows (the attribution, KNOWLEDGE.md §10): it saw
// it, as sure as its memory of it is strong (in dB), or heard it, from
// someone it describes, or from no one it names.
#Source: {}
#Saw:    #Source & { sure: int }
#Heard:  #Source & { from: #Agent }
// A promise (AGENCY.md §7): the speaker will see to it, by `when`. Hearers
// hold it as a claim about then, kept or broken as they come to find.
#Pledged: #Source & {}

// A claim, as of `when`, with how the speaker says it knows.
#Telling: #Utterance & { when: time, attribution: #Source }

// A claim: something like `what` is inside `within`.
#IsIn: #Placing & #Telling & {}

// A claim: something like `what` is like `as` (its features: "the nut is
// 22 mm"). Where it conflicts with what the hearer believes of it, the two
// coexist as competing hypotheses (KNOWLEDGE.md §11), the claim's as
// credible as the hearer finds the speaker.
#IsLike: #Telling & { as: #Body }

// A claim naming someone like `holder`.
#Naming: #Telling & { holder: #Agent }

// A claim: something like `what` is held by someone like `holder`.
#IsHeld: #Naming & {}

// Give me something like `what`? A request is a question: the asker waits
// for the answer.
#Request: #Question & {}

// The speaker knows of nothing like `what` that it could say where it is.
#DontKnow: #Utterance & {}

// A claim: something like `what` is reserved for someone like `holder`
// (ACTIONS.md §7): a soft claim, which never blocks anyone taking it.
#ReservedFor: #Naming & {}

// A claim: something like `what` is someone like `holder`'s own
// (INSTITUTIONS.md: what makes taking it a wrong).
#OwnedBy: #Naming & {}

// A grievance (INSTITUTIONS.md decision 6): something like `what`, someone
// like `holder`'s own, was taken by someone like `taker`. Told to an office
// holder, it is ordinary knowledge, weighed by who says it.
#Grievance: #Naming & { taker: #Agent }

// The speaker won't say where something like `what` is, or give it
// (AGENCY.md §11).
#WontSay: #Utterance & {}

// Asked for something like `what`: the speaker has nothing like it; or has
// given it.
#HaveNone: #Utterance & {}
#Granted:  #Utterance & {}

// Say something to an agent in reach. What is said is the command's.
say: #Operation & {
    effect:   "say"
    duration: 1s
    uses:     ["voice"]
    roles: {
        actor: #Agent
        item:  #Agent
    }
} @family(operations)

// Records (KNOWLEDGE.md §10, §15): a body that carries writing. Writing is
// the copy operation: what the writer believes becomes content, with the
// writer as its author; whoever reads it gains claims whose source is the
// author and whose medium is the record. It can be stolen, and read by the
// thief, and the writer's memory is untouched.
#Record: #Body & {
    @component(Record)
    writing: text @field(saved, proposable, inspect)
}

// A label (ACTIONS.md §7's tag on a shelf): a record whose writing anyone
// within `legible` tiles of it reads at a glance, on sighting it.
#Label: #Record & {
    @component(Label)
    legible: int & >=0 & <=8                @field(content, saved, inspect, perceive(sight))
}

// What a record holds: who wrote it, by their looks, and the claims written.
#Writing: { author: #Agent, entries: [...#Telling] }

// A claim: something like `what` serves `line` (a diagram's: which cock shuts
// off which line).
#Serves: #Telling & { line: text }

// Write a claim into a record the actor holds. What is written is the
// command's: a #Writing with one entry.
write_down: #Operation & {
    effect: "write"
    uses:   ["hands"]
    roles: {
        actor: #Agent & { id: $a }
        item:  #Record & { place: #Held & { by: $a } }
    }
} @family(operations)

// Read a record within reach: a second's reading, what it holds taken in
// when it ends.
read: #Operation & {
    effect:   "read"
    duration: 1s
    roles: {
        actor: #Agent
        item:  #Record
    }
} @family(operations)
