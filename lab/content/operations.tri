// Operations (ACTIONS.md §1): patterns over the descriptions of the entities
// that fill their roles. An actor's menu lists each operation and binding
// whose match is not incompatible; unknown never excludes. Tags carry
// bindings between roles. `effect` names the code that builds the proposal
// group when the action is performed.

#Effect: "take" | "take_some" | "put_in" | "drive" | "open_tap" | "fill" | "walk" | "loosen" | "look" | "say" | "tend" | "analyse" | "write" | "read" | "eat" | "give" | "investigate" | "tighten" | "rotate" | "strike" | "shut" | "dismantle" | "light" | "rest" | "open_door" | "saw" | "pass" | "copy" | "reveal" | "replace" | "cut" | "shape" | "install" | "issue" | "confiscate" | "arrest" | "flee" | "hit" | "hire" | "work" | "service"

// Which roles an operation has is its roles' type: a structure's type is the
// most general one with all its features.
#Roles:        { actor: #Agent }
#ItemRoles:    #Roles & { item: #Body }
#PlacingRoles: #ItemRoles & { destination: #Body }

// Something that takes time and has an effect: an operation's single stage,
// or one of its stages. A stage whose progress shows in the world declares
// it `partial` (ACTIONS.md §5): a field of a role's entity (`showsOn`), the `whole` it
// reaches as the stage completes. It is set in proportion to the stage's
// progress at each of its `checkpoints` (evenly spaced; each a step
// boundary), and when the activity is interrupted: suspended, aborted, or
// failed. Its effect proper commits on completion, with its `exertion`: the
// fatigue it adds to the actor (AGENCY.md §6). With a `floodWatch`, water
// rising to that many millilitres on the actor's tile interrupts it. A hard interruption
// (what it binds gone or out of reach, or what it needs no longer holding)
// suspends it, or fails it, as it declares (`hard`).
#Partial: { field: text, showsOn: *"destination" | "item", whole: int }
#Step: {
    duration:    time & >=0ms & <=1d
    effect:      #Effect
    partial:     #Partial
    checkpoints: *0 | int & >=0 & <=100
    hard:        *"suspend" | "fail"
    exertion:    *0 | int & >=0 & <=100
    floodWatch:  *0 | int & >=0 & <=1000000
    leaves:      [...#Leaves]
    removes:     [...#Removes]
}

// A stage of an activity: it takes `duration`, and its effect commits when
// it is done (ACTIONS.md §5).
#Stage: #Step & { duration: >=1ms }

// What of the actor's an activity occupies while it runs (ACTIONS.md §5,
// provider allocation): an actor runs two activities at once only if they
// use different providers. Walking while driving a nail is two activities;
// two walks are not.
#Provider: "hands" | "legs" | "voice"

// An operation with stages, or with a duration (one stage), is a timed
// activity, which can be suspended and resumed, keeping its progress. One
// without is instant, unless its effect's code makes it an activity that ends
// by a watch or an event (fill).
// `attention` is what it demands of the actor while it runs (AGENCY.md
// §10): it raises what the actor must find salient to notice it. `leaves`
// and `removes` are its traces (KNOWLEDGE.md §3, traces.tri), made and
// removed with its effect, when it completes: an operation that removes
// traces leaves some of its own, so a cover-up can be found out. A stage
// may leave its own, with its own effect (ACTIONS.md §2: costs are
// committed per stage).
#Operation: #Step & {
    roles:     #Roles
    stages:    [...#Stage]
    uses:      [...#Provider]
    attention: *0 | int & >=0 & <=100
    contest:   text
    graded:    #Graded
}

// A graded requirement (ACTIONS.md decision 11): what a role brings (the
// `offers` field of the `offerer`'s entity) as a percent of what another
// demands (`demands`, of the `demander`'s). Curves over that percent, as
// agency's considerations have: how long it takes, in percent (`slowing`);
// the chance of a mishap, in thousandths (`mishap`), leaving its `slip`;
// and the result's quality, in percent, set on the demander's `grades`.
#Graded: {
    offerer:  #TraceSite
    offers:   text
    demander: #TraceSite
    demands:  text
    slowing:  [...#Point]
    mishap:   [...#Point]
    slip:     #Leaves
    quality:  [...#Point]
    grades:   text
}

// `contest` (ACTIONS.md decision 13): the actor's field that weights its
// groups when they conflict with others in the action phase; taking is a
// matter of quickness. Without one, who goes first is an even draw.

// Pick something up into a free hand: from a container, the ground, or an
// assembly it is installed in.
take: #Operation & {
    effect:  "take"
    contest: "quickness"
    roles: {
        actor: #Agent & { freeHands: >=1 }
        item:  #Body & { place: #Inside | #OnTile | #Installed }
    }
} @family(operations) @quickcheck(actor.freeHands)

// Take some units of a stack into a free hand: from a container, the ground,
// or the actor's other hand. How many is the command's.
take_some: #Operation & {
    effect:  "take_some"
    contest: "quickness"
    roles: {
        actor: #Agent & { id: $a, freeHands: >=1 }
        item:  #Stack & { place: #Inside | #OnTile | #Held & { by: $a } }
    }
} @family(operations) @quickcheck(actor.freeHands)

// Put something the actor holds into a container.
put_in: #Operation & {
    effect: "put_in"
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Body & { place: #Held & { by: $a } }
        destination: #Container
    }
} @family(operations)

// Drive a held nail into an assembly, as a wedge: it bends and takes tool
// marks. From a stack, one nail is driven.
drive: #Operation & {
    effect:    "drive"
    duration:  4s
    uses:      ["hands"]
    attention: 10
    leaves:    [{ trace: "tool_marks", on: "destination", strength: 60 },
                { trace: "scuffs", on: "tile", strength: 40 }]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Body & { material: "iron", place: #Held & { by: $a } }
        destination: #Assembly
    }
} @family(operations)

// Open a tap the actor can reach.
open_tap: #Operation & {
    effect: "open_tap"
    roles: {
        actor: #Agent
        item:  #Tap & { open: false }
    }
} @family(operations)

// Fill a bucket from a tap: open it, and keep filling until the bucket holds
// the command's amount (a watch on the bucket) or the source runs dry (the
// tap's "exhausted"). The bucket must sit in the tap.
fill_bucket: #Operation & {
    effect: "fill"
    roles: {
        actor:       #Agent
        item:        #Tap & { id: $t, open: false }
        destination: #WaterStore & #Body & { place: #Inside & { container: $t } }
    }
} @family(operations)

// Walk one tile, an activity of a second; the direction is in the
// operation's name. The walker arrives when it is done. What the actor holds
// goes along: it is held by the actor, wherever the actor is.
#Walk: #Operation & {
    effect:   "walk"
    duration: 1s
    uses:     ["legs"]
    roles:    { actor: #Agent & { place: #OnTile } }
}

walk_north: #Walk @family(operations)
walk_south: #Walk @family(operations)
walk_east:  #Walk @family(operations)
walk_west:  #Walk @family(operations)

// Pry a wedged nail out of an assembly: loosen it, then pull it free into a
// free hand. Walking away suspends it; coming back, it can be resumed.
pry_out: #Operation & {
    effect:    "take"
    stages:    [{ duration: 3s, effect: "loosen", leaves: [{ trace: "scratch", on: "item", strength: 30 }] },
                { duration: 2s, effect: "take" }]
    uses:      ["hands"]
    attention: 10
    roles: {
        actor: #Agent & { freeHands: >=1 }
        item:  #Body & { place: #Installed }
    }
} @family(operations)

// Look into a container: what is inside is perceived only by looking.
look_in: #Operation & {
    effect: "look"
    roles: {
        actor: #Agent
        item:  #Container
    }
} @family(operations)

// Wash the floor where the actor stands: the scuffs go, and the floor is left
// damp, smelling of soap.
wash_floor: #Operation & {
    effect:    "tend"
    duration:  10s
    uses:      ["hands"]
    attention: 5
    roles:     { actor: #Agent & { place: #OnTile } }
    removes:   [{ trace: "scuffs", on: "tile" }]
    leaves:    [{ trace: "damp_floor", on: "tile", strength: 60 },
                { trace: "soap_smell", on: "tile", strength: 50 }]
} @family(operations)

// Touch up the paint on an assembly: its tool marks go under fresh paint,
// which smells.
touch_up: #Operation & {
    effect:    "tend"
    duration:  20s
    uses:      ["hands"]
    attention: 10
    roles: {
        actor: #Agent
        item:  #Assembly
    }
    removes: [{ trace: "tool_marks", on: "item" }]
    leaves:  [{ trace: "fresh_paint", on: "item", strength: 80 },
              { trace: "paint_smell", on: "item", strength: 70 }]
} @family(operations)

// Scratch a body to see what it is made of beneath its surface (an analysis,
// KNOWLEDGE.md §4): the actor learns its true material; the scratch stays.
test_scratch: #Operation & {
    effect:    "analyse"
    duration:  3s
    uses:      ["hands"]
    attention: 10
    roles: {
        actor: #Agent
        item:  #Body & { place: #OnTile | #Installed }
    }
    leaves: [{ trace: "scratch", on: "item", strength: 40 }]
} @family(operations)

// Eat what the actor holds: a while, with the hands, easily put down. It
// is gone, and the actor is fed.
eat: #Operation & {
    effect:    "eat"
    duration:  60s
    uses:      ["hands"]
    attention: 5
    roles: {
        actor: #Agent & { id: $a }
        item:  #Body & { material: "food", place: #Held & { by: $a } }
    }
} @family(operations)

// Knock things over, as a cat does at night: a clatter where it is.
knock_over: #Operation & {
    effect: "tend"
    roles:  { actor: #Agent & { hands: 0 } }
    leaves: [{ trace: "clatter", on: "tile", strength: 60 }]
} @family(operations)

// Give something the actor holds to someone in reach, into a free hand.
give: #Operation & {
    effect: "give"
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Body & { place: #Held & { by: $a } }
        destination: #Agent & { freeHands: >=1 }
    }
} @family(operations)

// Investigate where the actor is (KNOWLEDGE.md §9, deliberate): half a
// minute watching closely, which ends with the actor noticing fainter traces
// and drawing the rules that take thought.
watch_closely: #Operation & {
    effect:    "investigate"
    duration:  30s
    attention: 20
    roles:     { actor: #Agent & { place: #OnTile } }
} @family(operations)

// Take something up, carefully: a second, then into a free hand. Two who
// start together finish together, and only one gets it. Taken from where it
// was meanwhile, the take fails: there is nothing to come back to.
take_up: #Operation & {
    effect:   "take"
    contest:  "quickness"
    duration: 1s
    uses:     ["hands"]
    hard:     "fail"
    roles: {
        actor: #Agent & { freeHands: >=1 }
        item:  #Body & { place: #OnTile | #Inside }
    }
} @family(operations)

// Tighten a nut with a spanner the actor holds that fits it: the same size.
tighten: #Operation & {
    effect: "tighten"
    uses:   ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Spanner & { size: $s, place: #Held & { by: $a } }
        destination: #Fastener & { size: $s, tight: false }
    }
} @family(operations)

// Peer at a nut in reach: up close, its size is plain.
peer_at: #Operation & {
    effect: "look"
    roles: {
        actor: #Agent
        item:  #Fastener
    }
} @family(operations)

// Turn a valve (ACTIONS.md Scenario 1): with the best chain of what the
// actor can reach (taking up what it doesn't hold, a take_up's time each,
// twice from a container), hand, wrench, pipe over the wrench; the command's amount, if
// any, holds the torque steady there (Nm). The stage commits the torque
// applied; the valve's reaction decides what happens.
rotate_valve: #Operation & {
    effect:   "rotate"
    duration: 2s
    uses:     ["hands"]
    roles: {
        actor: #Agent
        item:  #Valve & { turned: false }
    }
} @family(operations)

// Strike something with a stone the actor holds: a blow, which loosens
// what has seized.
strike: #Operation & {
    effect: "strike"
    uses:   ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Body & { material: "stone", place: #Held & { by: $a } }
        destination: #Valve
    }
} @family(operations)

// Hit someone in reach (AGENCY.md §13): a blow, an injury of 15 to its
// body, which it feels, and knows who dealt.
hit: #Operation & {
    effect:   "hit"
    duration: 1s
    uses:     ["hands"]
    roles: {
        actor: #Agent
        item:  #Agent
    }
} @family(operations)

// Shut a cock in reach.
shut_off: #Operation & {
    effect: "shut"
    roles: {
        actor: #Agent
        item:  #Cock & { shut: false }
    }
} @family(operations)

// Dismantle a pump with a wrench in hand: the gland nut, the cover, then the
// piston out; open at the end.
dismantle: #Operation & {
    effect: "dismantle"
    stages: [{ duration: 3s, effect: "tend" }, { duration: 3s, effect: "tend" }, { duration: 5s, effect: "dismantle" }]
    uses:   ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Turner & #Body & { place: #Held & { by: $a } }
        destination: #Pump & { opened: false }
    }
} @family(operations)

// Light a stove in reach, with fuel in it.
light: #Operation & {
    effect: "light"
    roles: {
        actor: #Agent
        item:  #Combustor & #Body & { lit: false }
    }
} @family(operations)

// Saw a log through, with a saw in hand: its cut shows as it goes, so a
// half-sawn log is left when the sawing stops.
saw_through: #Operation & {
    effect:      "saw"
    duration:    8s
    uses:        ["hands"]
    partial:     { field: "Log.sawn", whole: 100 }
    checkpoints: 3
    exertion:    30
    // the saw's sharpness against the log's hardness: half as sharp as the
    // wood is hard, three times as long, a slip one time in two, and a
    // rough cut
    graded: {
        offerer: "item", offers: "HandSaw.sharpness", demander: "destination", demands: "Log.hardness"
        slowing: [{ input: 50, output: 300 }, { input: 100, output: 100 }]
        mishap:  [{ input: 50, output: 500 }, { input: 100, output: 0 }]
        slip:    { trace: "scratch", on: "destination", strength: 40 }
        quality: [{ input: 50, output: 40 }, { input: 100, output: 90 }, { input: 150, output: 100 }]
        grades:  "Log.finish"
    }
    roles: {
        actor:       #Agent & { id: $a }
        item:        #HandSaw & { place: #Held & { by: $a } }
        destination: #Log & { sawn: <=99 }
    }
} @family(operations)

// Go through an open door in reach (KNOWLEDGE.md Scenario 3): onto its
// tile, and so past it. Believed open and shut, it is a bump into it.
go_through: #Operation & {
    effect: "pass"
    roles: {
        actor: #Agent
        item:  #Door & { ajar: true }
    }
} @family(operations)

// Open a door in reach: the air on its two sides mixes faster.
open_door: #Operation & {
    effect: "open_door"
    roles: {
        actor: #Agent
        item:  #Door & { ajar: false }
    }
} @family(operations)

// Rest a while, 8 hours (rested through, fatigue is gone), with a watch on the air: woken when its carbon
// dioxide reaches the command's amount (mmol; 4,000 if none).
while_away: #Operation & {
    effect:   "rest"
    duration: 8h
    uses:     ["hands", "legs"]
    roles:    { actor: #Agent & { place: #OnTile } }
} @family(operations)
