// Air, for DOMAIN_SIMULATION.md's first scenario, "The unattended stove".
// Gas is a stock: whole millimoles of oxygen and carbon dioxide, and whole
// joules of the heat the gas carries, held by a region of air (the room)
// and moved by the atmosphere domain while anything there changes. The rest
// of the air (nitrogen) is the region's fixed total, less those two. Solids
// hold heat too, in the thermal domain: a stove's iron, a room's walls.

// A region of air: the room (TERRAIN.md, step 3) of the tile at (`atX`,
// `atY`, `atLevel`), its tiles found from the terrain, bounded by what is
// solid and by doorways. A tile in no room with air is outdoors, at 275 K
// and of fixed composition. The region opens through each doorway at its
// room's side to the region beyond, or the outdoors: as much as the
// doorway's draught a second each way, or, a door standing in it, the
// door's `wide` while it is ajar and nothing while it is shut. It leaks to
// the outdoors besides, through walls and windows: `gap` mmol a second each
// way. A wall built across it parts its air between the sides, by their
// tiles; a wall knocked through to another room's air joins them; a room
// opened to the outdoors airs out.
#GasStore: {
    @component(GasStore)
    oxygen:  int & >=0 & <=100000000           @field(content, saved, proposable, inspect)
    dioxide: int & >=0 & <=100000000           @field(content, saved, proposable, inspect)
    gasHeat: int & >=0 & <=1000000000000       @field(content, saved, proposable, inspect)
    total:   int & >=1 & <=100000000           @field(content, saved, inspect)
    atX:     int & >=0 & <=100000              @field(content, saved, inspect)
    atY:     int & >=0 & <=100000              @field(content, saved, inspect)
    atLevel: *0 | int & >=0 & <=63             @field(content, saved, inspect)
    gap:     *0 | int & >=0 & <=1000000        @field(content, saved, proposable, inspect)
}

// A door between two regions of air.
#Door: #Body & {
    @component(Door)
    ajar: *false | true                        @field(content, saved, proposable, inspect, perceive(sight))
    wide: int & >=0 & <=1000000                @field(content, saved, inspect)
}

// A stove's firebox: lit or not, its damper open to the flue or not, and how
// fast it burns at most (mg of wood a second).
#Combustor: {
    @component(Combustor)
    lit:      *false | true                    @field(content, saved, proposable, inspect, perceive(sight))
    damper:   *true | false                    @field(content, saved, proposable, inspect, perceive(sight))
    burnRate: int & >=0 & <=100000             @field(content, saved, inspect)
}

// Fuel in a stove, a stock the atmosphere domain checks out while it burns.
#FuelContainer: {
    @component(FuelContainer)
    fuel: mass & >=0g & <=1000kg               @field(content, saved, proposable, inspect)
}

// A solid's heat: whole joules, owned by the thermal domain while it
// changes, and its capacity (J/K). How fast it exchanges heat with the air
// around it (W/K), which the atmosphere computes and sends it, and with the
// outdoors (W/K), which the thermal domain does. A body with no place names
// the air it bounds: a room's shell.
#ThermalBody: {
    @component(ThermalBody)
    heat:         int & >=0 & <=1000000000000  @field(content, saved, proposable, inspect)
    heatCapacity: int & >=1 & <=1000000000     @field(content, saved, proposable, inspect)
    toAir:        int & >=0 & <=100000         @field(content, saved, inspect)
    toOutdoors:   int & >=0 & <=100000         @field(content, saved, inspect)
    bounds:       ref                          @field(saved, proposable, inspect)
}

// A stove's iron takes three tenths of its fire's heat; the rest goes up the
// flue, or, damper closed, into the room.
#Stove: #Body & #Combustor & #FuelContainer & #ThermalBody & {}

// The stone of a room's walls, floor and ceiling, its inner layer: what
// warms with the air.
#Shell: #ThermalBody & {}

// What breathes: the oxygen it takes from the air over it (mmol a thousand
// seconds), at rest and at work, giving back four fifths as much carbon
// dioxide and 448 J for each mmol to its body. And the air it rests easy in
// (mK; 0, no bound): a rest wakes when the air leaves it.
#Respirator: {
    @component(Respirator)
    atRest:     int & >=0 & <=100000           @field(content, saved, inspect)
    atWork:     int & >=0 & <=100000           @field(content, saved, inspect)
    restsAbove: int & >=0 & <=400000           @field(content, saved, proposable, inspect)
    restsBelow: int & >=0 & <=400000           @field(content, saved, proposable, inspect)
}

// A 4 by 5 room (rooms_map, terrain.tri), at 275 K, with 2 mol of air for
// each of its 20 m3 or so: 2,000,000 mmol, 21% oxygen, 0.04% carbon dioxide;
// its heat, 29 mJ per mmol per kelvin.
room_air:   #GasStore & { oxygen: 420000, dioxide: 800, gasHeat: 15950000, total: 2000000,
                          atX: 1, atY: 1 }
// another room like it, beside it
back_room:  #GasStore & { oxygen: 420000, dioxide: 800, gasHeat: 15950000, total: 2000000,
                          atX: 6, atY: 1 }
// a corridor ten times the room, leaking to the outdoors along its length
corridor:   #GasStore & { oxygen: 4200000, dioxide: 8000, gasHeat: 159500000, total: 20000000,
                          atX: 1, atY: 7, gap: 2000 }
// air a wall has parted from a room's: its share, set as it parts
parted_air: #GasStore & { oxygen: 0, dioxide: 0, gasHeat: 0, total: 1, atX: 0, atY: 0 }
// a room's door, open: a cubic metre a minute or so
room_door:  #Door & { material: "oak", mass: 30kg, wide: 5000 }
stove:      #Stove & { material: "iron", mass: 120kg, burnRate: 250, fuel: 3kg,
                       heat: 12375000, heatCapacity: 45000, toAir: 20, toOutdoors: 0 }
// at 275 K
// someone to rest by the stove: at 310 K, 70 kg at 3.5 kJ/kg/K, abed and
// clothed (4 W/K)
lodger:     #Agent & #Respirator & #ThermalBody & {
    material: "flesh", mass: 70kg, hands: 2, coat: "grey",
    atRest: 190, atWork: 600, restsAbove: 0, restsBelow: 0,
    heat: 75950000, heatCapacity: 245000, toAir: 4, toOutdoors: 0 }
room_shell: #Shell & { heat: 1100000000, heatCapacity: 4000000, toAir: 100, toOutdoors: 50 }
