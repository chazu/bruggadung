// Hunting, butchering: what an animal's carcass yields (VILLAGE.md decision
// 7, slice 7).
//
// Cut points:
// - full:     a carcass is butchered where it lies, a hand free: half an
//             hour, and its meat (a stack of raw food, cooked as any is:
//             cooking/) is in a pack the butcher carries, if it fits, else
//             the free hand (carrying/); its hide is left lying there, to be
//             picked up, and the rest is waste.
// - reduced:  the same; butchering runs its time.
// - abstract: as reduced.
// - frozen:   nothing is butchered; a carcass keeps.
// - perishing: meat keeps three days from when it is butchered, then
//             spoils (perishing/). A carcass left unbutchered keeps two
//             days, then is carrion, which nobody butchers, and which rots
//             away as spoiled food does.
// - harm:     a carcass is what harm/'s death makes of an animal: as heavy
//             as it was.
// - cooking:  meat is raw food; in a larder it merges with meat already
//             there, as grain does.
// - code:     effect_butcher (src/act_actions.odin).

package hunting

// A carcass: what it yields, butchered: so many cuts of meat (`yields`, a
// stack's blueprint, a unit to a cut), and a hide. Left two days, it is
// carrion (perishing/).
#Carcass: #Body & #Perishable & {
    @component(Carcass)
    yields:   text @field(content, saved, inspect)
    cuts:     int & >=0 & <=200 @field(content, saved, inspect)
    hide:     text @field(content, saved, inspect)
    keepsFor: 2d
    spoiled:  "carrion"
}

carcass_seen: #Seen & { kindOf: "#Carcass" } @family(seen)
carcass_look: #Look & { kindOf: "#Carcass", look: "carcass" } @family(looks)

deer_carcass: #Carcass & { material: "flesh", mass: 60kg, yields: "venison", cuts: 40, hide: "deer_hide" }
hare_carcass: #Carcass & { material: "flesh", mass: 3kg, yields: "hare_meat", cuts: 3, hide: "hare_pelt" }

// A carcass gone off: rot, as spoiled food is; its mass is the carcass's.
carrion:      #Spoiled & { material: "rot", mass: 1g }
carrion_look: #Look & { kindOf: "carrion", look: "carcass.carrion" } @family(looks)

// Meat, raw: a cut is a portion, as grain's is (cooking/). It keeps three
// days in a cool larder, then spoils (perishing/).
venison:   #Stack & #Food & { material: "food", raw: true, nourishment: 20, cooking: 40, keepsFor: 3d, unit: "venison", unitMass: 500g, count: 1 }
hare_meat: #Stack & #Food & { material: "food", raw: true, nourishment: 20, cooking: 30, keepsFor: 3d, unit: "hare meat", unitMass: 500g, count: 1 }

// Hides: leather to be, when there is someone to dress them.
#Hide: #Body & {}

hide_seen: #Seen & { kindOf: "#Hide" } @family(seen)

deer_hide: #Hide & { material: "leather", mass: 4kg }
hare_pelt: #Hide & { material: "leather", mass: 300g }

// Butcher a carcass in reach, a hand free: half an hour, with the hands;
// the meat into a pack the butcher carries if it fits, else the free hand.
butcher: #Operation & {
    effect:   "butcher"
    duration: 30min
    stow:     true
    uses:     ["hands"]
    roles: {
        actor: #Agent & { freeHands: >=1 }
        item:  #Carcass
    }
} @family(operations)
