// Terrain: what each tile at each level is, and the maps the lab's worlds are
// drawn from (TERRAIN.md).
//
// Cut points:
// - full, reduced, abstract, frozen: alike; terrain changes only as it is
//            built on or knocked through.
// - air:     rooms, and so regions of air, are found from it (air/air.tri).
// - hunting: a hunter crouched hides only off exposed ground
//            (hunting/): at the market on the green, crouched still, it is
//            seen.
// - code:    src/core_terrain.odin; a map's levels are files in maps/,
//            brought in by @embed (a path from this directory). A
//            generated map's ground is Orogen's (orogen/, OROGEN.md): this
//            file says how large the map is, what shapes its ground and
//            which terrain kind each ground class is; the arithmetic from a
//            seed and a tile to an elevation and a ground class is code.
//            A step up or down between levels, a cliff, and who is beside
//            whom across a level are read from the kinds' `solid` and
//            `floored` by code (terrain_step, terrain_beside).

package terrain

// Terrain (TERRAIN.md): what each tile at each level is. A wall fills its
// tile; a cell is a kind's index, not an entity, until something tells it
// apart.
//
// A kind is `solid` when nothing walks into it, `opaque` when sight stops at
// it, `floored` when there is something to stand on (without, the level
// below shows, and things fall), and `divides` where a room ends without
// a wall (a doorway: it belongs to neither room it joins, and links them).
// A doorway's `draught` is the air it passes with no door shut in it, mmol
// a second each way. Its `look` is its appearance key for Tessera. `madeOf`
// is its material (`material` is a body's). Ground that is `exposed` (in
// the open: grass, a path, tilled ground) is nowhere to hide: one hiding
// on it is seen as anyone is; anywhere else (among the trees, indoors),
// only from beside it.
#Terrain: #Looks & {
    solid:   *false | true
    opaque:  *false | true
    floored: *true | false
    divides: *false | true
    exposed: *false | true
    draught: *0 | int & >=0 & <=1000000
    madeOf:  #Material
}

// A world with no map is open floor.
open_floor:  #Terrain & { madeOf: "stone", look: "floor.stone" } @family(terrain)
plank_floor: #Terrain & { madeOf: "wood", look: "floor.plank" } @family(terrain)
stone_wall:  #Terrain & { solid: true, opaque: true, madeOf: "stone", look: "wall.stone" } @family(terrain)
// where a door stands, or would: floor, the door an entity on it
doorway:     #Terrain & { divides: true, draught: 200, madeOf: "stone", look: "doorway" } @family(terrain)
// nothing to stand on: the level below shows through
open_air:    #Terrain & { floored: false, madeOf: "stone", look: "air" } @family(terrain)
// out of doors (VILLAGE.md): grass; ground tilled for a crop; the floor of
// the woods, among the trees; a path worn bare
grass:       #Terrain & { exposed: true, madeOf: "earth", look: "ground.grass" } @family(terrain)
tilled_soil: #Terrain & { exposed: true, madeOf: "earth", look: "ground.tilled" } @family(terrain)
woodland:    #Terrain & { madeOf: "earth", look: "ground.woodland" } @family(terrain)
dirt_path:   #Terrain & { exposed: true, madeOf: "earth", look: "ground.path" } @family(terrain)
// generated country (OROGEN.md): sand at the water's edge, and bare stone
// high up and at a cliff, to stand on; the earth and the rock beneath the
// ground, which fill their cells; the sea, which nothing walks into
sand:        #Terrain & { exposed: true, madeOf: "earth", look: "ground.sand" } @family(terrain)
bare_stone:  #Terrain & { exposed: true, madeOf: "stone", look: "ground.stone" } @family(terrain)
soil:        #Terrain & { solid: true, opaque: true, madeOf: "earth", look: "mass.earth" } @family(terrain)
bedrock:     #Terrain & { solid: true, opaque: true, madeOf: "stone", look: "mass.rock" } @family(terrain)
sea:         #Terrain & { solid: true, madeOf: "water", look: "water" } @family(terrain)

// A map: its levels drawn in characters, a level to a file brought in by
// @embed; its legend, a terrain kind for each character; and the kind of
// the cells a drawing leaves out (past a short row's end, a level not
// drawn). The world is as wide as the longest row, or `width` if more; as
// long as the most rows, or `height`; and as deep as the highest level.
//
// A map of either sort, drawn or generated (below), has a legend, each key
// of it naming a terrain kind, and a width and height in tiles.
#Key:      { terrain: text }
#AnyMap:   { legend: _, width: int & >=0, height: int & >=0 }
#MapKey:   #Key & { glyph: text }
#MapLevel: { z: int & >=0 & <=63, rows: text }
#Map:      #AnyMap & { legend: [...#MapKey], levels: [...#MapLevel], fill: text, width: *0 | int & >=0 & <=4096,
                       height: *0 | int & >=0 & <=4096 }

// A shed of stone with a plank floor, a doorway in its east wall, and a
// path of open ground beyond; past the drawing's short rows, open ground too.
shed_map: #Map & {
    legend: [{ glyph: "#", terrain: "stone_wall" },
             { glyph: ".", terrain: "plank_floor" },
             { glyph: "+", terrain: "doorway" },
             { glyph: ",", terrain: "open_floor" }]
    levels: [{ z: 0, rows: _ @embed(file="maps/shed.0.map", type=text) }]
    fill:   "open_floor"
}

// The rooms of the air scenarios (DOMAIN_SIMULATION.md Scenario 1, air/air.tri):
// a room and a back room, 4 by 5, side by side, their doorways onto a
// corridor below, walled at its ends; the rest of a 32 by 32 world, open
// ground outdoors.
rooms_map: #Map & {
    legend: [{ glyph: "#", terrain: "stone_wall" },
             { glyph: ".", terrain: "plank_floor" },
             { glyph: "+", terrain: "doorway" },
             { glyph: ",", terrain: "open_floor" }]
    levels: [{ z: 0, rows: _ @embed(file="maps/rooms.0.map", type=text) }]
    fill:   "open_floor"
    width:  32
    height: 32
}

// A yard of open ground 96 by 64, drawn as one tile and filled: for what
// must work past 32 by 32 (TERRAIN.md), walls built on it as it goes.
yard_map: #Map & {
    legend: [{ glyph: ",", terrain: "open_floor" }]
    levels: [{ z: 0, rows: _ @embed(file="maps/yard.0.map", type=text) }]
    fill:   "open_floor"
    width:  96
    height: 64
}

// A plain of open ground 1024 by 1024, drawn as one tile and filled: for
// measuring a crowd spread wide (lab bench crowd).
plain_map: #Map & {
    legend: [{ glyph: ",", terrain: "open_floor" }]
    levels: [{ z: 0, rows: _ @embed(file="maps/plain.0.map", type=text) }]
    fill:   "open_floor"
    width:  1024
    height: 1024
}

// A ridge, drawn a level to a file (OROGEN.md decision 6, relief in
// levels), 11 by 5 and the same in every row. From the west: flat ground,
// a ridge two levels high with a step to each level, flat ground again, a
// cliff of two levels with a plateau on it, and the cliff down again.
ridge_map: #Map & {
    legend: [{ glyph: ",", terrain: "grass" },
             { glyph: "%", terrain: "soil" },
             { glyph: "_", terrain: "open_air" }]
    levels: [{ z: 0, rows: _ @embed(file="maps/ridge.0.map", type=text) },
             { z: 1, rows: _ @embed(file="maps/ridge.1.map", type=text) },
             { z: 2, rows: _ @embed(file="maps/ridge.2.map", type=text) },
             { z: 3, rows: "_" }]
    fill:   "open_air"
}

// A generated map (OROGEN.md): no drawing, but what Orogen makes from a
// seed. Its `width` and `height` are in tiles, and it is `tall` so many
// levels; with `wraps`, its ground runs unbroken from its east edge to its
// west. Its `seed` is the world seed unless it gives one. Its ground stands
// from `lowest` to `highest`, under water below `sea`, and bare stone from
// `bare` up; its largest rises are `span` tiles across (a power of two),
// with `octaves` sizes of rise summed, each half the last across and
// `roughness` (of 256) of its height; `soil` levels of earth lie over the
// rock. Its legend says the terrain kind of each ground class.
#GroundKey: #Key & { class: text }
#Generated: #AnyMap & {
    generator: "relief"
    legend:    [...#GroundKey]
    width:     int & >=1 & <=1073741824
    height:    int & >=1 & <=1073741824
    tall:      *32 | int & >=2 & <=256
    wraps:     *false | true
    seed:      *0 | int & >=0
    lowest:    *2 | int & >=0 & <=255
    sea:       *8 | int & >=0 & <=255
    highest:   *26 | int & >=0 & <=255
    bare:      *21 | int & >=0 & <=255
    span:      *32 | int & >=2 & <=65536
    octaves:   *4 | int & >=1 & <=16
    roughness: *128 | int & >=0 & <=256
    soil:      *3 | int & >=0 & <=255
}

// Rolling country with a little sea, 256 by 256: grass, sand at the shore,
// bare stone on the heights and the cliffs.
hills_map: #Generated & {
    width:  256
    height: 256
    legend: [{ class: "air", terrain: "open_air" },
             { class: "earth", terrain: "soil" },
             { class: "rock", terrain: "bedrock" },
             { class: "water", terrain: "sea" },
             { class: "grass", terrain: "grass" },
             { class: "sand", terrain: "sand" },
             { class: "stone", terrain: "bare_stone" }]
}
