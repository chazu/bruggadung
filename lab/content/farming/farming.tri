// Farming: plots, their crops, seed, sowing, ripening and harvesting
// (VILLAGE.md decision 5, slice 6).
//
// Cut points:
// - full:     a farmer tends a plot of its household's through its
//             working hours (a kept goal, agency.tri), the plot as a
//             whole: one referent, an area (things.tri's #Area). It
//             harvests a row of a ripe plot, a hand free, room in its arms
//             first (no armful of a harvest's worth: one is taken to the
//             larder, or, holding more than a sack of seed's worth and none
//             kept back yet, a sack of it kept back as seed, marking the
//             plot kept till it is sown again); else takes in what it
//             harvested; else sows a row of a bare plot, its seed in hand
//             (fetched from where it is kept first); else puts the seed
//             back. A plot is tended while it stands sown, its farmer's
//             hands empty.
// - reduced:  the same, decided on the cadence's beat; each row's activity
//             runs its time.
// - abstract: as reduced. A household's plots as a yield at a place,
//             below reduced, are open (VILLAGE.md decision 3).
// - frozen:   it doesn't decide; what is under way waits. A plot ripens
//             frozen or not: its growth is a function of time.
// - growth:   a plot's crop grows from when its last row was sown
//             (`sownAt`, `ripensIn`), never stepped; it stands ripe once
//             grown, set then: the plot's one wake (`ripening`, a turn:
//             reality.tri). How far it has grown isn't seen; how it
//             stands is.
// - cooking:  what a harvest yields is food (cooking/cooking.tri's raw
//             grain, and turnips), raw, cooked as any is; in a larder it
//             merges with a sack of its kind. One taken from it is the
//             instance its unit names (`grain`, `turnip`): the committer's
//             split, src/commit_committer.odin.
// - home:     a farmer's worksite is a scarecrow (home/home.tri) in one of
//             its plots.
// - village:  the plots, the seed in each larder, and who farms which are
//             the scenario's (village/village.tri, src/scenario_village.odin).
// - code:     how a plot stands when its last row is reaped (bare) or sown
//             (sown, growing from then, the seed kept for it used): the
//             plot's own, a reaction to its rows' count
//             (src/kinds_plot_kind.odin). Ripening is applied as any
//             progression is (src/domains_progressions.odin).
//             Sowing, harvesting and keeping seed back are declared, a row
//             a time, each counting on the plot's rows as it read them.
//             Where a plot is seen and reached from is an area's
//             (things.tri).

package farming

// A plot: tilled ground a household farms, an area of it, and its crop:
// what it grows, how it stands (bare, sown, ripe), how many of its tiles
// are sown so far (bare) or reaped (ripe), and when its last row was sown;
// it ripens `ripensIn` after. A tile reaped yields a stack (`yields`, a
// blueprint). Seed kept back from its harvest, it is `kept` (a sheaf set
// aside, there to be seen) till it is sown again.
#Plot: #Area & {
    @component(Plot)
    grows:    text                           @field(content, saved, inspect, perceive(sight))
    stands:   *"bare" | "sown" | "ripe"      @field(content, saved, proposable, inspect, perceive(sight))
    sown:     *0 | int & >=0 & <=65536       @field(content, saved, proposable, inspect)
    reaped:   *0 | int & >=0 & <=65536       @field(content, saved, proposable, inspect)
    sownAt:   *0ms | time & >=0ms & <=10000d @field(content, saved, proposable, inspect)
    ripensIn: *14d | time & >=1s & <=1000d   @field(content, saved, inspect)
    yields:   text                           @field(content, saved, inspect)
    kept:     *false | true                  @field(content, saved, proposable, inspect, perceive(sight))
}

// A plot standing sown stands ripe `ripensIn` after its last row was sown.
ripening: #Turn & { progresses: "Plot", turned: "stands", turnedFrom: "sown", turnedTo: "ripe", asOf: "sownAt", period: "ripensIn" }
@family(progressions)

plot_seen: #Seen & { kindOf: "#Plot" } @family(seen)

plot_look: #Look & { kindOf: "#Plot", look: "plot" } @family(looks)

// Seed: the crop it sows (a plot's `grows`), a unit to a tile.
#Seed: {
    @component(Seed)
    sows: text @field(content, saved, inspect, perceive(sight))
}

seed_seen: #Seen & { kindOf: "#Seed" } @family(seen)

// The plots: grain, ripe in a fortnight, and turnips, in twelve days, each
// tile yielding two portions (cooking/cooking.tri's grain) or two turnips.
// How big each is, the scenario says.
grain_plot:  #Plot & { material: "earth", mass: 1kg, grows: "grain", ripensIn: 14d, yields: "grain_harvest" }
turnip_plot: #Plot & { material: "earth", mass: 1kg, grows: "turnip", ripensIn: 12d, yields: "turnip_harvest" }

// What a tile's harvest is: raw food, a stack, as grain is kept.
let raw_grain  = { material: "food", raw: true, nourishment: 15, cooking: 35 }
let raw_turnip = { material: "food", raw: true, nourishment: 10, cooking: 30 }
// It can be kept back as seed (`keptAs`, a #Seed's blueprint), a sack at
// a time.
grain_harvest:  #Stack & #Food & raw_grain & { unit: "grain", unitMass: 250g, count: 2, keptAs: "seed_grain", keptOf: 50 }
turnip_harvest: #Stack & #Food & raw_turnip & { unit: "turnip", unitMass: 250g, count: 2, keptAs: "turnip_seed", keptOf: 7 }
// One turnip, taken from a harvest (a unit of a stack is the instance its
// unit names, as cooking/'s grain is).
turnip:         #Body & #Food & raw_turnip & { mass: 250g }

// What food is kept back as, for seed: a #Seed's blueprint ("" for none),
// and how many units of the food make one of it (`keptOf`): as heavy, or
// keeping it back fails.
hunger.#Food: {
    keptAs: *"" | text                   @field(content, saved, inspect)
    keptOf: *0 | int & >=0 & <=100000    @field(content, saved, inspect)
}

// Seed, kept back from the last harvest: a sack, by the tile's worth. A
// sack is twelve and a half kilograms of grain (fifty portions), or seven
// turnips' worth of turnip seed.
seed_grain:  #Stack & #Seed & { material: "food", unit: "seed grain", unitMass: 25g, count: 500, sows: "grain" }
turnip_seed: #Stack & #Seed & { material: "food", unit: "turnip seed", unitMass: 5g, count: 350, sows: "turnip" }

// Farming: the plot, the seed sown on it, what was harvested, and the
// larder it goes to (the household's, where cooking/ keeps its food too:
// each frame its own `larder`).
#Farming: #Frame & { plot: #Plot, seed: #Body, harvest: #Body, larder: #Body }

// The day's work, for a farmer: a plot of its household's tended, kept
// through its working hours (bound when undertaken: the plot, and the
// larder its seed is kept in and its harvest goes to). Tended, it stands
// sown, and nothing of it is left in the farmer's hands.
plot_tended: #Goal & {
    title: "tend the plot"
    done:  { find: ["plot"], match: #Farming & { me: #Agent & { freeHands: 2 }, plot: #Plot & { stands: "sown" } } }
    kept:  true
} @family(goals)

// The ways (METHODS.md: whole ways, what each needs a subgoal): a ripe
// plot harvested a row at a time, room in its arms first; what is left of
// the harvest in hand brought in; a bare plot sown, seed in hand first;
// the seed left put back.
harvest_it: #Method & {
    title: "harvest it"
    goal:  "plot_tended"
    rank:  1
    pre: {
        find:  ["plot"]
        match: #Farming & { me: #Agent & { freeHands: >=1 }, plot: #Plot & { stands: "ripe" } }
    }
    steps: [#Achieve & { subgoal: "room_to_harvest" }, #Do & { op: "harvest", object: "plot" }]
} @family(methods)

// Room to harvest: no armful of the harvest of ten kilograms or more in
// hand (forty portions: what is held is weighed by its mass, its count
// unseen). Made by keeping a sack of it back as seed, if it holds a sack's
// worth (twelve and a half kilograms) and none is kept back yet from the
// plot, to sow it again; else by taking it to the larder.
room_to_harvest: #Goal & {
    title: "make room to harvest"
    done:  #None & {
        find:  ["harvest"]
        match: #Farming & { me: #Agent & { id: $me }, harvest: #Food & #Stack & { raw: true, mass: >=10kg, place: #Held & { by: $me } } }
    }
} @family(goals)

keep_back_seed: #Method & {
    title: "keep back seed"
    goal:  "room_to_harvest"
    rank:  1
    pre: {
        find:  ["harvest", "plot"]
        match: #Farming & { me: #Agent & { id: $me, freeHands: >=1 },
                            harvest: #Food & #Stack & { raw: true, unit: $c, mass: >=12500g, place: #Held & { by: $me } },
                            plot: #Plot & { grows: $c, kept: false } }
    }
    steps: [#Do & { op: "keep_seed", object: "harvest", target: "plot" }]
} @family(methods)

bring_it_in: #Method & {
    title: "bring it in"
    goal:  "room_to_harvest"
    rank:  2
    pre: {
        find:  ["harvest", "larder"]
        match: #Farming & { me: #Agent & { id: $me },
                            harvest: #Food & #Stack & { raw: true, mass: >=10kg, place: #Held & { by: $me } },
                            larder: #Container }
    }
    order: ["own", "habit", "near"]
    steps: [#Do & { op: "put_in", object: "harvest", target: "larder" }]
} @family(methods)

// The plot reaped, or no hand free to reap it: what was harvested, taken
// in. (A portion alone in hand, 250 grams, is the meal taken to work,
// cooking/'s.)
bring_in_the_rest: #Method & {
    title: "bring in the rest"
    goal:  "plot_tended"
    rank:  2
    pre: {
        find:  ["harvest", "larder"]
        match: #Farming & { me: #Agent & { id: $me },
                            harvest: #Food & #Stack & { raw: true, mass: >=500g, place: #Held & { by: $me } },
                            larder: #Container }
    }
    order: ["own", "habit", "near"]
    steps: [#Do & { op: "put_in", object: "harvest", target: "larder" }]
} @family(methods)

sow_it: #Method & {
    title: "sow it"
    goal:  "plot_tended"
    rank:  3
    pre:   { find: ["plot"], match: #Farming & { plot: #Plot & { stands: "bare" } } }
    steps: [#Achieve & { subgoal: "seed_in_hand" }, #Do & { op: "sow", object: "seed", target: "plot" }]
} @family(methods)

// Nothing to sow: the seed put back where it is kept.
put_back_the_seed: #Method & {
    title: "put back the seed"
    goal:  "plot_tended"
    rank:  4
    pre: {
        find:  ["seed", "larder"]
        match: #Farming & { me: #Agent & { id: $me },
                            seed: #Seed & #Stack & { place: #Held & { by: $me } },
                            larder: #Container }
    }
    order: ["own", "habit", "near"]
    steps: [#Do & { op: "put_in", object: "seed", target: "larder" }]
} @family(methods)

// Seed in hand for the plot's crop, to sow with (the plot is bound: a
// condition describes only the slots it finds): a plot's worth fetched at a
// time.
seed_in_hand: #Goal & {
    title: "take seed"
    done: {
        find:  ["plot", "seed"]
        match: #Farming & { me: #Agent & { id: $me },
                            seed: #Seed & #Stack & { sows: $c, place: #Held & { by: $me } },
                            plot: #Plot & { grows: $c } }
    }
} @family(goals)

fetch_seed: #Method & {
    title: "fetch seed"
    goal:  "seed_in_hand"
    rank:  1
    pre: {
        find:  ["plot", "seed"]
        match: #Farming & { me: #Agent & { freeHands: >=1 },
                            seed: #Seed & #Stack & { sows: $c, place: #Inside },
                            plot: #Plot & { grows: $c } }
    }
    order: ["own", "habit", "near"]
    steps: [#Do & { op: "take_some", object: "seed", units: 300 }]
} @family(methods)

look_for_seed: #Method & {
    title:  "look for seed"
    goal:   "seed_in_hand"
    rank:   2
    pre:    { find: ["larder"], match: #Farming & { larder: #Larder } }
    order:  ["own", "habit", "likely", "near"]
    seeks:  #Seed & #Stack
    search: "larder"
    places: 2
    steps:  [#Do & { op: "look_in", object: "larder" }]
} @family(methods)

// Sow a row of a bare plot in reach, seed for its crop in hand: a quarter
// of an hour, with the hands. As many tiles as a row has, or as the seed
// or the plot have left, are sown, a unit of the seed to each; the last
// row sown, the plot stands sown, growing from then (the plot's own).
sow: #Operation & {
    duration: 900s
    uses:     ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Seed & #Stack & { id: $i, sows: $c, count: $q, place: #Held & { by: $a } }
        destination: #Plot & { grows: $c, stands: "bare", east: $e, south: $s, sown: $w }
    }
    consumes: [{ consumed: $i, portion: math.Min(math.Min($e, $q), $e * $s - $w), because: "sown" }]
    after:    { destination: #Plot & { sown: $w + math.Min(math.Min($e, $q), $e * $s - $w) } }
} @family(operations)

// Keep back seed: of a harvest in hand, a sack of seed's worth (`keptOf`
// units of it) carved off as the seed it is kept as, as heavy, into a pack
// or a free hand; the plot in reach it is kept for marked kept. A quarter
// of an hour, with the hands.
keep_seed: #Operation & {
    duration: 900s
    uses:     ["hands"]
    stow:     true
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Food & #Stack & { id: $i, keptAs: $k, keptOf: $n & >=1, place: #Held & { by: $a } }
        destination: #Plot & { kept: false }
    }
    makes:    [{ blueprint: $k, at: #Held & { by: $a }, called: "seed kept back", splitFrom: $i }]
    consumes: [{ consumed: $i, portion: $n, exact: true, because: "kept back as seed" }]
    after:    { destination: #Plot & { kept: true } }
} @family(operations)

// Harvest a row of a ripe plot in reach: half an hour, with the hands, and
// work. What the row's tiles yield is in the harvester's hand, with what
// it holds of the kind already (not cooked), else in a free one; the last
// row reaped, the plot is bare (the plot's own).
harvest: #Operation & {
    duration: 1800s
    uses:     ["hands"]
    exertion: 1
    roles: {
        actor: #Agent & { id: $a }
        item:  #Plot & { stands: "ripe", yields: $y, east: $e, reaped: $r }
    }
    makes: [{ blueprint: $y, many: $e, at: #Held & { by: $a }, called: "a harvest", gathered: true }]
    after: { item: #Plot & { reaped: $r + $e } }
} @family(operations)

// The three weeks' test (src/test_farming.odin): a plot of 8 by 4 in a
// meadow of 20 by 10, and a farmhand who tends it, who needn't eat.
farm_map: #Map & {
    legend: [{ glyph: ",", terrain: "grass" },
             { glyph: "%", terrain: "tilled_soil" }]
    levels: [{ z: 0, rows: _ @embed(file="maps/farm.0.map", type=text) }]
    fill:   "grass"
}

farmhand: #Agent & { material: "flesh", mass: 75kg, hands: 2, coat: "green", trade: "farmer" }
