// Water, for DOMAIN_SIMULATION.md's third scenario, "Two draws on a
// dwindling stock". Water is a stock: whole millilitres, held by entities
// (WaterStore) and by tiles, and moved by the fluid domain while it flows.

// Something that holds water. While the fluid domain has it checked out, the
// domain's value is authoritative and commitment refuses to change this one.
#WaterStore: {
    @component(WaterStore)
    water:    volume                    @field(content, saved, proposable, inspect, perceive(sight))
    waterCapacity: volume & >=0mL & <=10m3 @field(content, saved, inspect, perceive(sight))
}

// An outlet on a water store: open, it delivers up to `rate` millilitres a
// minute into what sits in it (a bucket), or onto its tile if nothing does.
// It is installed in the store it draws from.
#Tap: #Container & {
    @component(Tap)
    open: *false | true         @field(content, saved, proposable, inspect, perceive(sight))
    rate: int & >=0 & <=100000  @field(content, saved, proposable, inspect)
}

cistern: #Assembly & #WaterStore & { material: "oak", mass: 40kg, slots: 4, water: 15L, waterCapacity: 200L }
tap:     #Tap & { material: "brass", mass: 300g, capacity: 1, rate: 5000 }
crack:   #Tap & { material: "oak", mass: 0g, capacity: 1, rate: 500, open: true }
bucket:  #WaterStore & #Body & { material: "oak", mass: 1500g, water: 0mL, waterCapacity: 10L }
