// The component kinds of the laboratory. Each @component type is one
// component kind; the features it introduces are its fields, with their
// field registry flags. The structs and the registry the lab uses are
// generated from this file (make gen).

// What things are made of, and the colours they come in: hierarchies, so a
// memory loses detail along them (KNOWLEDGE.md §12): an oak chest is
// remembered as wooden, then as made of something.
#Material: "metal" | "wood" | "flesh" | "paper" | "food" | "cloth" | "rubber"
"metal":   "iron" | "brass" | "steel"
"wood":    "oak"

#Colour:  "dark" | "light" | "bright"
"dark":   "black" | "grey" | "brown" | "navy"
"light":  "white" | "beige"
"bright": "red" | "yellow" | "blue" | "green"

// --- what descriptions say besides component fields ----------------------
//
// An agent's view of an entity (for now, the truth projection) is a
// description: the entity's type, its id, its place, and the component
// fields it can perceive. Places and ids are relations and handles, not
// component fields, so they are introduced here, by types that are not
// components: the generated structs don't carry them.

// Anything with identity. In the truth projection, id is the entity's handle.
#Thing: { id: ref }

// Where a physical thing is: the location relation, as a description.
#Place: {}
#OnTile:    #Place & { x: int, y: int, level: int }
#Inside:    #Place & { container: ref }
#Held:      #Place & { by: ref, hand: int }
#Installed: #Place & { assembly: ref, role: text, index: int }

#Placed: #Thing & { place: #Place }

// What an agent's hands are doing: a derived value, not a stored field.
#Handed: { freeHands: int & >=0 & <=4 }

// A physical thing: what it weighs, what it is made of, and the traces it
// carries. Units of a stack share one Body, so marks on one unit split it off.
#Body: #Placed & {
    @component(Body)
    mass:      mass                    @field(content, saved, proposable, inspect, perceive(touch))
    material:  #Material               @field(content, saved, inspect, perceive(sight))
    // what its material looks like, if not itself (KNOWLEDGE.md §4): the
    // senses report it instead; an analysis reaches beneath it
    surface:   *"natural" | "metal" | "wood" | "flesh" | "paper" @field(content, saved, inspect, appears(material))
    bent:      *false | true           @field(saved, proposable, inspect, perceive(sight))
    toolMarks: *0 | int & >=0 & <=100  @field(saved, proposable, inspect, perceive(sight))
}

// Identical units counted as one entity. The stack's mass is its units'.
#Stack: #Body & {
    @component(Stack)
    count:    $n & int & >=1 & <=100000 @field(content, saved, proposable, inspect)
    unitMass: $u & mass                 @field(content, saved, inspect)
    unit:     text                      @field(content, saved, inspect, perceive(sight))
    mass:     $u * $n
}

// Something that acts, with hands to hold things in, a coat to know it by
// at a glance, and room in its memory for so many observations
// (KNOWLEDGE.md §12): past that, the least salient go first.
#Agent: #Body & #Handed & {
    @component(Agent)
    hands:  int & >=0 & <=4                  @field(content, saved, inspect, perceive(sight))
    coat:   #Colour                          @field(content, saved, inspect, perceive(sight))
    memory: *64 | int & >=1 & <=100000       @field(content, saved, inspect)
    // a disposition (AGENCY.md §9), in dB: how much it likes to help whoever
    // asks; others can't see it, only how it behaves
    helpful: *0 | int & >=-30 & <=30         @field(content, saved, proposable, inspect)
    // expertise (KNOWLEDGE.md §9): what interpretation rules it can draw
    painting: *0 | int & >=0 & <=100         @field(content, saved, inspect)
    // dispositions and an internal norm (AGENCY.md §9), 0 to 100: how honest
    // it is, how curious (it notices more), and how much it minds stealing
    honesty:  *50 | int & >=0 & <=100        @field(content, saved, proposable, inspect)
    curious:  *0 | int & >=0 & <=100         @field(content, saved, proposable, inspect)
    scruples: *20 | int & >=0 & <=100        @field(content, saved, proposable, inspect)
    // respect for reservations (AGENCY.md §9, ACTIONS.md §7), 0 to 100
    respectful: *50 | int & >=0 & <=100      @field(content, saved, proposable, inspect)
    // reaction speed (ACTIONS.md §8): it weights the order of the agent's
    // actions among others' at the same boundary
    quickness:  *10 | int & >=1 & <=100      @field(content, saved, proposable, inspect)
    // half hidden: seen only from close by, though it sees as well as anyone
    hiding:   *false | true                  @field(content, saved, proposable, inspect)
    // a body stock (AGENCY.md §6): how fed it is, 0 to 100, as of `fedAt`;
    // it falls a point every three minutes, computed when read
    fed:      *80 | int & >=0 & <=100        @field(content, saved, proposable, inspect)
    fedAt:    *0ms | time & >=0ms & <=10000d @field(content, saved, proposable, inspect)
}

// Something entities can be put in.
#Container: #Body & {
    @component(Container)
    capacity: int & >=1 & <=1000 @field(content, saved, inspect, perceive(sight))
}

// Something with parts installed in it.
#Assembly: #Body & {
    @component(Assembly)
    slots: int & >=1 & <=64 @field(content, saved, inspect, perceive(sight))
}

#ClaimKind: "ownership" | "custody" | "reservation"

// A reified claim: an informational entity, with no body and no location.
// Its claimant and subjects are edges.
#Claim: #Thing & {
    @component(Claim)
    kind:     #ClaimKind       @field(content, saved, inspect)
    quantity: int & >=0 & <=100000 @field(content, saved, proposable, inspect)
}
