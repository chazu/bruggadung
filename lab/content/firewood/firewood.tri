// Firewood: trees, felling, cutting a trunk into logs, splitting a log into
// firewood, the woodpile, and stoking a stove (VILLAGE.md decision 6, slice
// 5).
//
// Cut points:
// - full:     a woodcutter keeps its household's woodpile stocked through
//             its working hours (a kept goal, agency.tri): firewood in hand
//             it stacks on the woodpile; else it gets some into hand (out
//             of its pack by the woodpile; gathered where it lies; split
//             from a log, cut off a trunk, felled, or a tree looked for in
//             the woods), and stacks it: whole ways, what each needs a
//             subgoal (METHODS.md), all with the axe (taken up first, passed
//             over while one is held), so a hand is free for the firewood. Every household stokes its stove for the night, and
//             before lighting it to cook if it has nothing in it to burn.
// - reduced:  the same, decided on the cadence's beat; each activity runs
//             its time.
// - abstract: as reduced. A woodpile's level at a place, below reduced, is
//             open (VILLAGE.md decision 3).
// - frozen:   it doesn't decide; what is under way waits.
// - heat:     a stove's fuel is heat/heat.tri's #FuelContainer, burned by
//             the atmosphere domain while the stove is lit. Stoking adds the
//             firewood's mass to it. Cold isn't felt in the village: its
//             people aren't thermal bodies yet, so stoking for the night is
//             a commitment, not a want.
// - sawing:   a trunk is a #Log (sawing/sawing.tri) of several lengths,
//             cut a length at a time (`buck`), its last length cut
//             through (`cut_through`); a log split into firewood is one
//             cut through.
// - cooking:  a stove lit to cook is stoked first if empty
//             (cooking/cooking.tri's `stove_lit`).
// - carrying: a woodcutter with the household's backpack gathers into it
//             (carrying/'s `gather`) and the next lot into its hand, stacks
//             what it holds, and by the woodpile takes the rest out of the
//             pack to stack.
// - money:    a woodpile is stocked at three tonnes while the household's
//             coffer holds two hundred coins, as far as the woodcutter
//             knows; short of them, at four and a half, to sell more
//             (money/coins.tri: more firewood asks less).
// - village:  the trees, the tools at the chopping block, the woodpiles
//             and who stocks which, with its coffer, are the scenario's
//             (src/scenario_village.odin).
// - code:     none of its own: felling, bucking, cutting through,
//             splitting and stoking are declared, and putting down
//             (actions.tri).

package firewood

// A woodpile: where a household's firewood is stacked, told from its other
// containers at a glance.
#Woodpile: #Container & {}

woodpile_seen: #Seen & { kindOf: "#Woodpile" } @family(seen)

// A standing tree, and what it is felled into: a trunk's blueprint.
#Tree: #Body & {
    @component(Tree)
    fellsInto: text @field(content, saved, inspect)
}

tree_seen: #Seen & { kindOf: "#Tree" } @family(seen)

tree_look: #Look & { kindOf: "#Tree", look: "tree" } @family(looks)

// A felled tree: a log of so many lengths (sawing/'s `lengths`), each cut
// off as a log of its own (a blueprint), the last the trunk itself.
#Trunk: #Log & {
    @component(Trunk)
    cutsInto: text @field(content, saved, inspect)
}

trunk_seen: #Seen & { kindOf: "#Trunk" } @family(seen)

// What a log is split into: a stack's blueprint (oak firewood, unless
// it says otherwise).
sawing.#Log: {
    splitsInto: *"firewood_20" | text @field(content, saved, inspect)
}

log_look:   #Look & { kindOf: "#Log", look: "log" } @family(looks)
trunk_look: #Look & { kindOf: "#Trunk", look: "log.trunk" } @family(looks)

// An axe: for felling, bucking and splitting.
#Axe: #Body & {}

axe_seen: #Seen & { kindOf: "#Axe" } @family(seen)

tool_look: #Look & { kindOf: "#Axe", look: "tool" } @family(looks)

oak:   #Tree & { material: "oak", mass: 600kg, fellsInto: "oak_trunk" }
birch: #Tree & { material: "birch", mass: 300kg, fellsInto: "birch_trunk" }

oak_trunk:   #Trunk & { material: "oak", mass: 120kg, hardness: 70, lengths: 6, cutsInto: "oak_log" }
birch_trunk: #Trunk & { material: "birch", mass: 60kg, hardness: 45, lengths: 3, cutsInto: "birch_log", splitsInto: "birch_firewood_20" }
oak_log:     #Log & { material: "oak", mass: 20kg, hardness: 70, sawn: 100 }
birch_log:   #Log & { material: "birch", mass: 20kg, hardness: 45, sawn: 100, splitsInto: "birch_firewood_20" }

// Firewood, by the piece: a kilogram of split wood, of the tree it came
// from (oak and birch pieces don't make one stack).
firewood:          #Body & { material: "oak", mass: 1kg }
firewood_20:       #Stack & { material: "oak", unit: "firewood", unitMass: 1kg, count: 20 }
birch_firewood_20: #Stack & { material: "birch", unit: "firewood", unitMass: 1kg, count: 20 }

axe: #Axe & { material: "iron", mass: 2kg }

// Felling: a tree, the woodpile it goes to, the axe.
#Felling: #Frame & { tree: #Body, trunk: #Body, log: #Body, wood: #Body, woodpile: #Body, axe: #Body, pack: #Body,
                     coffer: #Body, coins: #Body }

// The day's work, for a woodcutter: its household's woodpile stocked, kept
// through its working hours (bound when undertaken: the household's
// woodpile and its coffer). Done past three thousand pieces (three tonnes:
// a stack is seen by its mass, its count unseen), more than a day's work,
// the surplus a woodcutter's to sell (the market, VILLAGE.md slice 9), so
// long as the coffer holds two hundred coins (two kilograms) as far as it
// knows; short of them, past four and a half thousand, to sell more:
// firewood keeps, and the more there is the less it asks (money/'s
// #Pricing).
woodpile_stocked: #Goal & {
    title: "stock the woodpile"
    done: {
        find:  ["woodpile", "wood", "coffer", "coins"]
        match: #Felling & { woodpile: #Container & { id: $w },
                            wood: #Stack & { unit: "firewood", mass: >=4500kg, place: #Inside & { container: $w } } } |
            #Felling & { woodpile: #Container & { id: $w },
                         wood:   #Stack & { unit: "firewood", mass: >=3000kg, place: #Inside & { container: $w } },
                         coffer: #Container & { id: $c },
                         coins: #Stack & { unit: "coin", mass: >=2kg, place: #Inside & { container: $c } } }
    }
    kept: true
} @family(goals)

// The ways (METHODS.md: whole ways, what each needs a subgoal): firewood in
// hand is stacked on the woodpile; else stocking it is one way, firewood
// got into hand, then stacked. Firewood is got into hand: out of its pack,
// by the woodpile; gathered where it lies; split from a log, then
// gathered; else, nothing left to make it of, the pack carried home and
// unpacked. A log to split is one lying about, or one cut off a trunk, or
// a trunk's last length cut through; a trunk, one lying about, or a tree
// felled; a tree, one known, or the
// woods looked into for one. Each "one about" is a goal, passed over while
// one is: the nearest, bound for the step that needs it.
stack_it: #Method & {
    title: "stack it"
    goal:  "woodpile_stocked"
    rank:  1
    pre: {
        find:  ["wood"]
        match: #Felling & { me: #Agent & { id: $me }, wood: #Stack & { unit: "firewood", place: #Held & { by: $me } } }
    }
    steps: [#Do & { op: "put_in", object: "wood", target: "woodpile" }]
} @family(methods)

cut_and_stack: #Method & {
    title: "cut wood and stack it"
    goal:  "woodpile_stocked"
    rank:  2
    pre:   { find: [], match: #Felling }
    steps: [#Achieve & { subgoal: "wood_in_hand" }, #Do & { op: "put_in", object: "wood", target: "woodpile" }]
} @family(methods)

wood_in_hand: #Goal & {
    title: "firewood in hand"
    done: {
        find:  ["wood"]
        match: #Felling & { me: #Agent & { id: $me }, wood: #Stack & { unit: "firewood", place: #Held & { by: $me } } }
    }
} @family(goals)

// Firewood in its pack: taken in hand by the woodpile (carrying/'s ways,
// the wood as the thing, the woodpile where it goes); first, home already.
let out_of_the_pack = {
    goal:  "wood_in_hand"
    steps: [#Achieve & { subgoal: "thing_in_hand", with: [{ binds: "thing", to: "wood" }, { binds: "into", to: "woodpile" }] }]
}
let wood_packed = #Felling & { me: #Agent & { id: $me }, pack: #Pack & { id: $p, place: #Held & { by: $me } },
                               wood: #Stack & { unit: "firewood", place: #Inside & { container: $p } } }
unpack_the_wood: #Method & out_of_the_pack & {
    title: "unpack it"
    rank:  1
    pre:   #Reached & { reached: "woodpile", find: ["pack", "wood"], match: wood_packed }
} @family(methods)

gather_it: #Method & {
    title: "gather it"
    goal:  "wood_in_hand"
    rank:  2
    pre: {
        find:  ["wood"]
        match: #Felling & { me: #Agent & { freeHands: >=1 }, wood: #Stack & { unit: "firewood", place: #OnTile } }
    }
    order: ["near"]
    steps: [#Do & { op: "gather", object: "wood", units: 20 }]
} @family(methods)

split_and_gather: #Method & {
    title: "split some and gather it"
    goal:  "wood_in_hand"
    rank:  3
    pre:   { find: [], match: #Felling }
    steps: [#Achieve & { subgoal: "wood_split" }, #Achieve & { subgoal: "hand_for_wood" },
            #Do & { op: "gather", object: "wood", units: 20 }]
} @family(methods)

// A hand free to gather with: the axe put down, by the wood (taken up again
// to split more), not the meal it carries to eat at work.
hand_for_wood: #Goal & {
    title: "a hand free for the wood"
    done:  { find: [], match: #Felling & { me: #Agent & { freeHands: >=1 } } }
} @family(goals)

put_down_the_axe: #Method & {
    title: "put down the axe"
    goal:  "hand_for_wood"
    rank:  1
    pre:   { find: ["axe"], match: #Felling & { me: #Agent & { id: $me }, axe: #Axe & { place: #Held & { by: $me } } } }
    steps: [#Do & { op: "put_down", object: "axe" }]
} @family(methods)

// Nothing left to make it of, the pack not empty: home with it, and out of
// it.
carry_the_wood_home: #Method & out_of_the_pack & {
    title: "carry it home"
    rank:  4
    pre:   { find: ["pack", "wood"], match: wood_packed }
} @family(methods)

// Firewood lying about, split: the nearest.
wood_split: #Goal & {
    title: "split firewood"
    done:  { find: ["wood"], match: #Felling & { wood: #Stack & { unit: "firewood", place: #OnTile } } }
    order: ["near"]
} @family(goals)

split_a_log: #Method & {
    title: "split a log"
    goal:  "wood_split"
    rank:  1
    pre: {
        find:  ["log"]
        match: #Felling & { log: #Log & { sawn: 100, place: #OnTile } }
    }
    order: ["near"]
    steps: [#Achieve & { subgoal: "axe_in_hand" }, #Do & { op: "split", object: "axe", target: "log" }]
} @family(methods)

cut_and_split: #Method & {
    title: "cut a log and split it"
    goal:  "wood_split"
    rank:  2
    pre:   { find: [], match: #Felling }
    steps: [#Achieve & { subgoal: "log_cut" }, #Achieve & { subgoal: "axe_in_hand" },
            #Do & { op: "split", object: "axe", target: "log" }]
} @family(methods)

// A log lying about, sawn through: the nearest.
log_cut: #Goal & {
    title: "cut a log"
    done:  { find: ["log"], match: #Felling & { log: #Log & { sawn: 100, place: #OnTile } } }
    order: ["near"]
} @family(goals)

cut_a_trunk: #Method & {
    title: "cut a length off"
    goal:  "log_cut"
    rank:  1
    pre: {
        find:  ["trunk"]
        match: #Felling & { trunk: #Trunk & { lengths: >=2, place: #OnTile } }
    }
    order: ["near"]
    steps: [#Achieve & { subgoal: "axe_in_hand" }, #Do & { op: "buck", object: "axe", target: "trunk" }]
} @family(methods)

// A trunk down to its last length: that cut through.
cut_the_last: #Method & {
    title: "cut the last length through"
    goal:  "log_cut"
    rank:  2
    pre: {
        find:  ["trunk"]
        match: #Felling & { trunk: #Trunk & { lengths: 1, sawn: <=99, place: #OnTile } }
    }
    order: ["near"]
    steps: [#Achieve & { subgoal: "axe_in_hand" }, #Do & { op: "cut_through", object: "axe", target: "trunk" }]
} @family(methods)

fell_and_cut: #Method & {
    title: "fell a tree and cut it"
    goal:  "log_cut"
    rank:  3
    pre:   { find: [], match: #Felling }
    steps: [#Achieve & { subgoal: "trunk_felled" }, #Achieve & { subgoal: "axe_in_hand" },
            #Do & { op: "buck", object: "axe", target: "trunk" }]
} @family(methods)

// A trunk lying about, of more than a length, to cut: the nearest.
trunk_felled: #Goal & {
    title: "fell a tree"
    done:  { find: ["trunk"], match: #Felling & { trunk: #Trunk & { lengths: >=2, place: #OnTile } } }
    order: ["near"]
} @family(goals)

fell_a_tree: #Method & {
    title: "fell a tree"
    goal:  "trunk_felled"
    rank:  1
    pre: {
        find:  ["tree"]
        match: #Felling & { tree: #Tree }
    }
    order: ["near"]
    steps: [#Achieve & { subgoal: "axe_in_hand" }, #Do & { op: "fell", object: "axe", target: "tree" }]
} @family(methods)

// No tree known: into the woods, axe in hand, to find one.
look_for_trees: #Method & {
    title: "look for trees"
    goal:  "trunk_felled"
    rank:  2
    pre:   { find: [], match: #Felling }
    steps: [#Achieve & { subgoal: "axe_in_hand" }, #Explore & { beside: "woodland" }]
} @family(methods)

// An axe in hand, to fell, cut or split with: a subgoal, so passed over
// while one is held (a way of the woodpile's own, taken whenever nothing
// better would do, had a woodcutter with an axe in hand take up another).
axe_in_hand: #Goal & {
    title: "take up an axe"
    done: {
        find:  ["axe"]
        match: #Felling & { me: #Agent & { id: $me }, axe: #Axe & { place: #Held & { by: $me } } }
    }
} @family(goals)

take_up_the_axe: #Method & {
    title: "take up the axe"
    goal:  "axe_in_hand"
    rank:  1
    pre: {
        find:  ["axe"]
        match: #Felling & { me: #Agent & { freeHands: >=1 }, axe: #Axe & { place: #OnTile } }
    }
    order: ["near"]
    steps: [#Do & { op: "take", object: "axe" }]
} @family(methods)

// The night's: the household's stove stoked, six kilograms in it at the
// least (bound when undertaken: its stove).
stove_stoked: #Goal & {
    title: "stoke the stove"
    done:  { find: ["stove"], match: #Cooking & { stove: #Stove & { fuel: >=6kg } } }
} @family(goals)

stoke_it: #Method & {
    title: "stoke it"
    goal:  "stove_stoked"
    rank:  1
    pre: {
        find:  ["wood", "stove"]
        match: #Felling & #Cooking & { me: #Agent & { id: $me },
                                       wood: #Stack & { unit: "firewood", place: #Held & { by: $me } }, stove: #Stove }
    }
    steps: [#Do & { op: "stoke", object: "wood", target: "stove" }]
} @family(methods)

fetch_firewood: #Method & {
    title: "fetch firewood"
    goal:  "stove_stoked"
    rank:  2
    pre: {
        find:  ["wood"]
        match: #Felling & { me: #Agent & { freeHands: >=1 }, wood: #Stack & { unit: "firewood", place: #Inside | #OnTile } }
    }
    order: ["own", "habit", "near"]
    steps: [#Do & { op: "take_some", object: "wood", units: 6 }]
} @family(methods)

look_in_the_woodpile: #Method & {
    title:  "look in the woodpile"
    goal:   "stove_stoked"
    rank:   3
    pre:    { find: ["woodpile"], match: #Felling & { woodpile: #Woodpile } }
    order:  ["own", "habit", "likely", "near"]
    seeks:  #Stack & { unit: "firewood" }
    search: "woodpile"
    places: 2
    steps:  [#Do & { op: "look_in", object: "woodpile" }]
} @family(methods)

// Fell a tree in reach, an axe in hand: a while, with the hands, and hard
// work (bucking and splitting are steady work: no exertion of their own). Where it stood, its trunk lies.
fell: #Operation & {
    duration: 1200s
    uses:     ["hands"]
    exertion: 3
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Axe & { place: #Held & { by: $a } }
        destination: #Tree & { id: $t, fellsInto: $b, place: $p }
    }
    makes:    [{ blueprint: $b, at: $p, called: "a felled trunk" }]
    consumes: [{ consumed: $t, because: "felled" }]
} @family(operations)

// Cut a length off a trunk of more than one, an axe in hand (bucking): a
// few minutes, with the hands; the length is a log of its own (as heavy as
// a length of the trunk is, carved from it), the trunk shorter. Sawing a
// log right through, its cut showing as it goes, is sawing/sawing.tri's;
// the woodcutters work with the axe alone, so as to have a hand free for
// the firewood.
buck: #Operation & {
    duration: 300s
    uses:     ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Axe & { place: #Held & { by: $a } }
        destination: #Trunk & { id: $t, lengths: $n & >=2, mass: $m, cutsInto: $b, place: $p }
    }
    makes: [{ blueprint: $b, at: $p, called: "a log sawn off", splitFrom: $t }]
    after: { destination: #Trunk & { lengths: $n - 1, mass: $m - $m / $n, sawn: 0 } }
} @family(operations)

// Cut a trunk's last length through, an axe in hand: as long again; it is
// a log, to split.
cut_through: #Operation & {
    duration: 300s
    uses:     ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Axe & { place: #Held & { by: $a } }
        destination: #Trunk & { lengths: 1, sawn: <=99 }
    }
    after: { destination: #Trunk & { sawn: 100 } }
} @family(operations)

// Split a log, sawn through, an axe in hand: it is firewood, lying where it
// was.
split: #Operation & {
    duration: 300s
    uses:     ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Axe & { place: #Held & { by: $a } }
        destination: #Log & { id: $l, sawn: 100, splitsInto: $b, place: $p }
    }
    makes:    [{ blueprint: $b, at: $p, called: "firewood" }]
    consumes: [{ consumed: $l, because: "split" }]
} @family(operations)

// Put firewood in hand into a stove in reach: its fuel, by the firewood's
// mass.
stoke: #Operation & {
    duration: 30s
    uses:     ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Stack & { id: $i, unit: "firewood", mass: $m, place: #Held & { by: $a } }
        destination: #Stove & { fuel: $f }
    }
    after:    { destination: #Stove & { fuel: $f + $m } }
    consumes: [{ consumed: $i, because: "burned" }]
} @family(operations)
