// Latent physical assembly (COMPONENTS.md §7, DOMAIN_SIMULATION.md Scenario
// 2, LATENT_ASSEMBLY.md).
//
// An assembly's descriptor (`latent`, in content with its blueprint) lists its
// roles: each a part blueprint, at a depth (the level opening reveals it at);
// and, per failure, the roles that could be its culprit. The assembly keeps
// what is revealed, the failures committed against it, and how long it has
// been used and abused (its history). Opening a level makes its parts
// entities, `partOf` the assembly, their mass carved out of the aggregate's.
//
// Wear is the assembly's use, shared out (LATENT_ASSEMBLY.md decisions 4-6,
// after dewdrop's latent anatomy): a role `wears` that many points in a
// hundred hours of use, `strain` times as fast while the assembly is abused,
// and faster the poorer it is. Its quality is hidden, decided when the unit
// was made: 50, give or take 20 by the unit's seed, and the blueprint's
// `bias` for its kind of part. Every hour of use risks each failure: its
// `chance` in a thousand, per hundred hours, when new, four times that when
// its most worn candidate is worn through. The culprit is drawn among the
// candidates by the unit's seed, weighted by their wear, and decided once.
// Not among the level's parts, it isn't marked: none is invented.

#LatentRole:   { roleName: text, partKind: text, depth: int, wears: int & >=0 & <=100, strain: int & >=1 & <=10 }
#Culprit:      { failing: text, candidates: [...text], chance: int & >=0 & <=1000 }
// A kind of part a blueprint makes better (positive) or worse than usual.
#Bias:         { biased: text, bias: int & >=-50 & <=50 }
// `pathWhenOut`: the role whose extraction opens a path from the store the
// assembly holds back (its `riser`) to its floor, through `pathThrough`,
// which passes in proportion to its wear past half (DOMAIN_SIMULATION.md
// Scenario 2: the open cylinder, through the outlet check valve).
#LatentSchema: { parts: [...#LatentRole], culprits: [...#Culprit], biases: [...#Bias], pathWhenOut: text, pathThrough: text }

#Latent: #Body & {
    @component(Latent)
    revealed: *0 | int & >=0 & <=8             @field(content, saved, proposable, inspect)
    failure:  text                             @field(saved, proposable, inspect)
    failedAt: *0ms | time & >=0ms & <=10000d   @field(content, saved, proposable, inspect)
    riser:    ref                              @field(saved, proposable, inspect)
    leaking:  *false | true                    @field(content, saved, proposable, inspect)
    // how long it has been worked, and how long of that abused
    used:     *0ms | time & >=0ms & <=100000d  @field(content, saved, proposable, inspect)
    abused:   *0ms | time & >=0ms & <=100000d  @field(content, saved, proposable, inspect)
    // the role its failure is due to, decided at the failure (or, for a
    // failure a scenario set, when first opened); hidden
    blamed:   text                             @field(saved, proposable, inspect)
    latent:   #LatentSchema
}

// A revealed part: how worn it is (0 to 100), which can be seen; the
// assembly it came from; whether it has left it.
#Part: #Body & {
    @component(Part)
    wear:     *0 | int & >=0 & <=100           @field(content, saved, proposable, inspect, perceive(sight))
    cameFrom: ref                              @field(saved, proposable, inspect)
    fits:     text                             @field(saved, proposable, inspect, perceive(sight))
    detached: *false | true                    @field(content, saved, proposable, inspect)
}

pump_handle:  #Part & { material: "iron", mass: 2kg }
pump_cover:   #Part & { material: "iron", mass: 3kg }
piston:       #Part & #ThermalBody & { material: "iron", mass: 4kg, heat: 0, heatCapacity: 1800, toAir: 0, toOutdoors: 0 }
leather_cup:  #Part & { material: "rubber", mass: 200g }
inlet_valve:  #Part & { material: "brass", mass: 500g }
outlet_valve: #Part & { material: "brass", mass: 500g }

// The crank-driven piston pump's insides. The leather cup wears fastest, and
// three times as fast run dry; the valves next; iron, slowly. It loses flow
// about once in five hundred hours of use when new; seizing isn't from use.
#CrankPumpParts: #LatentSchema & {
    parts: [{ roleName: "handle", partKind: "pump_handle", depth: 1, wears: 1 },
            { roleName: "cover", partKind: "pump_cover", depth: 1, wears: 0 },
            { roleName: "piston", partKind: "piston", depth: 2, wears: 1 },
            { roleName: "piston_seal", partKind: "leather_cup", depth: 2, wears: 5, strain: 3 },
            { roleName: "inlet_valve", partKind: "inlet_valve", depth: 2, wears: 3 },
            { roleName: "outlet_valve", partKind: "outlet_valve", depth: 2, wears: 3 }]
    culprits: [{ failing: "flow_loss", candidates: ["piston_seal", "inlet_valve", "outlet_valve", "housing"], chance: 2 },
               { failing: "seized", candidates: [], chance: 0 }]
    pathWhenOut: "piston"
    pathThrough: "outlet_valve"
}

// The crank-driven piston pump: 40 kg in all, its parts inside until opened.
// `warm_pump`: the same with its heat (iron, 18 kJ/K), which a part leaving
// it takes its share of, by heat capacity (Scenario 2's check 3).
crank_pump: #Pump & #Latent & {
    material: "iron", mass: 40kg, slots: 8, lift: 20000
    latent: #CrankPumpParts
}

warm_pump: #Pump & #Latent & #ThermalBody & {
    material: "iron", mass: 40kg, slots: 8, heat: 5490000, heatCapacity: 18000, toAir: 0, toOutdoors: 0
    latent: #CrankPumpParts
}

// A cheap make of the same pump, whose leather is poor; and a rickety one,
// that fails five hundred times as often, for trying failure out.
cheap_pump: #Pump & #Latent & {
    material: "iron", mass: 40kg, slots: 8, lift: 20000
    latent: #CrankPumpParts & { biases: [{ biased: "leather_cup", bias: -30 }] }
}
rickety_pump: #Pump & #Latent & {
    material: "iron", mass: 40kg, slots: 8, lift: 20000
    latent: {
        parts: [{ roleName: "handle", partKind: "pump_handle", depth: 1, wears: 1 },
                { roleName: "cover", partKind: "pump_cover", depth: 1, wears: 0 },
                { roleName: "piston", partKind: "piston", depth: 2, wears: 1 },
                { roleName: "piston_seal", partKind: "leather_cup", depth: 2, wears: 5, strain: 3 },
                { roleName: "inlet_valve", partKind: "inlet_valve", depth: 2, wears: 3 },
                { roleName: "outlet_valve", partKind: "outlet_valve", depth: 2, wears: 3 }]
        culprits: [{ failing: "flow_loss", candidates: ["piston_seal", "inlet_valve", "outlet_valve", "housing"], chance: 1000 }]
        pathWhenOut: "piston"
        pathThrough: "outlet_valve"
    }
}

// The same pump out in the yard: it gives its heat to the outdoors.
yard_pump: #Pump & #Latent & #ThermalBody & {
    material: "iron", mass: 40kg, slots: 8, heat: 5490000, heatCapacity: 18000, toAir: 0, toOutdoors: 50
    latent: #CrankPumpParts
}

// COMPONENTS.md Scenario 3's hand pump: its piston is itself an assembly,
// with the seal inside. A culprit that is itself an assembly isn't worn: it
// takes the failure on, and its own descriptor finds its culprit. A part's
// `loss` is the flow it costs its pump while in it (provisional: 80 points
// at wear 60 or more); replacing it changes the pump's flow by the delta.
nested_piston: #Part & #Assembly & #Latent & #ThermalBody & {
    material: "iron", mass: 4kg, slots: 2, heat: 0, heatCapacity: 1800, toAir: 0, toOutdoors: 0
    latent: {
        parts:       [{ roleName: "seal", partKind: "leather_cup", depth: 1, wears: 5, strain: 3 }]
        culprits:    [{ failing: "flow_loss", candidates: ["seal"], chance: 0 }]
        pathWhenOut: ""
        pathThrough: ""
    }
}
hand_pump: #Pump & #Latent & {
    material: "iron", mass: 40kg, slots: 8
    latent: {
        parts: [{ roleName: "handle", partKind: "pump_handle", depth: 1, wears: 1 },
                { roleName: "cover", partKind: "pump_cover", depth: 1, wears: 0 },
                { roleName: "piston", partKind: "nested_piston", depth: 1, wears: 1 },
                { roleName: "inlet_valve", partKind: "inlet_valve", depth: 1, wears: 3 },
                { roleName: "outlet_valve", partKind: "outlet_valve", depth: 1, wears: 3 }]
        culprits:    [{ failing: "flow_loss", candidates: ["piston"], chance: 2 }]
        pathWhenOut: ""
        pathThrough: ""
    }
}

// A leather hide, and a strip cut from it: an individual divided.
hide:          #Body & { material: "leather", mass: 1kg }
leather_strip: #Part & { material: "leather", mass: 100g }

// Cut a strip from a hide held: the hide persists, smaller.
cut_strip: #Operation & {
    effect: "cut"
    roles: {
        actor: #Agent & { id: $a }
        item:  #Body & { material: "leather", place: #Held & { by: $a } }
    }
} @family(operations)

// Shape a strip held into a seal: it fits the role a seal fills.
shape_seal: #Operation & {
    effect: "shape"
    roles: {
        actor: #Agent & { id: $a }
        item:  #Part & { material: "leather", place: #Held & { by: $a } }
    }
} @family(operations)

// Put a part held back into the assembly it came from, in its role.
install_part: #Operation & {
    effect: "install"
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Part & { place: #Held & { by: $a } }
        destination: #Latent
    }
} @family(operations)

// Which claims cover parts: a claim of this kind on an assembly covers what
// is part of it, and what came out of it (COMPONENTS.md Scenario 3).
#Coverage: { claimKind: #ClaimKind, viaPartOf: *false | true }
ownership_covers: #Coverage & { claimKind: "ownership", viaPartOf: true } @family(coverage)

// The raised header tank the riser fills, and a leak: a tap installed in a
// store, open, at the rate the path allows.
header_tank: #Assembly & #WaterStore & { material: "oak", mass: 30kg, slots: 2, water: 100L, waterCapacity: 100L }
// A well a pump draws from.
well:        #Assembly & #WaterStore & { material: "stone", mass: 500kg, slots: 1, water: 10m3, waterCapacity: 10m3 }
leak:        #Tap & { material: "brass", mass: 0g, capacity: 1, rate: 0, open: true }

// Replace a worn part in an assembly with a spare that fits its role, held:
// the worn one out onto the floor, the spare in its place. A part worn by a
// failure, replaced, repairs it (provisional: LATENT_ASSEMBLY.md).
replace_part: #Operation & {
    effect:   "replace"
    duration: 5s
    uses:     ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Part & { place: #Held & { by: $a }, fits: $r }
        destination: #Part & { place: #Installed, fits: $r, wear: >=60 }
    }
} @family(operations)

// Clean out an open assembly's cylinder, with a wrench in hand, for ten
// minutes: watching the floor, as water may come (ACTIONS.md Scenario 3).
clean_out: #Operation & {
    effect:     "tend"
    duration:   10min
    uses:       ["hands"]
    floodWatch: 500
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Wrench & { place: #Held & { by: $a } }
        destination: #Latent
    }
} @family(operations)

// Work a pump in reach for an hour: it lifts water from the store it draws
// from into its riser, at its flow, and is used an hour. What it can't draw,
// the store run dry, it is abused for: worked dry.
work_pump: #Operation & {
    effect:   "work"
    duration: 1h
    uses:     ["hands"]
    roles: {
        actor: #Agent
        item:  #Pump & #Latent
    }
} @family(operations)

// Open an assembly in reach a level further, with a wrench in hand.
open_up: #Operation & {
    effect: "reveal"
    uses:   ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Wrench & { place: #Held & { by: $a } }
        destination: #Latent
    }
} @family(operations)
