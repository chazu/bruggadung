// Bonds: loyalty, formed by kinship, friendship and employment (AGENCY.md
// decision 12).
//
// Cut points:
// - full, reduced, abstract, frozen: a bond stands alike at every level of
//             detail; nothing moves its loyalty by itself yet. Loyalty
//             drifting toward a baseline, abstract, is planned
//             (DETAIL_REGIMES.md).
// - agency:   #Loyal weighs it, and `order: "loyal"` sorts by it
//             (agency.tri).
// - code:     bonds are made from these blueprints (hiring makes a
//             `work_bond`: effect_hire).

package bonds

// Loyalty (AGENCY.md decision 12): a weighted relation from an agent to
// another. It is the agent's own, as its dispositions are, formed by
// kinship, friendship, employment, or authored. Like a claim, it is reified: a bond,
// with no body and no location, of its holder (`bondOf`) `toward` the other.
// The holder knows it of whoever it recognizes as the other.
#Tie: "kin" | "friend" | "employ" | "sworn"

#Bond: #Thing & {
    @component(Bond)
    tie:     #Tie                              @field(content, saved, inspect)
    loyalty: int & >=0 & <=100                 @field(content, saved, proposable, inspect)
    bondOf:  ref                               @field(saved, proposable, inspect)
    toward:  ref                               @field(saved, proposable, inspect)
}

kin_bond:    #Bond & { tie: "kin", loyalty: 60 }
friend_bond: #Bond & { tie: "friend", loyalty: 20 }
work_bond:   #Bond & { tie: "employ", loyalty: 30 }
