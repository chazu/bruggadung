// Latent physical assembly (COMPONENTS.md §7, DOMAIN_SIMULATION.md Scenario
// 2). PROVISIONAL: the latent assembly document is to specify materialization,
// consistency with history, and culprit attribution; until it does, this is
// the least that meets §7 and the scenario's checks.
//
// An assembly's descriptor (`latent`, in content with its blueprint) lists its
// roles: each a part blueprint, at a depth (the level opening reveals it at);
// and, per failure, the roles that could be its culprit. The assembly keeps
// what is revealed, and the failures committed against it (its history).
// Opening a level makes its parts entities, `partOf` the assembly, their mass
// carved out of the aggregate's. A part's wear derives from the assembly's
// seed and its role, never its ID. The culprit is drawn from the seed and the
// failure alone, so it is the same whenever it is opened; only its wear, grown
// since the failure, differs. Not among the level's parts, it isn't marked:
// none is invented.

#LatentRole:   { roleName: text, partKind: text, depth: int }
#Culprit:      { failing: text, candidates: [...text] }
// `pathWhenOut`: the role whose extraction opens a path from the store the
// assembly holds back (its `riser`) to its floor, through `pathThrough`,
// which passes in proportion to its wear past half (DOMAIN_SIMULATION.md
// Scenario 2: the open cylinder, through the outlet check valve).
#LatentSchema: { parts: [...#LatentRole], culprits: [...#Culprit], pathWhenOut: text, pathThrough: text }

#Latent: #Body & {
    @component(Latent)
    revealed: *0 | int & >=0 & <=8             @field(content, saved, proposable, inspect)
    failure:  text                             @field(saved, proposable, inspect)
    failedAt: *0ms | time & >=0ms & <=10000d   @field(content, saved, proposable, inspect)
    riser:    ref                              @field(saved, proposable, inspect)
    leaking:  *false | true                    @field(content, saved, proposable, inspect)
    latent:   #LatentSchema
}

// A revealed part: how worn it is (0 to 100), which can be seen; the
// assembly it came from; whether it has left it.
#Part: #Body & {
    @component(Part)
    wear:     *0 | int & >=0 & <=100           @field(content, saved, proposable, inspect, perceive(sight))
    cameFrom: ref                              @field(saved, proposable, inspect)
    fits:     text                             @field(saved, proposable, inspect, perceive(sight))
    detached: *false | true                    @field(content, saved, proposable, inspect)
}

pump_handle:  #Part & { material: "iron", mass: 2kg }
pump_cover:   #Part & { material: "iron", mass: 3kg }
piston:       #Part & #ThermalBody & { material: "iron", mass: 4kg, heat: 0, heatCapacity: 1800, toAir: 0, toOutdoors: 0 }
leather_cup:  #Part & { material: "rubber", mass: 200g }
inlet_valve:  #Part & { material: "brass", mass: 500g }
outlet_valve: #Part & { material: "brass", mass: 500g }

// The crank-driven piston pump: 40 kg in all, its parts inside until opened.
// `warm_pump`: the same with its heat (iron, 18 kJ/K), which a part leaving
// it takes its share of, by heat capacity (Scenario 2's check 3).
crank_pump: #Pump & #Latent & {
    material: "iron", mass: 40kg, slots: 8
    latent: {
        parts: [{ roleName: "handle", partKind: "pump_handle", depth: 1 },
                { roleName: "cover", partKind: "pump_cover", depth: 1 },
                { roleName: "piston", partKind: "piston", depth: 2 },
                { roleName: "piston_seal", partKind: "leather_cup", depth: 2 },
                { roleName: "inlet_valve", partKind: "inlet_valve", depth: 2 },
                { roleName: "outlet_valve", partKind: "outlet_valve", depth: 2 }]
        culprits: [{ failing: "flow_loss", candidates: ["piston_seal", "inlet_valve", "outlet_valve", "housing"] },
                   { failing: "seized", candidates: [] }]
        pathWhenOut: "piston"
        pathThrough: "outlet_valve"
    }
}

warm_pump: #Pump & #Latent & #ThermalBody & {
    material: "iron", mass: 40kg, slots: 8, heat: 5490000, heatCapacity: 18000, toAir: 0, toOutdoors: 0
    latent: {
        parts: [{ roleName: "handle", partKind: "pump_handle", depth: 1 },
                { roleName: "cover", partKind: "pump_cover", depth: 1 },
                { roleName: "piston", partKind: "piston", depth: 2 },
                { roleName: "piston_seal", partKind: "leather_cup", depth: 2 },
                { roleName: "inlet_valve", partKind: "inlet_valve", depth: 2 },
                { roleName: "outlet_valve", partKind: "outlet_valve", depth: 2 }]
        culprits: [{ failing: "flow_loss", candidates: ["piston_seal", "inlet_valve", "outlet_valve", "housing"] },
                   { failing: "seized", candidates: [] }]
        pathWhenOut: "piston"
        pathThrough: "outlet_valve"
    }
}

// The same pump out in the yard: it gives its heat to the outdoors.
yard_pump: #Pump & #Latent & #ThermalBody & {
    material: "iron", mass: 40kg, slots: 8, heat: 5490000, heatCapacity: 18000, toAir: 0, toOutdoors: 50
    latent: {
        parts: [{ roleName: "handle", partKind: "pump_handle", depth: 1 },
                { roleName: "cover", partKind: "pump_cover", depth: 1 },
                { roleName: "piston", partKind: "piston", depth: 2 },
                { roleName: "piston_seal", partKind: "leather_cup", depth: 2 },
                { roleName: "inlet_valve", partKind: "inlet_valve", depth: 2 },
                { roleName: "outlet_valve", partKind: "outlet_valve", depth: 2 }]
        culprits: [{ failing: "flow_loss", candidates: ["piston_seal", "inlet_valve", "outlet_valve", "housing"] },
                   { failing: "seized", candidates: [] }]
        pathWhenOut: "piston"
        pathThrough: "outlet_valve"
    }
}

// COMPONENTS.md Scenario 3's hand pump: its piston is itself an assembly,
// with the seal inside. A culprit that is itself an assembly isn't worn: it
// takes the failure on, and its own descriptor finds its culprit. A part's
// `loss` is the flow it costs its pump while in it (provisional: 80 points
// at wear 60 or more); replacing it changes the pump's flow by the delta.
nested_piston: #Part & #Assembly & #Latent & #ThermalBody & {
    material: "iron", mass: 4kg, slots: 2, heat: 0, heatCapacity: 1800, toAir: 0, toOutdoors: 0
    latent: {
        parts:       [{ roleName: "seal", partKind: "leather_cup", depth: 1 }]
        culprits:    [{ failing: "flow_loss", candidates: ["seal"] }]
        pathWhenOut: ""
        pathThrough: ""
    }
}
hand_pump: #Pump & #Latent & {
    material: "iron", mass: 40kg, slots: 8
    latent: {
        parts: [{ roleName: "handle", partKind: "pump_handle", depth: 1 },
                { roleName: "cover", partKind: "pump_cover", depth: 1 },
                { roleName: "piston", partKind: "nested_piston", depth: 1 },
                { roleName: "inlet_valve", partKind: "inlet_valve", depth: 1 },
                { roleName: "outlet_valve", partKind: "outlet_valve", depth: 1 }]
        culprits:    [{ failing: "flow_loss", candidates: ["piston"] }]
        pathWhenOut: ""
        pathThrough: ""
    }
}

// A leather hide, and a strip cut from it: an individual divided.
hide:          #Body & { material: "leather", mass: 1kg }
leather_strip: #Part & { material: "leather", mass: 100g }

// Cut a strip from a hide held: the hide persists, smaller.
cut_strip: #Operation & {
    effect: "cut"
    roles: {
        actor: #Agent & { id: $a }
        item:  #Body & { material: "leather", place: #Held & { by: $a } }
    }
} @family(operations)

// Shape a strip held into a seal: it fits the role a seal fills.
shape_seal: #Operation & {
    effect: "shape"
    roles: {
        actor: #Agent & { id: $a }
        item:  #Part & { material: "leather", place: #Held & { by: $a } }
    }
} @family(operations)

// Put a part held back into the assembly it came from, in its role.
install_part: #Operation & {
    effect: "install"
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Part & { place: #Held & { by: $a } }
        destination: #Latent
    }
} @family(operations)

// Which claims cover parts: a claim of this kind on an assembly covers what
// is part of it, and what came out of it (COMPONENTS.md Scenario 3).
#Coverage: { claimKind: #ClaimKind, viaPartOf: *false | true }
ownership_covers: #Coverage & { claimKind: "ownership", viaPartOf: true } @family(coverage)

// The raised header tank the riser fills, and a leak: a tap installed in a
// store, open, at the rate the path allows.
header_tank: #Assembly & #WaterStore & { material: "oak", mass: 30kg, slots: 2, water: 100L, waterCapacity: 100L }
leak:        #Tap & { material: "brass", mass: 0g, capacity: 1, rate: 0, open: true }

// Replace a worn part in an assembly with a spare that fits its role, held:
// the worn one out onto the floor, the spare in its place. A part worn by a
// failure, replaced, repairs it (provisional, as the rest).
replace_part: #Operation & {
    effect:   "replace"
    duration: 5s
    uses:     ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Part & { place: #Held & { by: $a }, fits: $r }
        destination: #Part & { place: #Installed, fits: $r, wear: >=60 }
    }
} @family(operations)

// Clean out an open assembly's cylinder, with a wrench in hand, for ten
// minutes: watching the floor, as water may come (ACTIONS.md Scenario 3).
clean_out: #Operation & {
    effect:     "tend"
    duration:   10min
    uses:       ["hands"]
    floodWatch: 500
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Wrench & { place: #Held & { by: $a } }
        destination: #Latent
    }
} @family(operations)

// Open an assembly in reach a level further, with a wrench in hand.
open_up: #Operation & {
    effect: "reveal"
    uses:   ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Wrench & { place: #Held & { by: $a } }
        destination: #Latent
    }
} @family(operations)
