// Arithmetic: a lever's torque from its force and arm (GUIDE.md section 9).
//
// Generated from docs/GUIDE.md: edit the guide, then rerun
// `make examples`. test_docs_guide checks these files mean the same content.

// 9. Arithmetic

#Lever: #Tool & {
    force:  $f & force & >=1N & <=500N
    arm:    $a & length
    torque: $f * $a
}

breaker: #Lever & { material: "steel", size: 60cm, mass: 2kg, arm: 0.5m, force: 80N }

let socket = 30mm

#Ratchet: #Lever & { reach: .arm + socket }

ratchet: #Ratchet & { material: "steel", size: 30cm, mass: 1kg, arm: 0.25m, force: 60N }
