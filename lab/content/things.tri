// Things: the component kinds every topic shares, and what descriptions say
// besides component fields (ids, places, free hands). Each @component type
// is one component kind; the features it introduces are its fields, with
// their field registry flags. A topic adds fields of its own to these kinds,
// in its directory: work's `hires`, on #Agent, is in work/work.tri.
//
// Cut points:
// - detail:  none here. What a field does at each level of detail is its
//            topic's to say.
// - looks:   a kind's #Look is declared beside the kind, here or in its
//            topic; what each theme draws for a look is looks/'s.
// - seen:    whether a kind shows at a glance is its #Seen entry
//            (knowledge.tri), declared beside the kind, here or in its topic.
// - code:    an #Area's tiles are the world's to say: what is near, what is
//            seen and what is in reach (src/core_world.odin, src/act_view.odin,
//            src/know_knowledge_2.odin, src/agency_agency.odin).
// - code:    the structs and the registry the lab uses are generated from all
//            the content, every topic's fields with these (make gen:
//            src/components.odin); the lab refuses to run on content
//            with another hash.

// What things are made of, and the colours they come in: hierarchies, so a
// memory loses detail along them (KNOWLEDGE.md §12): an oak chest is
// remembered as wooden, then as made of something.
#Material: "metal" | "wood" | "flesh" | "paper" | "food" | "cloth" | "rubber" | "stone" | "leather" | "earth" | "plant" | "rot"
"metal":   "iron" | "brass" | "steel"
"wood":    "oak" | "birch"
"plant":   "grain" | "turnip" | "wicker"

#Colour:  "dark" | "light" | "bright"
"dark":   "black" | "grey" | "brown" | "navy"
"light":  "white" | "beige"
"bright": "red" | "yellow" | "blue" | "green" | "purple" | "orange"

// --- what descriptions say besides component fields ----------------------
//
// An agent's view of an entity (for now, the truth projection) is a
// description: the entity's type, its id, its place, and the component
// fields it can perceive. Places and ids are relations and handles, not
// component fields, so they are introduced here, by types that are not
// components: the generated structs don't carry them.

// Anything with identity. In the truth projection, id is the entity's handle.
#Thing: { id: ref }

// How something is drawn (TESSERA.md decision 6): its look, an appearance
// key, which a backend's theme gives a glyph, a sprite (looks/). Terrain
// kinds carry theirs (terrain/terrain.tri); a thing's is a #Look, declared
// beside its kind.
#Looks: { look: text }

// Something said of a kind: `kindOf`, the kind, a type ("#Bed") or, where
// it says so, a blueprint ("scarecrow").
#OfKind: { kindOf: text }

// What things of a kind look like: `kindOf`, the kind, a type ("#Bed") or a
// blueprint ("scarecrow"). A thing looks as the most specific kind it is
// with a look: its blueprint, then its blueprint's type, then that type's
// parents, in turn (a look can't be a field refined down the types: two
// defaults conflict). A thing several kinds at once (a cistern, an assembly
// and a water store) looks as the one whose look `prevails` most; on a tie,
// the first.
#Look: #Looks & #OfKind & { prevails: *0 | int }

thing_look:     #Look & { kindOf: "#Thing", look: "thing", prevails: -2 } @family(looks)
body_look:      #Look & { kindOf: "#Body", look: "body", prevails: -1 } @family(looks)
agent_look:     #Look & { kindOf: "#Agent", look: "agent", prevails: 3 } @family(looks)
stack_look:     #Look & { kindOf: "#Stack", look: "stack" } @family(looks)
container_look: #Look & { kindOf: "#Container", look: "container" } @family(looks)
assembly_look:  #Look & { kindOf: "#Assembly", look: "assembly", prevails: 2 } @family(looks)

// Where a physical thing is: the location relation, as a description.
#Place:     {}
#OnTile:    #Place & { x: int, y: int, level: int }
#Inside:    #Place & { container: ref }
#Held:      #Place & { by: ref, hand: int }
#Installed: #Place & { assembly: ref, role: text, index: int }

#Placed: #Thing & { place: #Place }

// What an agent's hands are doing: a derived value, not a stored field.
#Handed: { freeHands: int & >=0 & <=4 }

// A physical thing: what it weighs, what it is made of, and the traces it
// carries. Units of a stack share one Body, so marks on one unit split it off.
#Body: #Placed & {
    @component(Body)
    mass:      mass                    @field(content, saved, proposable, inspect, perceive(touch))
    material:  #Material               @field(content, saved, inspect, perceive(sight))
    // what its material looks like, if not itself (KNOWLEDGE.md §4): the
    // senses report it instead; an analysis reaches beneath it
    surface:   *"natural" | "metal" | "wood" | "flesh" | "paper" @field(content, saved, inspect, appears(material))
    bent:      *false | true           @field(saved, proposable, inspect, perceive(sight))
    toolMarks: *0 | int & >=0 & <=100  @field(saved, proposable, inspect, perceive(sight))
}

body_seen: #Seen & { kindOf: "#Body" } @family(seen)

// A thing that covers ground: `east` tiles east and `south` tiles south
// from the tile it is placed on (its north-west corner), as a plot does
// (farming/farming.tri). It is seen when any of its tiles is in sight, and
// in reach from on it or beside it; an agent knows it by one referent, the
// area as a whole.
#Area: #Body & {
    @component(Area)
    east:  *1 | int & >=1 & <=256 @field(content, saved, proposable, inspect, perceive(sight))
    south: *1 | int & >=1 & <=256 @field(content, saved, proposable, inspect, perceive(sight))
}

// Identical units counted as one entity. The stack's mass is its units'.
#Stack: #Body & {
    @component(Stack)
    count:    $n & int & >=1 & <=100000 @field(content, saved, proposable, inspect)
    unitMass: $u & mass                 @field(content, saved, inspect)
    unit:     text                      @field(content, saved, inspect, perceive(sight))
    mass:     $u * $n
}

stack_seen: #Seen & { kindOf: "#Stack" } @family(seen)

// Something that acts, with hands to hold things in, a coat to know it by
// at a glance, and room in its memory for so many observations
// (KNOWLEDGE.md §12): past that, the least salient go first. Topics add
// fields of their own (work's `hires`, valves' `grip`).
#Agent: #Body & #Handed & {
    @component(Agent)
    hands:         int & >=0 & <=4                  @field(content, saved, inspect, perceive(sight))
    coat:          #Colour                          @field(content, saved, proposable, inspect, perceive(sight))
    memory:        *64 | int & >=1 & <=100000       @field(content, saved, inspect)
    // a disposition (AGENCY.md §9), in dB: how much it likes to help whoever
    // asks; others can't see it, only how it behaves
    helpful:       *0 | int & >=-30 & <=30          @field(content, saved, proposable, inspect)
    // expertise (KNOWLEDGE.md §9): what interpretation rules it can draw
    painting:      *0 | int & >=0 & <=100           @field(content, saved, inspect)
    // dispositions and an internal norm (AGENCY.md §9), 0 to 100: how honest
    // it is, how curious (it notices more), and how much it minds stealing
    honesty:       *50 | int & >=0 & <=100          @field(content, saved, proposable, inspect)
    curious:       *0 | int & >=0 & <=100           @field(content, saved, proposable, inspect)
    scruples:      *20 | int & >=0 & <=100          @field(content, saved, proposable, inspect)
    // how readily it does work nothing makes it do, such as keeping a
    // machine in order (AGENCY.md §9), 0 to 100: low, it is lazy
    diligent:      *50 | int & >=0 & <=100          @field(content, saved, proposable, inspect)
    // respect for reservations (AGENCY.md §9, ACTIONS.md §7), 0 to 100
    respectful:    *50 | int & >=0 & <=100          @field(content, saved, proposable, inspect)
    // the disposition to abide by the rules (INSTITUTIONS.md decision 5), 0 to 100
    abiding:       *50 | int & >=0 & <=100          @field(content, saved, proposable, inspect)
    // how readily it trusts what it is told (KNOWLEDGE.md decision 15), dB
    trusting:      *0 | int & >=-20 & <=20          @field(content, saved, proposable, inspect)
    // its trade (ACTIONS.md decision 12): it knows the trade's recipes
    trade:         text                             @field(content, saved, proposable, inspect)
    // a deeply held norm against striking anyone (AGENCY.md decision 14), 0
    // to 100: any of it vetoes doing so
    gentle:        *0 | int & >=0 & <=100           @field(content, saved, proposable, inspect)
    // temper (AGENCY.md §13), 0 to 100: how readily it meets harm with force
    temper:        *0 | int & >=0 & <=100           @field(content, saved, proposable, inspect)
    // reaction speed (ACTIONS.md §8): it weights the order of the agent's
    // actions among others' at the same boundary
    quickness:     *10 | int & >=1 & <=100          @field(content, saved, proposable, inspect)
    // risk tolerance (AGENCY.md §9), 0 to 100: a goal's believed risk counts
    // in full at 50, double at 0, and not at all at 100
    riskTolerance: *50 | int & >=0 & <=100          @field(content, saved, proposable, inspect)
    // half hidden: seen only from close by, though it sees as well as anyone
    hiding:        *false | true                    @field(content, saved, proposable, inspect)
    // fatigue (AGENCY.md §6, a component field), 0 to 100: effort raises
    // it, a night's rest clears it
    fatigue:       *0 | int & >=0 & <=100           @field(content, saved, proposable, inspect)
    // injury (AGENCY.md §6, a component field), 0 to 100, felt as pain; and
    // what changes how precisely the body is felt, not the body: adrenaline
    // dulls pain, numbness hides cold, by as many points
    injury:        *0 | int & >=0 & <=100           @field(content, saved, proposable, inspect)
    adrenaline:    *0 | int & >=0 & <=100           @field(content, saved, proposable, inspect)
    numbness:      *0 | int & >=0 & <=100           @field(content, saved, proposable, inspect)
}

agent_seen: #Seen & { kindOf: "#Agent" } @family(seen)

// Something entities can be put in.
#Container: #Body & {
    @component(Container)
    capacity: int & >=1 & <=1000 @field(content, saved, inspect, perceive(sight))
}

container_seen: #Seen & { kindOf: "#Container" } @family(seen)

// Something with parts installed in it.
#Assembly: #Body & {
    @component(Assembly)
    slots: int & >=1 & <=64 @field(content, saved, inspect, perceive(sight))
}

assembly_seen: #Seen & { kindOf: "#Assembly" } @family(seen)

#ClaimKind: "ownership" | "custody" | "reservation"

// A reified claim: an informational entity, with no body and no location.
// Its claimant and subjects are edges.
#Claim: #Thing & {
    @component(Claim)
    kind:     #ClaimKind       @field(content, saved, inspect)
    quantity: int & >=0 & <=100000 @field(content, saved, proposable, inspect)
}

// An ownership claim, as the lab makes them.
ownership: #Claim & { kind: "ownership" }
