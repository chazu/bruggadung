// The workshop of COMPONENTS.md's first scenario, "The marked nail".

// One iron nail: the unit of the nail stacks.
iron_nail: #Body & { material: "iron", mass: 3g }

// Nails in a stack. Their unit is iron_nail, and so is their unit mass.
nails_30: #Stack & { material: "iron", unit: "iron_nail", unitMass: 3g, count: 30 }
nails_10: #Stack & { material: "iron", unit: "iron_nail", unitMass: 3g, count: 10 }

// The workshop bin.
bin: #Container & { material: "oak", mass: 4kg, capacity: 50 }

// The lock that gets wedged shut.
lock: #Assembly & { material: "brass", mass: 600g, slots: 4 }

worker: #Agent & { material: "flesh", mass: 70kg, hands: 2, coat: "blue" }
smith:  #Agent & { material: "flesh", mass: 85kg, hands: 2, coat: "brown" }

ownership: #Claim & { kind: "ownership" }

// The cistern room of "Two draws on a dwindling stock": two agents, each
// with a tap and a bucket.
agent_a: #Agent & { material: "flesh", mass: 60kg, hands: 2, coat: "grey" }
agent_b: #Agent & { material: "flesh", mass: 65kg, hands: 2, coat: "green" }

// For AGENCY.md's first scenario, as "the missing nails": a crate across the
// workshop, and the spare nails that may be in it.
crate:   #Container & { material: "oak", mass: 2kg, capacity: 20 }
nails_4: #Stack & { material: "iron", unit: "iron_nail", unitMass: 3g, count: 4 }
// and a sack in the far corner, where nobody would think to look
sack:    #Container & { material: "cloth", mass: 300g, capacity: 10 }

// For the missing nails' "ask a coworker": the chest the smith puts the nails
// in, and the apprentice who may see it.
chest:      #Container & { material: "oak", mass: 6kg, capacity: 40 }
apprentice: #Agent & { material: "flesh", mass: 55kg, hands: 2, coat: "navy" }

// For KNOWLEDGE.md's first scenario, as "the rumour of the nails": a carter
// and a porter the apprentice tells, a neighbour who saw it too, and
// the foreman who hears it from them all.
carter:    #Agent & { material: "flesh", mass: 75kg, hands: 2, coat: "red" }
porter:    #Agent & { material: "flesh", mass: 80kg, hands: 2, coat: "yellow" }
neighbour: #Agent & { material: "flesh", mass: 60kg, hands: 2, coat: "grey" }
foreman:   #Agent & { material: "flesh", mass: 90kg, hands: 2, coat: "black", painting: 50 }

// For salience and bounded stores: someone who keeps little in mind.
gossip: #Agent & { material: "flesh", mass: 65kg, hands: 2, coat: "beige", memory: 4 }

// For appearance and truth: a fitting that looks brass, and is brass-plated
// steel.
fitting: #Body & { material: "steel", surface: "brass", mass: 400g }

// For the notebook: a record a character writes in, which can be stolen.
notebook: #Record & { material: "paper", mass: 200g }

// For AGENCY.md's false alarm: the watchman, with supper; the storeroom; and
// a cat.
watchman:  #Agent & { material: "flesh", mass: 80kg, hands: 2, coat: "grey" }
cat:       #Agent & { material: "flesh", mass: 4kg, hands: 0, coat: "black" }
storeroom: #Container & { material: "oak", mass: 200kg, capacity: 1000 }
supper:    #Body & { material: "food", mass: 300g }

// For AGENCY.md's tempting purse: the merchant's purse, the merchant,
// Kasimir, who owes, and Mira, a child, half hidden in a doorway.
purse:    #Body & { material: "cloth", mass: 150g }
merchant: #Agent & { material: "flesh", mass: 85kg, hands: 2, coat: "white" }
kasimir:  #Agent & { material: "flesh", mass: 70kg, hands: 2, coat: "beige", honesty: 10, scruples: 5 }
mira:     #Agent & { material: "flesh", mass: 25kg, hands: 2, coat: "red", curious: 100, hiding: true }

// For ACTIONS.md's two hands, one seal: the spare piston seal, and a
// reservation of it.
seal:        #Body & { material: "rubber", mass: 50g }
reservation: #Claim & { kind: "reservation" }

// For the coat at dusk: someone of the visitor's build, in a brown coat.
stranger: #Agent & { material: "flesh", mass: 60kg, hands: 2, coat: "brown" }

// For CONTENT_LANGUAGE.md's nut of unknown size: the pump's gland nut, and
// spanners.
gland_nut:    #Fastener & { material: "brass", mass: 50g, size: 19mm }
gland_nut_22: #Fastener & { material: "brass", mass: 70g, size: 22mm }
spanner_19:   #Spanner & { material: "steel", mass: 850g, size: 19mm }
spanner_22:   #Spanner & { material: "steel", mass: 950g, size: 22mm }

// For ACTIONS.md's seized valve: a valve rated 12 Nm, free or seized; a
// wrench, a length of pipe that fits over its handle, and a stone.
water_valve:  #Valve & { material: "brass", mass: 2kg, rating: 12Nm, breakaway: 12Nm }
seized_valve: #Valve & { material: "brass", mass: 2kg, rating: 12Nm, breakaway: 70Nm }
wrench_250:   #Wrench & { material: "steel", mass: 400g, leverage: 250mm, limit: 80Nm }
pipe_600:     #Pipe & { material: "iron", mass: 1500g, leverage: 600mm, limit: 2000Nm, sleeve: true }
stone:        #Body & { material: "stone", mass: 800g }

// For ACTIONS.md's interrupted repair: the miller's pump, the cocks on the
// riser and the trough line, and the diagram.
pump:        #Pump & { material: "iron", mass: 40kg, slots: 4 }
cock_trough: #Cock & { material: "brass", mass: 300g, serves: "trough" }
cock_pump:   #Cock & { material: "brass", mass: 300g, serves: "pump" }
diagram:     #Record & { material: "paper", mass: 20g }

// For ACTIONS.md §5's partial effects: a log, how far it is sawn through
// (percent), and a saw.
#Log: #Body & {
    @component(Log)
    sawn: *0 | int & >=0 & <=100               @field(content, saved, proposable, inspect, perceive(sight))
}
#HandSaw: #Body & {}
log:      #Log & { material: "oak", mass: 20kg }
hand_saw: #HandSaw & { material: "steel", mass: 700g }

// Light (KNOWLEDGE.md §5's conditions, authored): a lamp, shining, makes it
// day within `reach` tiles of where it is, held or set down.
#Lamp: #Body & {
    @component(Lamp)
    shining: *true | false                     @field(content, saved, proposable, inspect, perceive(sight))
    reach:   int & >=0 & <=10                  @field(content, saved, inspect)
}
lamp: #Lamp & { material: "brass", mass: 900g, reach: 2 }
