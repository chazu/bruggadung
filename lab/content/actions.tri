// Actions (ACTIONS.md): what an operation is, its stages, roles and traces,
// and the operations every topic uses: taking, putting in, giving, walking,
// looking in. A topic's own operations are in its directory.
//
// Operations (ACTIONS.md §1) are patterns over the descriptions of the
// entities that fill their roles. An actor's menu lists each operation and
// binding whose match is not incompatible; unknown never excludes. Tags carry
// bindings between roles. What it does is its effect: declared here
// (`after`, `moves`, `emits`; EFFECTS.md), or named (`effect`), the name of
// the code that builds the proposal group when the action is performed.
//
// Cut points:
// - full, reduced, abstract: an activity runs at its own pace while its actor
//            is at any of them (REALITY.md step 3).
// - frozen:  its activities wait; risen, a stage long due ends at once
//            (REALITY.md step 4; activities.tri).
// - code:    an `effect` names a function in src/act_actions.odin
//            (effect_eat, effect_drive, ...). #Effect lists them all: a
//            topic's new named effect is added there and in the code
//            together.
// - code:    a declared effect is applied by one procedure for all
//            (src/act_declared.odin), which resolves the operation against
//            the truth; so far `after`, `moves`, `makes`, `consumes` and
//            `emits`, for an operation or a stage. Taking, giving, putting
//            down, putting in and looking are declared; what a command
//            says reaches an effect as `said` and `written`. A move that
//            `passes` hands on whose the thing is (declared_pass: giving,
//            putting in); one that `lends` leaves it its owner's, in the
//            other's keeping (declared_lend: lending). What is nobody's
//            is whoever's takes it in hand, and their household's
//            (src/kinds_body_kind.odin).
//            An operation, or a stage, with no
//            effect named or declared and no trace is refused at load.
// - code:    a walk's stages come from its activity's way, not from the
//            operation (src/act_activities.odin); its way is found by the
//            walker, over the ground as it believes it, when it sets out,
//            and the walker gives it up when the way or what it goes to
//            changes (src/agency_agency.odin).
// - code:    `diagnosticStages` marks the stage's events diagnostic
//            (src/act_activities.odin); they are compacted into digests
//            after the world's history window (src/core_world.odin).

#Effect: "drive" | "fill" | "walk" | "say" | "tend" | "analyse" | "write" | "read" | "eat" | "investigate" | "rotate" | "strike" | "rest" | "saw" | "pass" | "copy" | "reveal" | "replace" | "cut" | "shape" | "issue" | "confiscate" | "arrest" | "flee" | "hit" | "hire" | "work" | "service" | "sow" | "keep_seed" | "harvest" | "crouch" | "shoot" | "butcher" | "shoulder" | "forage"

// Which roles an operation has is its roles' type: a structure's type is the
// most general one with all its features.
// #Bound is what `after` is before an operation says anything of it: roles,
// none of them named yet.
#Bound:        {}
#Roles:        #Bound & { actor: #Agent }
#ItemRoles:    #Roles & { item: #Body }
#PlacingRoles: #ItemRoles & { destination: #Body }

// Something that takes time and has an effect: an operation's single stage,
// or one of its stages. A stage whose progress shows in the world declares
// it `partial` (ACTIONS.md §5): a field of a role's entity (`showsOn`), the `whole` it
// reaches as the stage completes. It is set in proportion to the stage's
// progress at each of its `checkpoints` (evenly spaced; each a step
// boundary), and when the activity is interrupted: suspended, aborted, or
// failed. Its effect proper commits on completion, with its `exertion`: the
// fatigue it adds to the actor (AGENCY.md §6). With a `floodWatch`, water
// rising to that many millilitres on the actor's tile interrupts it. A hard interruption
// (what it binds gone or out of reach, or what it needs no longer holding)
// suspends it, or fails it, as it declares (`hard`).
#Partial: { field: text, showsOn: *"destination" | "item", whole: int }

// A declared effect (EFFECTS.md): what a step does, said here and not in
// code. `after` is the roles as the effect leaves them: each field it
// states is set, if the truth isn't that already. `moves` puts a thing
// (`moved`, by a tag on its role's id) `into` a place: a tile, a container,
// a hand (#Held, `by` whom), which is a free one of theirs, or a role in an
// assembly (#Installed). `emits` is events, by `event` (its kind), subject
// and other, and a `detail` if it gives one (what was written). A step has a declared effect or names one (`effect`), not
// both. The requirements stay in `roles`: they are matched once from what
// the actor perceives, for the menu, and again against the truth when the
// effect commits, where what doesn't hold fails the action.
//
// Of a stack, a `portion` is so many of its units: moved, they are split
// off, and are that role from then on, so what `after` says of the role it
// says of them, and the rest of the stack is as it was. `consumes` destroys
// a thing, or a portion of it, `because` of what (its tombstone's reason).
// A portion of more units than there are is all of them, unless it is
// `exact`: then the effect fails (paying, there must be so many coins).
// A move that `passes` hands on whose the thing is (a claim of ownership,
// things.tri) with it: put in another's hand, it is theirs, and their
// household's (those they have kin bonds toward); put into a container,
// its owners'. Only its owner passes it, or anyone what is
// nobody's; nothing passes to those who own it already.
// A move that `lends` leaves it whose it was, in the keeping of the one
// whose hand it is put in and their household (or of the owners of what it
// is put into): a claim of keeping, by which holding and using it is no
// wrong, `until` a time if the move says one: past it, the claim has
// lapsed, and holding it on is as holding any other's thing. Its owner
// lends it; one who lends what is nobody's is its owner by lending it.
// Moved back into its owner's hand, or into something of its owner's, by
// any move, it is in nobody's keeping any more: giving it back is a `give`
// like any, which passes nothing (it isn't the giver's) and ends the
// keeping.
// `makes` constructs a thing from a `blueprint`, `at` a place (where a role
// was, by a tag on its `place`), `called` what its construction is recorded
// as; `splitFrom` says what it was carved from, if anything.
// An operation's `now` is the time its effect commits (`spoilsAt: $now +
// $k`), its `parameter` the command's (how many), its `said` and `written`
// what the command says, as a value and as written (market/'s `post`). Into a hand, of an operation
// that stows (`stow`), is into a pack its actor carries, if it fits. Arithmetic in `after` is Triangle's (CONTENT_LANGUAGE.md §5).
#OfSome:   { portion: int & >=1, exact: bool }
#Moves:    #OfSome & { moved: ref, into: #Place, passes: bool, lends: bool, until: time }
#Consumes: #OfSome & { consumed: ref, because: text }
#Emits:    { event: text, subject: ref, other: ref, detail: text }
#Makes:    { blueprint: text, at: #Place, called: text, splitFrom: ref }

// Looking at something within reach changes nothing in the world: it is
// an event the looker perceives. Its operations say what is looked at.
#Looking: #Operation & {
    roles: {
        actor: #Agent & { id: $a }
        item:  #Body & { id: $i }
    }
    emits: [{ event: "looked", subject: $a, other: $i }]
}
#Step: {
    duration:    time & >=0ms & <=1d
    effect:      #Effect
    partial:     #Partial
    checkpoints: *0 | int & >=0 & <=100
    hard:        *"suspend" | "fail"
    exertion:    *0 | int & >=0 & <=100
    floodWatch:  *0 | int & >=0 & <=1000000
    leaves:      [...#Leaves]
    removes:     [...#Removes]
    after:       #Bound
    moves:       [...#Moves]
    consumes:    [...#Consumes]
    makes:       [...#Makes]
    emits:       [...#Emits]
}

// A stage of an activity: it takes `duration`, and its effect commits when
// it is done (ACTIONS.md §5).
#Stage: #Step & { duration: >=1ms }

// What of the actor's an activity occupies while it runs (ACTIONS.md §5,
// provider allocation): an actor runs two activities at once only if they
// use different providers. Walking while driving a nail is two activities;
// two walks are not.
#Provider: "hands" | "legs" | "voice"

// An operation with stages, or with a duration (one stage), is a timed
// activity, which can be suspended and resumed, keeping its progress. One
// without is instant, unless its effect's code makes it an activity that ends
// by a watch or an event (fill).
// `attention` is what it demands of the actor while it runs (AGENCY.md
// §10): it raises what the actor must find salient to notice it. `leaves`
// and `removes` are its traces (KNOWLEDGE.md §3; the vocabulary here, the kinds in traces/traces.tri), made and
// removed with its effect, when it completes: an operation that removes
// traces leaves some of its own, so a cover-up can be found out. A stage
// may leave its own, with its own effect (ACTIONS.md §2: costs are
// committed per stage). With `diagnosticStages`, what each stage but the
// last does is a step along the way, not history: kept a day, then counted
// into a digest (KNOWLEDGE.md decision 21); the last, and how it ends, are
// history.
#Operation: #Step & {
    roles:            #Roles
    // when its effect commits: for a declared effect to reckon from
    now:              time
    // the command's parameter (how many, for take_some): for a declared
    // effect to use (`portion: $n`)
    parameter:        int
    // what the command says (a price to post), twice: as a value, for
    // what the operation requires of it (`said: #Writing`: a command that
    // says nothing, or something else, fails), and as it is written, for
    // a declared effect to write down or tell of (`written`)
    said:             _
    written:          text
    // how far its other roles may be from the actor, in tiles: 1, beside it
    // (a shot, further: hunting/)
    range:            *1 | int & >=1 & <=8
    // how far a flight carries, in tiles (flee, law/; an animal's bolt,
    // hunting/)
    run:              *4 | int & >=1 & <=16
    // what it takes, or is handed, goes into a pack its taker carries if it
    // fits, else into a free hand (carrying/)
    stow:             *false | true
    stages:           [...#Stage]
    uses:             [...#Provider]
    attention:        *0 | int & >=0 & <=100
    contest:          text
    graded:           #Graded
    diagnosticStages: *false | true
}

// A graded requirement (ACTIONS.md decision 11): what a role brings (the
// `offers` field of the `offerer`'s entity) as a percent of what another
// demands (`demands`, of the `demander`'s). Curves over that percent, as
// agency's considerations have: how long it takes, in percent (`slowing`);
// the chance of a mishap, in thousandths (`mishap`), leaving its `slip`;
// and the result's quality, in percent, set on the demander's `grades`.
#Graded: {
    offerer:  #TraceSite
    offers:   text
    demander: #TraceSite
    demands:  text
    slowing:  [...#Point]
    mishap:   [...#Point]
    slip:     #Leaves
    quality:  [...#Point]
    grades:   text
}

#Sense: "sight" | "smell" | "hearing"

// Where an operation leaves a trace, or removes one: on one of its roles, or
// on the tile the actor stands on.
#TraceSite: "actor" | "item" | "destination" | "tile"
#TraceAt:   { trace: text, on: #TraceSite }
#Leaves:    #TraceAt & { strength: int & >=1 & <=100 }
#Removes:   #TraceAt & {}

// `contest` (ACTIONS.md decision 13): the actor's field that weights its
// groups when they conflict with others in the action phase; taking is a
// matter of quickness. Without one, who goes first is an even draw.

// A taking: an operation by which its actor comes to hold its item, which
// it did not. It is what a law forbids (institutions/law.tri's `forbids`
// names this type, or one under it): an operation is a taking by being
// declared one, whatever its effect is and however many stages it has.
#Taking: #Operation & { roles: { actor: #Agent, item: #Body } }

// Pick something up into a free hand: from a container, the ground, or an
// assembly it is installed in.
take: #Taking & {
    contest: "quickness"
    roles: {
        actor: #Agent & { id: $a, freeHands: >=1 }
        item:  #Body & { id: $i, place: #Inside | #OnTile | #Installed }
    }
    moves: [{ moved: $i, into: #Held & { by: $a } }]
} @family(operations) @quickcheck(actor.freeHands)

// Take some units of a stack into a free hand: from a container, the ground,
// or the actor's other hand. How many is the command's.
take_some: #Taking & {
    contest:   "quickness"
    parameter: $n & >=1
    roles: {
        actor: #Agent & { id: $a, freeHands: >=1 }
        item:  #Stack & { id: $i, place: #Inside | #OnTile | #Held & { by: $a } }
    }
    moves: [{ moved: $i, portion: $n, into: #Held & { by: $a } }]
} @family(operations) @quickcheck(actor.freeHands)

// Put something the actor holds into a container: its own, or nobody's,
// it is the container's owners' from then on (what is brought home is the
// household's; what is paid is the seller's).
put_in: #Operation & {
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Body & { id: $i, place: #Held & { by: $a } }
        destination: #Container & { id: $c }
    }
    moves: [{ moved: $i, into: #Inside & { container: $c }, passes: true }]
} @family(operations)

// Take something up, carefully: a second, then into a free hand. Two who
// start together finish together, and only one gets it. Taken from where it
// was meanwhile, the take fails: there is nothing to come back to.
take_up: #Taking & {
    contest:  "quickness"
    duration: 1s
    uses:     ["hands"]
    hard:     "fail"
    roles: {
        actor: #Agent & { id: $a, freeHands: >=1 }
        item:  #Body & { id: $i, place: #OnTile | #Inside }
    }
    moves: [{ moved: $i, into: #Held & { by: $a } }]
} @family(operations)

// Put something the actor holds down on the ground at its feet.
put_down: #Operation & {
    roles: {
        actor: #Agent & { id: $a, place: $p & #OnTile }
        item:  #Body & { id: $i, place: #Held & { by: $a } }
    }
    moves: [{ moved: $i, into: $p }]
} @family(operations)

// Give something the actor holds to someone in reach, into a free hand. It
// is theirs from then on, if it was the actor's to give. What was lent is
// given back so: nothing passes, and its owner has it again.
give: #Operation & {
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Body & { id: $i, place: #Held & { by: $a } }
        destination: #Agent & { id: $d, freeHands: >=1 }
    }
    moves: [{ moved: $i, into: #Held & { by: $d }, passes: true }]
} @family(operations)

// Lend something the actor holds to someone in reach, into a free hand: it
// stays the actor's own, in the other's keeping (deals/'s loan of the very
// thing), for the loan's term: so many milliseconds, the command's.
lend: #Operation & {
    parameter: $t & >=1
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Body & { id: $i, place: #Held & { by: $a } }
        destination: #Agent & { id: $d, freeHands: >=1 }
    }
    now:   $now
    moves: [#Moves & { moved: $i, into: #Held & { by: $d }, lends: true, until: $now + $t * 1ms }]
} @family(operations)

// Look into a container: what is inside is perceived only by looking.
look_in: #Looking & { roles: { item: #Container } } @family(operations)

// Walking, a second a tile. A walk of one tile names its direction in the
// operation's name; the walker arrives when it is done. What the actor
// holds goes along: it is held by the actor, wherever the actor is.
#Walk: #Operation & {
    effect:   "walk"
    duration: 1s
    uses:     ["legs"]
    roles:    { actor: #Agent & { place: #OnTile } }
}

walk_north: #Walk @family(operations)
walk_south: #Walk @family(operations)
walk_east:  #Walk @family(operations)
walk_west:  #Walk @family(operations)

// A walk (PERFORMANCE.md decision 1): going to a place as one activity,
// its way found when it starts, a stage a tile, each a walk of a second in
// the way's direction. The tiles between are steps along the way, not
// history: where it set out for, its way, its arrival and how it ended are. A stage ending isn't a decision point; the walk
// ending is: arrived, blocked (a tile on the way turns out solid, and the
// stage fails), or given up. Nothing to resume: put down, it is given up.
// Not one of the menu's operations: it needs a way, which its walker finds.
walk: #Walk & { hard: "fail", diagnosticStages: true }
