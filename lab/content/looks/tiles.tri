tiles_tree:      #Glyph & { theme: "tiles", look: "tree", char: "♣", ink: [70, 140, 60] } @family(glyphs)
tiles_log:       #Glyph & { theme: "tiles", look: "log", char: "-", ink: [170, 120, 70] } @family(glyphs)
tiles_trunk:     #Glyph & { theme: "tiles", look: "log.trunk", char: "=", ink: [150, 100, 60] } @family(glyphs)
