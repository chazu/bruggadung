// Hunger, eating: wanting to eat, the ways to, the eat operation, and food
// (AGENCY.md §6, Scenario 2, decision 16).
//
// Cut points:
// - full:     felt hunger above 40 raises eating something, worth more the
//             hungrier; the agent eats a meal it holds (food not raw).
//             The other ways to food are cooking's (cooking/cooking.tri).
// - reduced:  the same, decided on the cadence's beat; eating runs at full
//             pace.
// - abstract: as reduced. How hunger and food work below reduced is open
//             (DETAIL_REGIMES.md).
// - frozen:   it doesn't decide, so it doesn't eat; an eat under way waits.
// - body:     eating nourishes the eater by the food's `nourishment`: the
//             body's code raises its satiety (body.tri). Eating knows nothing
//             of how the body keeps it, and the body nothing of food.
// - cooking: food raw or not, and what cooking adds, are cooking's
//             fields on #Food (cooking/cooking.tri), as are the ways from a
//             larder to a meal.
// - perishing: how long food keeps, and when it spoils, are perishing's
//             fields on #Food (perishing/). Spoiled, it isn't food, and is
//             made of rot: `eat` takes only what is made of food.
// - code:     effect_eat (src/act_actions.odin) destroys the food (one of a
//             stack held, the rest still in hand) and asks the body to be
//             nourished (bodies_nourish, domains_bodies.odin).
// - deals:    what is wanted, asked for, is valued as food, whatever it is
//             made of (`food_kind_value`; deals/).

package hunger

// Hunger raises eating, worth what the agent feels of it.
eat_when_hungry: #Goal & {
    title:   "eat something"
    done:    #Did & { did: "eat" }
    pressed: { need: "hunger", above: 40 }
    worth:   [#Need & { pressure: "hunger", per: 5 }]
} @family(goals)

eat_what_i_have: #Method & {
    title: "eat what I have"
    goal:  "eat_when_hungry"
    rank:  1
    pre: {
        find:  ["food"]
        match: #Supper & {
            me:   #Agent & { id: $me }
            food: #Food & #Body & { material: "food", raw: false, place: #Held & { by: $me } }
        }
    }
    steps: [#Do & { op: "eat", object: "food" }]
} @family(methods)

// AGENCY.md Scenario 2, "the false alarm": the watchman's supper.
// Eating: the food.
#Supper: #Frame & { food: #Body }

eat_supper: #Goal & {
    title: "eat supper"
    done:  #Did & { did: "eat" }
    worth: [#Flat & { value: 20 }]
} @family(goals)

eat_it: #Method & {
    title: "eat"
    goal:  "eat_supper"
    rank:  1
    pre: {
        find:  ["food"]
        match: #Supper & {
            me:   #Agent & { id: $me }
            food: #Food & #Body & { material: "food", raw: false, place: #Held & { by: $me } }
        }
    }
    steps: [#Do & { op: "eat", object: "food" }]
} @family(methods)

supper: #Body & #Food & { material: "food", mass: 300g, nourishment: 50 }

// Food: what eating it gives the stomach, in points of satiety (body.tri).
// Something eaten with none nourishes nothing.
#Food: {
    @component(Food)
    nourishment: *30 | int & >=0 & <=100 @field(content, saved, proposable, inspect)
}

food_seen: #Seen & { kindOf: "#Food" } @family(seen)

// Eat what the actor holds: a while, with the hands, easily put down. It
// is gone, and the actor is fed.
eat: #Operation & {
    effect:    "eat"
    duration:  60s
    uses:      ["hands"]
    attention: 5
    roles: {
        actor: #Agent & { id: $a }
        item:  #Body & { material: "food", place: #Held & { by: $a } }
    }
} @family(operations)

food_value:      #Valuing & { valued: #Body & { material: "food" }, value: 10, pressure: "hunger", per: 5 } @family(values)
// Food asked for by what a way to a meal wants (deals/): anything that is
// food, whatever it is made of, worth the same.
food_kind_value: #Valuing & { valued: #Food & #Body, value: 10, pressure: "hunger", per: 5 } @family(values)
