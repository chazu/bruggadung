// Goals and methods (AGENCY.md §4, §5): what an agent can want, and the ways
// it knows to get it. Agency reads them against the agent's knowledge view
// only: every slot is bound to a referent the agent believes present, and
// every condition is matched against the descriptions it last perceived.

// What a goal and its methods are about: the agent itself, as `me`, and
// slots for the things involved, each bound to a referent. A goal's frame is
// the type of its `done` pattern. A slot that a goal and its subgoal share is
// declared once, on a type both frames inherit, and its binding passes
// between them.
#Frame: { me: #Agent }

#WithNails: #Frame & { nails: #Stack }

// Wedging a lock: the lock, and the nail driven into it as a wedge.
#Wedging: #WithNails & { lock: #Assembly, wedge: #Body }

// Having nails: the nails, the containers to look in for them, and someone
// to ask.
#HavingNails: #WithNails & { box: #Container, someone: #Agent }

// Delivering: the goods, and where they are to go.
#Delivering: #Frame & { goods: #Body, dest: #Container }

// Tidying: what to put away, and the bin to put it in.
#Tidying:  #Frame & { stuff: #Body, bin: #Container }

// Getting money: the money, and a friend or someone to work for.
#Getting:  #Frame & { money: #Body, friend: #Agent, boss: #Agent }

// Eating: the food. Watching: the spot where something stirred.
#Supper:   #Frame & { food: #Body }
#Watching: #Frame & { spot: #Container }

// A condition over the knowledge view: `find` names the slots to bind, in
// order, to referents believed present (slots already bound keep their
// referent); it holds when the frame's description, with those referents
// in its slots, is entailed by `match`. Unknown never holds.
#Condition: { find: [...text], match: #Frame }

#Intent: { title: text }

// What a goal is worth (AGENCY.md §3): its considerations, added, in the
// units of credence (dB).
#Consideration: {}
// a fixed worth: a duty, a meal
#Flat:      #Consideration & { value: int }
// one that scales something of the agent's: `per` tenths of a point for
// each point of it
#Scaled:    #Consideration & { per: int }
// a cost, the believed risk
#Cost:      #Consideration & { cost: int }
// how strongly the agent believes something like `suspect` is in the slot's
// referent: the credence of what it was told, with its findings of
// `evidence` about the place as a group of their own (KNOWLEDGE.md §11)
#Suspicion: #Consideration & { suspect: #Body, inside: text, evidence: text }

// What a need presses for (AGENCY.md §6): pressure over what the agent
// feels, `per` tenths of a point for each point of it.
#Need:      #Scaled & { pressure: text }

// When a need raises a goal (AGENCY.md §4's needs generator): while the
// agent feels it above `above`.
#Pressing: { need: text, above: int }

// Where a goal arises (AGENCY.md §4's reactive generator): a candidate for
// each finding of the kind about something of kind `of`, the slot bound to
// it, while the finding is salient: drawn no longer ago than `lapse`.
#Arising: { finding: text, slot: text, lapse: time, of: #Body }

// A goal is done when `done` holds. What it `concerns` is salient to an agent
// that holds it (AGENCY.md §10): something like one of them seen moved, or
// talked of, is worth remembering. A goal with `arises` is weighed against
// what the agent is doing whenever it arises.
#Goal: #Intent & { done: #Condition, concerns: [...#Body], worth: [...#Consideration], arises: #Arising,
                   pressed: #Pressing }

// Conditions of what the agent did, not of how things are: it has looked
// into the slot's referent since adopting the goal; an activity of the
// operation it started since has completed.
#Looked: #Condition & { looked: text }
#Did:    #Condition & { did: text }

// How a candidate's referents are ordered, for each slot as it is found:
// nearest first, most recently seen first, or the one the agent has most
// often chosen for the slot (its habit, AGENCY.md §8). Ties go to the lower
// referent.
#Order: "near" | "recent" | "habit"

// A method's steps, done in order and re-read at every decision: a subgoal
// whose goal is already done is passed over, and its bindings join the
// method's; the first operation is performed, after walking within reach of
// what it names. Slots name the step's roles. An operation can say something
// (talk.tri): after a question, the agent waits a while for the answer.
#MethodStep: {}
#Achieve:    #MethodStep & { subgoal: text }
#Do:         #MethodStep & { op: text, object: text, target: text, units: int, says: #Utterance }

// A way to achieve a goal. Its alternatives are tried by `rank`, lowest first,
// skipping those that have failed since the goal was adopted; the first whose
// `pre` holds is followed. A `search` slot is somewhere to look: a referent
// whose inside the agent has seen since the goal was adopted is passed over.
// An agent asked since the goal was adopted is passed over too. When no
// method's `pre` holds, the goal is impossible for now: it is dropped with
// the reason, and the method that needed it has failed.
#Method: #Intent & {
    goal:   text
    rank:   int
    pre:    #Condition
    order:  [...#Order]
    search: text
    steps:  [...#MethodStep]
    score:  [...#Consideration]
}

// A method's score (AGENCY.md §5): its considerations, added. Methods are
// tried best first, then by rank; one that scores below nothing is
// unthinkable, and not tried at all.
// what a disposition or a norm of the agent's adds: `per` tenths of a point
// for each point of it
#Trait:   #Scaled & { trait: text }
// a penalty if the agent believes someone, not itself, could see the slot's
// referent
#Watched: #Consideration & { watched: text, penalty: int }


// --- AGENCY.md Scenario 1, as "the missing nails" -----------------------------

wedge_lock: #Goal & {
    title:    "wedge the lock"
    concerns: [#Assembly, #Stack & { unit: "iron_nail" }]
    done: {
        find:  ["lock", "wedge"]
        match: #Wedging & {
            lock:  #Assembly & { id: $l }
            wedge: #Body & { place: #Installed & { assembly: $l, role: "wedge" } }
        }
    }
} @family(goals)

have_nails: #Goal & {
    title:    "have nails"
    concerns: [#Stack & { unit: "iron_nail" }]
    done: {
        find:  ["nails"]
        match: #HavingNails & {
            me:    #Agent & { id: $me }
            nails: #Stack & { unit: "iron_nail", place: #Held & { by: $me } }
        }
    }
} @family(goals)

// Nails in hand, then drive one into the lock.
drive_a_nail: #Method & {
    title: "drive a nail in"
    goal:  "wedge_lock"
    rank:  1
    pre:   { find: ["lock"], match: #Wedging & { lock: #Assembly } }
    order: ["near"]
    steps: [
        #Achieve & { subgoal: "have_nails" },
        #Do & { op: "drive", object: "nails", target: "lock" },
    ]
}  @family(methods)

// Take two from nails believed lying about or in a container, nearest first:
// two, so what is taken stays a stack, and drive splits one off.
fetch_nails: #Method & {
    title: "fetch nails"
    goal:  "have_nails"
    rank:  1
    pre: {
        find:  ["nails"]
        match: #HavingNails & { nails: #Stack & { unit: "iron_nail", place: #Inside | #OnTile } }
    }
    order: ["near"]
    steps: [#Do & { op: "take_some", object: "nails", units: 2 }]
} @family(methods)

// Look into the containers the agent knows of, the most recently seen first,
// then the nearest.
search_for_nails: #Method & {
    title:  "search for nails"
    goal:   "have_nails"
    rank:   2
    pre:    { find: ["box"], match: #HavingNails & { box: #Container } }
    order:  ["recent", "near"]
    search: "box"
    steps:  [#Do & { op: "look_in", object: "box" }]
} @family(methods)

// Ask someone the agent knows of where nails are, the nearest first. What
// they answer, the agent believes (KNOWLEDGE.md §10): told where nails are,
// fetching them holds again.
ask_for_nails: #Method & {
    title:  "ask where nails are"
    goal:   "have_nails"
    rank:   3
    pre:    { find: ["someone"], match: #HavingNails & { someone: #Agent } }
    order:  ["near"]
    search: "someone"
    steps:  [#Do & { op: "say", object: "someone", says: #WhereIs & { what: #Stack & { unit: "iron_nail" } } }]
} @family(methods)


// --- AGENCY.md Scenario 2, "the false alarm" ----------------------------------

eat_supper: #Goal & {
    title: "eat supper"
    done:  #Did & { did: "eat" }
    worth: [#Flat & { value: 20 }]
} @family(goals)

eat_it: #Method & {
    title: "eat"
    goal:  "eat_supper"
    rank:  1
    pre: {
        find:  ["food"]
        match: #Supper & {
            me:   #Agent & { id: $me }
            food: #Body & { material: "food", place: #Held & { by: $me } }
        }
    }
    steps: [#Do & { op: "eat", object: "food" }]
} @family(methods)

// Arises from a disturbance: worth how strongly the agent believes someone is
// there, its duty, and less the risk.
investigate: #Goal & {
    title:    "investigate the disturbance"
    done:     #Looked & { looked: "spot" }
    arises:   { finding: "#Disturbance", slot: "spot", lapse: 30s, of: #Container }
    concerns: [#Agent]
    worth: [
        #Suspicion & { suspect: #Agent, inside: "spot", evidence: "#Disturbance" },
        #Flat & { value: 20 },
        #Cost & { cost: 5 },
    ]
} @family(goals)

look_into_it: #Method & {
    title: "look into it"
    goal:  "investigate"
    rank:  1
    pre:   { find: ["spot"], match: #Watching & { spot: #Container } }
    steps: [#Do & { op: "look_in", object: "spot" }]
} @family(methods)


// --- AGENCY.md Scenario 3, "the tempting purse" -------------------------------

// A debt due: get money. A commitment, not a body's need.
get_money: #Goal & {
    title: "get money"
    done: {
        find:  ["money"]
        match: #Getting & {
            me:    #Agent & { id: $me }
            money: #Body & { material: "cloth", place: #Held & { by: $me } }
        }
    }
} @family(goals)

// Ask a friend to lend it: awkward, but no harm.
borrow_money: #Method & {
    title:  "borrow from a friend"
    goal:   "get_money"
    rank:   1
    pre:    { find: ["friend"], match: #Getting & { friend: #Agent } }
    order:  ["near"]
    search: "friend"
    steps:  [#Do & { op: "say", object: "friend", says: #Request & { what: #Body & { material: "cloth" } } }]
    score:  [#Flat & { value: 10 }]
} @family(methods)

// Take the purse: worth more than borrowing, to the dishonest, unwatched.
take_the_purse: #Method & {
    title: "take the purse"
    goal:  "get_money"
    rank:  1
    pre: {
        find:  ["money"]
        match: #Getting & { money: #Body & { material: "cloth", place: #OnTile | #Inside } }
    }
    order: ["near"]
    steps: [#Do & { op: "take", object: "money" }]
    score: [
        #Flat & { value: 30 },
        #Trait & { trait: "honesty", per: -5 },
        #Trait & { trait: "scruples", per: -10 },
        #Watched & { watched: "money", penalty: 40 },
    ]
} @family(methods)


// --- AGENCY.md §6, needs ------------------------------------------------------

// Hunger raises eating, worth what the agent feels of it.
eat_when_hungry: #Goal & {
    title:   "eat something"
    done:    #Did & { did: "eat" }
    pressed: { need: "hunger", above: 40 }
    worth:   [#Need & { pressure: "hunger", per: 5 }]
} @family(goals)

eat_what_i_have: #Method & {
    title: "eat what I have"
    goal:  "eat_when_hungry"
    rank:  1
    pre: {
        find:  ["food"]
        match: #Supper & {
            me:   #Agent & { id: $me }
            food: #Body & { material: "food", place: #Held & { by: $me } }
        }
    }
    steps: [#Do & { op: "eat", object: "food" }]
} @family(methods)


// --- AGENCY.md §8, habits -------------------------------------------------------

// Put away the nails in hand: done when both hands are free.
put_away: #Goal & {
    title: "put the nails away"
    done:  { find: [], match: #Tidying & { me: #Agent & { freeHands: 2 } } }
} @family(goals)

// Into a container: the habitual one, else the nearest.
put_them_in_a_box: #Method & {
    title: "put them in a box"
    goal:  "put_away"
    rank:  1
    pre: {
        find:  ["stuff", "bin"]
        match: #Tidying & {
            me:    #Agent & { id: $me }
            stuff: #Stack & { unit: "iron_nail", place: #Held & { by: $me } }
            bin:   #Container
        }
    }
    order: ["habit", "near"]
    steps: [#Do & { op: "put_in", object: "stuff", target: "bin" }]
} @family(methods)


// --- AGENCY.md §7, promises -----------------------------------------------------

// The goods in the destination: what a promise to put them there commits to.
deliver: #Goal & {
    title: "deliver it"
    done: {
        find:  ["goods", "dest"]
        match: #Delivering & {
            goods: #Body & { place: #Inside & { container: $c } }
            dest:  #Container & { id: $c }
        }
    }
} @family(goals)

hold_it: #Goal & {
    title: "hold it"
    done: {
        find:  ["goods"]
        match: #Delivering & {
            me:    #Agent & { id: $me }
            goods: #Body & { place: #Held & { by: $me } }
        }
    }
} @family(goals)

bring_it: #Method & {
    title: "bring it"
    goal:  "deliver"
    rank:  1
    pre:   { find: ["goods", "dest"], match: #Delivering & { dest: #Container } }
    steps: [
        #Achieve & { subgoal: "hold_it" },
        #Do & { op: "put_in", object: "goods", target: "dest" },
    ]
} @family(methods)

pick_it_up: #Method & {
    title: "pick it up"
    goal:  "hold_it"
    rank:  1
    pre:   { find: ["goods"], match: #Delivering & { goods: #Body & { place: #Inside | #OnTile } } }
    steps: [#Do & { op: "take", object: "goods" }]
} @family(methods)
