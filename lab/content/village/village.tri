// The village: its map, its four households, their homes and places of
// work (VILLAGE.md, slice 3).
//
// Cut points:
// - full:     everyone in the village is at full detail: the scenario sets
//             no anchor, so nobody falls below (VILLAGE.md decision 1).
// - reduced, abstract, frozen: nobody is, yet.
// - home:     beds and worksites are home/home.tri's kinds, and the
//             day's commitments its goals.
// - hunger:   the villagers get hungry (hunger/body.tri) and eat from
//             their larders (cooking/cooking.tri): a sack of grain each, a
//             farming household's last year's harvest, so a larder empties
//             as its household eats, until a harvest (farming/) fills the
//             farmers' again, a fortnight on, the hunters bring venison
//             home (hunting/), and each buys what it doesn't make.
// - farming:  the map's tilled ground is the two farming households'
//             plots, each household's block two of them, its scarecrow in
//             one; their seed is in their larders, and their work is to
//             tend their plots (farming/farming.tri). Where each plot lies
//             is the scenario's.
// - heat:     each house has a stove (heat/heat.tri), cold; the scenario
//             runs the atmosphere domain, which burns a lit stove's fuel.
// - firewood: each woodpile holds firewood (firewood/firewood.tri): the
//             woodcutters' a little, the others' what they had of them;
//             the woodcutters' wood of oaks and birches north of their
//             block, and an axe each by it, are the scenario's.
// - hunting:  the hunters (`stalking`, a hunter's skill) hunt the eastern
//             woods with bows, for their larder (hunting/hunting.tri); the
//             game there at the start, the herds' bounds and where they
//             come in, and a bow each, are the scenario's.
// - market:   each household has a coffer of coins by its larder, and a
//             stall with its board on the green (market/, money/coins.tri);
//             market days, who keeps the stall and who buys what, are the
//             scenario's.
// - terrain:  the map's kinds are terrain/terrain.tri's.
// - code:     src/scenario_village.odin: where everyone and everything
//             stands, the households' bonds and claims, the commitments,
//             and the checks.

package village

// The village (VILLAGE.md, "The village"): 160 by 100, the woods north and
// east, four houses on either side of the path east, a path north to the
// woods and south to the two farming households' plots.
village_map: #Map & {
    legend: [{ glyph: "#", terrain: "stone_wall" },
             { glyph: ".", terrain: "plank_floor" },
             { glyph: "+", terrain: "doorway" },
             { glyph: ",", terrain: "grass" },
             { glyph: "%", terrain: "tilled_soil" },
             { glyph: ";", terrain: "woodland" },
             { glyph: "=", terrain: "dirt_path" }]
    levels: [{ z: 0, rows: _ @embed(file="maps/village.0.map", type=text) }]
    fill:   "grass"
}

// A villager: a meal sees it through most of a morning (its stomach
// empties over 12 hours, so hunger presses again some 5 hours after a
// meal): breakfast, the meal it takes to work, supper.
let person = #Hungry & { material: "flesh", hands: 2, emptiesIn: 12h }

// The villagers, by their work.
farmer:     #Agent & person & { mass: 75kg, coat: "green", trade: "farmer" }
woodcutter: #Agent & person & { mass: 85kg, coat: "brown", trade: "woodcutter" }
hunter:     #Agent & person & { mass: 70kg, coat: "grey", trade: "hunter", stalking: 100 }

farmer_look:     #Look & { kindOf: "farmer", look: "agent.farmer" } @family(looks)
woodcutter_look: #Look & { kindOf: "woodcutter", look: "agent.woodcutter" } @family(looks)
hunter_look:     #Look & { kindOf: "hunter", look: "agent.hunter" } @family(looks)

// In each house: a bed for each of its people, a larder (stocked with a
// sack of grain, cooking/'s, or a farmer's harvest); by its door, a
// woodpile. (Its stove is
// heat/heat.tri's.)
bed:      #Bed & { material: "oak", mass: 40kg }
larder:   #Container & { material: "oak", mass: 30kg, capacity: 50 }
woodpile: #Container & { material: "oak", mass: 5kg, capacity: 100 }

// A farming household's grain at first: last year's harvest, two hundred
// portions, its own to eat and to sell (market/).
farm_grain: #Stack & #Food & { material: "food", raw: true, nourishment: 15, cooking: 35, unit: "grain", unitMass: 250g, count: 200 }

// The firewood on a woodpile at first: a household's a hundred pieces, the
// woodcutters' own twenty (firewood/firewood.tri).
household_firewood:   #Stack & { material: "oak", unit: "firewood", unitMass: 1kg, count: 100 }
woodcutters_firewood: #Stack & { material: "oak", unit: "firewood", unitMass: 1kg, count: 20 }

// The seed each farming household kept back (farming/farming.tri), in its
// larder: for the Ashes' two plots of grain, the Brooks' one of grain and
// one of turnips. Each of its farmers takes a plot's worth (300) at once,
// what is left over put back, so there is enough for all of them to sow
// at once: with less, one goes back and forth for seed the others hold.
ashes_seed:         #Stack & #Seed & { material: "food", unit: "seed grain", unitMass: 25g, count: 900, sows: "grain" }
brooks_seed:        #Stack & #Seed & { material: "food", unit: "seed grain", unitMass: 25g, count: 1200, sows: "grain" }
brooks_turnip_seed: #Stack & #Seed & { material: "food", unit: "turnip seed", unitMass: 5g, count: 1200, sows: "turnip" }

// Where each household works: a scarecrow in a plot, a chopping block at
// the woods' edge, a hunting blind in the east woods.
scarecrow:      #Worksite & { material: "oak", mass: 8kg }
chopping_block: #Worksite & { material: "oak", mass: 60kg }
hunting_blind:  #Worksite & { material: "oak", mass: 30kg }

larder_look:         #Look & { kindOf: "larder", look: "container.larder" } @family(looks)
woodpile_look:       #Look & { kindOf: "woodpile", look: "container.woodpile" } @family(looks)
scarecrow_look:      #Look & { kindOf: "scarecrow", look: "worksite.scarecrow" } @family(looks)
chopping_block_look: #Look & { kindOf: "chopping_block", look: "worksite.block" } @family(looks)
hunting_blind_look:  #Look & { kindOf: "hunting_blind", look: "worksite.blind" } @family(looks)
