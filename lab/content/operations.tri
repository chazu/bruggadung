// Operations (ACTIONS.md §1): patterns over the descriptions of the entities
// that fill their roles. An actor's menu lists each operation and binding
// whose match is not incompatible; unknown never excludes. Tags carry
// bindings between roles. `effect` names the code that builds the proposal
// group when the action is performed.

#Effect: "take" | "take_some" | "put_in" | "drive" | "open_tap"

// Which roles an operation has is its roles' type: a structure's type is the
// most general one with all its features.
#Roles:        { actor: #Agent }
#ItemRoles:    #Roles & { item: #Body }
#PlacingRoles: #ItemRoles & { destination: #Body }

#Operation: {
    roles:  #Roles
    effect: #Effect
}

// Pick something up into a free hand: from a container, the ground, or an
// assembly it is installed in.
take: #Operation & {
    effect: "take"
    roles: {
        actor: #Agent & { freeHands: >=1 }
        item:  #Body & { place: #Inside | #OnTile | #Installed }
    }
} @family(operations) @quickcheck(actor.freeHands)

// Take some units of a stack into a free hand: from a container, the ground,
// or the actor's other hand. How many is the command's.
take_some: #Operation & {
    effect: "take_some"
    roles: {
        actor: #Agent & { id: $a, freeHands: >=1 }
        item:  #Stack & { place: #Inside | #OnTile | #Held & { by: $a } }
    }
} @family(operations) @quickcheck(actor.freeHands)

// Put something the actor holds into a container.
put_in: #Operation & {
    effect: "put_in"
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Body & { place: #Held & { by: $a } }
        destination: #Container
    }
} @family(operations)

// Drive a held nail into an assembly, as a wedge: it bends and takes tool
// marks. From a stack, one nail is driven.
drive: #Operation & {
    effect: "drive"
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Body & { material: "iron", place: #Held & { by: $a } }
        destination: #Assembly
    }
} @family(operations)

// Open a tap the actor can reach.
open_tap: #Operation & {
    effect: "open_tap"
    roles: {
        actor: #Agent
        item:  #Tap & { open: false }
    }
} @family(operations)
