// Hunting, the hunter: a bow, stalking, the shot (VILLAGE.md decision 7,
// slice 7).
//
// Cut points:
// - full:     a hunter crouches, hiding (things.tri's `hiding`: seen only
//             from beside it, in the woods; in the open, terrain/'s
//             exposed ground, as anyone is), and so stalks game it knows of to within
//             three tiles, and shoots. The shot strikes by a seeded draw:
//             the bow's `aim` from beside, less its `spread` for each tile
//             further, in the hunter's `stalking` (a hundredth of it each).
//             Struck, the animal takes a wound of the bow's `wounds`, gets
//             clear (harm/), and runs from the hunter, whom the shot,
//             struck or missed, gives away (animals.tri); it crouches
//             again straight after.
// - reduced:  the same, decided on the cadence's beat; a shot is instant.
// - abstract: as reduced. Game taken as a yield of the woods, below
//             reduced, is open (VILLAGE.md decision 3).
// - frozen:   it doesn't decide; what is under way waits.
// - harm:     the wound is an injury (harm/'s injure): at 100 the animal
//             dies, its carcass where it fell (butchering.tri).
// - carrying: a hunter with the household's backpack butchers into it,
//             picks up the hide, and carries both home, its bow in hand;
//             without one, the meat in its free hand, the hide left lying.
// - agency:   the hunt is one whole way, what it needs each a subgoal (meat
//             in hand, game down, a bow in hand, hidden, watched;
//             METHODS.md), the nearest carcass bound by game down.
// - market:   a hunter that put its bow down (both hands wanted, to buy:
//             market/) takes it up again to hunt: a bow in hand is a
//             subgoal of stalking and of looking for game, passed over
//             while one is held.
// - code:     effect_shoot (src/act_actions.odin; crouching is
//             declared); an operation's `range` (actions.tri), which
//             agency walks to within and no further.

package hunting

// A hunter's skill: as a rule's, how keenly it reads game in sight; and
// how surely it shoots, a hundredth of the bow's aim each (a non-hunter's
// is 0: it never strikes).
#Agent: {
    stalking: *0 | int & >=0 & <=100 @field(content, saved, inspect)
}

// The tests' hunter (src/test_hunting.odin), who needn't eat.
huntsman: #Agent & { material: "flesh", mass: 70kg, hands: 2, coat: "grey", trade: "hunter", stalking: 100 }

// A bow: what a shot from it wounds; the chance in a hundred that a shot
// from beside strikes, in a master's hands (`aim`), and how much less for
// each tile further (`spread`).
#Bow: #Body & {
    @component(Bow)
    wounds: *40 | int & >=1 & <=100 @field(content, saved, inspect)
    aim:    *80 | int & >=0 & <=100 @field(content, saved, inspect)
    spread: *25 | int & >=0 & <=100 @field(content, saved, inspect)
}

bow_seen: #Seen & { kindOf: "#Bow" } @family(seen)
bow_look: #Look & { kindOf: "#Bow", look: "tool.bow" } @family(looks)

bow: #Bow & { material: "oak", mass: 1kg }

// The tests' bow that never misses.
sure_bow: #Bow & { material: "oak", mass: 1kg, aim: 100, spread: 0 }

// Crouch, bow in hand, to stalk: from now on, hiding, until a shot gives it
// away. A second.
crouch: #Operation & {
    duration: 1s
    roles: {
        actor: #Agent & { id: $a, place: #OnTile }
        item:  #Bow & { place: #Held & { by: $a } }
    }
    after: { actor: #Agent & { hiding: true } }
} @family(operations)

// Shoot game within three tiles, the bow in hand: two seconds, with the
// hands.
shoot: #Operation & {
    effect:   "shoot"
    duration: 2s
    range:    3
    uses:     ["hands"]
    roles: {
        actor:       #Agent & { id: $a, place: #OnTile }
        item:        #Bow & { place: #Held & { by: $a } }
        destination: #Animal
    }
} @family(operations)

// Hunting: the game, its carcass, the meat from it, the bow, the larder
// the meat goes to; and its hide (`pelt`: a carcass's `hide` is a
// blueprint's name), and the pack it is carried home in (carrying/).
#Hunting: #Frame & { game: #Animal, carcass: #Carcass, meat: #Body, bow: #Body, larder: #Body, pelt: #Body, pack: #Body }

// The day's work, for a hunter: its household's larder stocked with meat,
// kept through its working hours (bound when undertaken: the larder). Done
// past twenty kilograms of venison, forty cuts, a deer: what the household
// eats and sells (the market, VILLAGE.md slice 9) before it spoils, three
// days on (perishing/: a stack spoils whole, so a bigger stock spoils with
// more in it, and none is left). A stack is seen by its mass, its count
// unseen.
game_hunted: #Goal & {
    title: "hunt"
    done: {
        find:  ["larder", "meat"]
        match: #Hunting & { larder: #Container & { id: $l },
                            meat: #Food & #Stack & { unit: "venison", mass: >=20kg, place: #Inside & { container: $l } } }
    }
    kept: true
} @family(goals)

// The ways (METHODS.md: whole ways, what each needs a subgoal): meat in
// hand, home with it, to the larder; a hide in hand too; a hide in its pack,
// by the larder, taken out; else the hunt is one way, meat got into hand,
// then put in. Meat is got into hand: out of its pack, by the larder;
// butchered from game down; the hide picked up into the pack (butchering
// done, before it goes); the pack carried home and unpacked; else game
// brought down and butchered. Game is brought down by stalking it and
// shooting, or looked for in the woods.
bring_home_the_meat: #Method & {
    title: "bring home the meat"
    goal:  "game_hunted"
    rank:  1
    pre: {
        find:  ["meat", "larder"]
        match: #Hunting & { me: #Agent & { id: $me },
                            meat: #Food & #Stack & { raw: true, place: #Held & { by: $me } },
                            larder: #Container }
    }
    order: ["own", "habit", "near"]
    steps: [#Do & { op: "put_in", object: "meat", target: "larder" }]
} @family(methods)

// A hide in hand: into the larder too, to be dressed or sold.
bring_home_the_hide: #Method & {
    title: "bring home the hide"
    goal:  "game_hunted"
    rank:  2
    pre: {
        find:  ["pelt", "larder"]
        match: #Hunting & { me: #Agent & { id: $me }, pelt: #Hide & { place: #Held & { by: $me } }, larder: #Container }
    }
    steps: [#Do & { op: "put_in", object: "pelt", target: "larder" }]
} @family(methods)

// Home with a hide in its pack (carrying/): taken out, by the larder.
unpack_the_hide: #Method & {
    title: "unpack the hide"
    goal:  "game_hunted"
    rank:  3
    pre:   #Reached & {
        reached: "larder"
        find:    ["pack", "pelt"]
        match:   #Hunting & { me: #Agent & { id: $me, freeHands: >=1 }, pack: #Pack & { id: $p, place: #Held & { by: $me } },
                              pelt: #Hide & { place: #Inside & { container: $p } } }
    }
    steps: [#Do & { op: "take", object: "pelt" }]
} @family(methods)

hunt_and_bring: #Method & {
    title: "hunt"
    goal:  "game_hunted"
    rank:  4
    pre:   { find: [], match: #Hunting }
    steps: [#Achieve & { subgoal: "meat_from_the_hunt" }, #Do & { op: "put_in", object: "meat", target: "larder" }]
} @family(methods)

meat_from_the_hunt: #Goal & {
    title: "meat in hand"
    done: {
        find:  ["meat"]
        match: #Hunting & { me: #Agent & { id: $me }, meat: #Food & #Stack & { raw: true, place: #Held & { by: $me } } }
    }
} @family(goals)

// Meat in its pack: taken in hand by the larder (carrying/'s ways, the
// meat as the thing, the larder where it goes); first, home already.
let out_of_the_pack = {
    goal:  "meat_from_the_hunt"
    steps: [#Achieve & { subgoal: "thing_in_hand", with: [{ binds: "thing", to: "meat" }, { binds: "into", to: "larder" }] }]
}
let meat_packed = #Hunting & { me: #Agent & { id: $me }, pack: #Pack & { id: $p, place: #Held & { by: $me } },
                               meat: #Food & #Stack & { place: #Inside & { container: $p } } }
unpack_the_meat: #Method & out_of_the_pack & {
    title: "unpack it"
    rank:  1
    pre:   #Reached & { reached: "larder", find: ["pack", "meat"], match: meat_packed }
} @family(methods)

// Game down: butcher it where it lies (into its pack, if it has one).
butcher_it: #Method & {
    title: "butcher it"
    goal:  "meat_from_the_hunt"
    rank:  2
    pre:   { find: ["carcass"], match: #Hunting & { me: #Agent & { freeHands: >=1 }, carcass: #Carcass } }
    order: ["near"]
    steps: [#Do & { op: "butcher", object: "carcass" }]
} @family(methods)

// Butchered, with a pack on the back: its hide picked up into the pack
// before it goes home (the butchering's end, not a way to meat).
pick_up_the_hide: #Method & {
    title: "pick up the hide"
    goal:  "meat_from_the_hunt"
    rank:  3
    pre: {
        find:  ["pack", "pelt"]
        match: #Hunting & { me: #Agent & { id: $me, freeHands: >=1 }, pack: #Pack & { worn: true, place: #Held & { by: $me } },
                            pelt: #Hide & { place: #OnTile } }
    }
    order: ["near"]
    steps: [#Do & { op: "pick_up", object: "pelt" }]
} @family(methods)

carry_it_home: #Method & out_of_the_pack & {
    title: "carry it home"
    rank:  4
    pre:   { find: ["pack", "meat"], match: meat_packed }
} @family(methods)

shoot_and_butcher: #Method & {
    title: "bring down game and butcher it"
    goal:  "meat_from_the_hunt"
    rank:  5
    pre:   { find: [], match: #Hunting }
    steps: [#Achieve & { subgoal: "game_down" }, #Do & { op: "butcher", object: "carcass" }]
} @family(methods)

// Game down: a carcass lying about, the nearest.
game_down: #Goal & {
    title: "bring down game"
    done:  { find: ["carcass"], match: #Hunting & { carcass: #Carcass } }
    order: ["near"]
} @family(goals)

// Game seen: stalk it, crouched, shoot, and crouch again.
shoot_it: #Method & {
    title: "stalk and shoot"
    goal:  "game_down"
    rank:  1
    pre: {
        find:  ["game"]
        match: #Hunting & { game: #Animal }
    }
    order: ["near"]
    steps: [#Achieve & { subgoal: "bow_in_hand" }, #Achieve & { subgoal: "hidden" },
            #Do & { op: "shoot", object: "bow", target: "game" }, #Do & { op: "crouch", object: "bow" }]
} @family(methods)

// None seen: through the woods, bow in hand, crouched (to see game before
// it sees the hunter), lying in wait a while, then on a way, and in wait
// again.
look_for_game: #Method & {
    title: "look for game"
    goal:  "game_down"
    rank:  2
    pre:   { find: [], match: #Hunting & {} }
    steps: [#Achieve & { subgoal: "bow_in_hand" }, #Achieve & { subgoal: "hidden" }, #Achieve & { subgoal: "watched" },
            #Wander & { radius: 12, over: "woodland" }]
} @family(methods)

// A bow in hand, to hunt with: a subgoal, so passed over while one is held
// (a way of the hunt's own, taken whenever nothing better would do, had a
// hunter with its bow in hand take up another's). Put down at home, to buy
// at the market, it is taken up again.
bow_in_hand: #Goal & {
    title: "take up a bow"
    done: {
        find:  ["bow"]
        match: #Hunting & { me: #Agent & { id: $me }, bow: #Bow & { place: #Held & { by: $me } } }
    }
} @family(goals)

take_up_the_bow: #Method & {
    title: "take up the bow"
    goal:  "bow_in_hand"
    rank:  1
    pre:   { find: ["bow"], match: #Hunting & { me: #Agent & { freeHands: >=1 }, bow: #Bow & { place: #OnTile | #Inside } } }
    order: ["near"]
    steps: [#Do & { op: "take", object: "bow" }]
} @family(methods)

// Lain in wait lately: the last wait just ended (five seconds since), so
// one way is walked, and no more.
watched: #Goal & {
    title: "lie in wait"
    done:  #Did & { did: "lie_in_wait", lately: 905s }
} @family(goals)

lie_low: #Method & {
    title: "lie low"
    goal:  "watched"
    rank:  1
    pre:   { find: ["bow"], match: #Hunting & { me: #Agent & { id: $me }, bow: #Bow & { place: #Held & { by: $me } } } }
    steps: [#Do & { op: "lie_in_wait", object: "bow" }]
} @family(methods)

// Lie in wait, bow in hand, crouched: a quarter of an hour, watching. Game
// coming into sight is taken a shot at (take_the_shot), whatever else.
lie_in_wait: #Resting & {
    duration: 15min
    roles: {
        actor: #Agent & { id: $a, place: #OnTile }
        item:  #Bow & { place: #Held & { by: $a } }
    }
} @family(operations)

// Game in sight, to a hunter: a shot to take.
#Game: #Finding & {}

game_in_sight: #Rule & {
    premises:  [#Sighted & { sighted: "#Deer" }]
    skill:     "stalking"
    mastery:   1
    concludes: "#Game"
    weight:    20
} @family(rules)

hare_in_sight: #Rule & {
    premises:  [#Sighted & { sighted: "#Hare" }]
    skill:     "stalking"
    mastery:   1
    concludes: "#Game"
    weight:    20
} @family(rules)

// Game seen, the hunter at work or lying in wait: the shot, from cover.
take_the_shot: #Goal & {
    title:  "take the shot"
    done:   #Did & { did: "shoot" }
    arises: { finding: "#Game", slot: "game", lapse: 10min, of: #Animal }
    worth:  [#Flat & { value: 60 }]
} @family(goals)

shoot_from_cover: #Method & {
    title: "shoot from cover"
    goal:  "take_the_shot"
    rank:  1
    pre: {
        find:  ["bow", "game"]
        match: #Hunting & { me: #Agent & { id: $me }, bow: #Bow & { place: #Held & { by: $me } }, game: #Animal }
    }
    steps: [#Achieve & { subgoal: "hidden" }, #Do & { op: "shoot", object: "bow", target: "game" },
            #Do & { op: "crouch", object: "bow" }]
} @family(methods)

// Hidden, to stalk: crouched lately (a shot gives it away, and it
// crouches again straight after; else once twenty minutes have passed).
hidden: #Goal & {
    title: "keep hidden"
    done:  #Did & { did: "crouch", lately: 20min }
} @family(goals)

crouch_down: #Method & {
    title: "crouch"
    goal:  "hidden"
    rank:  1
    pre:   { find: ["bow"], match: #Hunting & { me: #Agent & { id: $me }, bow: #Bow & { place: #Held & { by: $me } } } }
    steps: [#Do & { op: "crouch", object: "bow" }]
} @family(methods)
