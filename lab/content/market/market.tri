// After the market: the coins home to the coffer. A buyer puts away what
// it holds; a seller takes its stall's takings (its own: the stall bound
// when it undertook it, never another's), then puts them away. One way:
// the coins, wherever they are now (in the stall, in hand, in its pack),
// taken in hand by the coffer (carrying/'s ways), then put away. Found
// impossible (the takings it knew of gone into another stack, the stall
// not yet looked in), it is tried again five minutes on, while its window
// is open. A buyer's is done with no coins left in its hands, nor a pouch
// at its belt (#None): each stack it holds is put away, the pouch put back
// in the coffer with what is in it, and one who took none has nothing to
// do.
coins_home: #Goal & {
    title:   "take the coins home"
    retry:   5min
    done:    #None & {
        find:  ["purse"]
        match: #Market & { me: #Agent & { id: $me }, purse: #Stack & { unit: "coin", place: #Held & { by: $me, hand: <8 } } } |
            #Market & { me: #Agent & { id: $me }, purse: #Pouch & { place: #Held & { by: $me, hand: 9 } } }
    }
    urgency: [{ input: 0, output: 35 }]
} @family(goals)

takings_home: #Goal & {
    title:   "take the takings home"
    retry:   5min
    done:    #Did & { did: "put_away_coins" }
    urgency: [{ input: 0, output: 35 }]
} @family(goals)

// The purse (coins), wherever it is now: in hand, in its pack, in the
// stall; taken in hand by the coffer, as the thing, then put away.
let coins = #Stack & { unit: "coin" }
let put_away = {
    title: "put the coins away"
    steps: [#Achieve & { subgoal: "thing_in_hand", with: [{ binds: "thing", to: "purse" }, { binds: "into", to: "coffer" }] },
            #Do & { op: "put_away_coins", object: "purse", target: "coffer" }]
}
let coins_in_hand = { find: ["purse"], match: #Market & { me: #Agent & { id: $me }, purse: coins & { place: #Held & { by: $me, hand: <8 } } } }
let coins_packed = {
    find:  ["pack", "purse"]
    match: #Market & { me: #Agent & { id: $me }, pack: #Pack & { id: $p, place: #Held & { by: $me } },
                       purse: coins & { place: #Inside & { container: $p } } }
}
put_coins_away:     #Method & put_away & { goal: "coins_home", rank: 1, pre: coins_in_hand } @family(methods)
unpack_coins:       #Method & put_away & { goal: "coins_home", rank: 2, pre: coins_packed } @family(methods)
put_the_pouch_away: #Method & {
    title: "put the pouch away"
    goal:  "coins_home"
    rank:  3
    pre:   { find: ["purse"], match: #Market & { me: #Agent & { id: $me }, purse: #Pouch & { place: #Held & { by: $me, hand: 9 } } } }
    steps: [#Do & { op: "put_in", object: "purse", target: "coffer" }]
} @family(methods)
put_takings_away:   #Method & put_away & { goal: "takings_home", rank: 1, pre: coins_in_hand } @family(methods)
unpack_takings:     #Method & put_away & { goal: "takings_home", rank: 2, pre: coins_packed } @family(methods)
collect_takings:    #Method & put_away & {
    goal: "takings_home"
    rank: 3
    pre:  { find: ["stall", "purse"], match: #Market & { stall: #Stall & { id: $s }, purse: coins & { place: #Inside & { container: $s } } } }
} @family(methods)

// Not known to be there (what is paid in is split into the stall, unseen
// by its seller): a look in it.
look_in_the_stall: #Method & {
    title:  "look in the stall"
    goal:   "takings_home"
    rank:   4
    pre:    { find: ["stall"], match: #Market & { stall: #Stall } }
    search: "stall"
    steps:  [#Do & { op: "look_in", object: "stall" }]
} @family(methods)

// After the market, the seller's: what didn't sell taken home from the
// stall, into its pack if it carries one, and put back where it came from.
// One way, wherever the goods are now (on the stall, in its pack, in hand):
// taken in hand by the supply (carrying/'s ways), then put in.
unsold_home: #Goal & {
    title:   "take the unsold goods home"
    done:    #Did & { did: "put_in" }
    urgency: [{ input: 0, output: 35 }]
} @family(goals)

let bring_home = {
    title: "bring it home"
    goal:  "unsold_home"
    steps: [#Achieve & { subgoal: "thing_in_hand", with: [{ binds: "thing", to: "goods" }, { binds: "into", to: "supply" }] },
            #Do & { op: "put_in", object: "goods", target: "supply" }]
}
unsold_in_hand:      #Method & bring_home & {
    rank: 1
    pre:  { find: ["goods"], match: #Market & { me: #Agent & { id: $me }, goods: goods & { place: #Held & { by: $me, hand: <8 } } } }
} @family(methods)
unsold_packed:       #Method & bring_home & {
    rank: 2
    pre: {
        find:  ["pack", "goods"]
        match: #Market & { me: #Agent & { id: $me }, pack: #Pack & { id: $p, place: #Held & { by: $me } },
                           goods: goods & { place: #Inside & { container: $p } } }
    }
} @family(methods)
unsold_on_the_stall: #Method & bring_home & {
    rank: 3
    pre:  { find: ["stall", "goods"], match: #Market & { stall: #Stall & { id: $s }, goods: goods & { place: #Inside & { container: $s } } } }
} @family(methods)

// Pocket coins: a stack in a container in reach, or on the ground, put
// straight into a pouch at the actor's belt, with a free hand.
pocket: #Operation & {
    uses: ["hands"]
    roles: {
        actor:       #Agent & { id: $a, freeHands: >=1 }
        item:        #Stack & { id: $i, unit: "coin", place: #Inside | #OnTile }
        destination: #Pouch & { id: $q, place: #Held & { by: $a } }
    }
    moves: [{ moved: $i, into: #Inside & { container: $q } }]
} @family(operations)

put_away_coins: #Operation & {
    uses: ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Stack & { id: $i, unit: "coin", place: #Held & { by: $a } }
        destination: #Container & { id: $c }
    }
    moves: [{ moved: $i, into: #Inside & { container: $c }, passes: true }]
} @family(operations)
