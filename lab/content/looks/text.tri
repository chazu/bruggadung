// Looks, the text theme: `lab play`'s map, a character to a tile (see
// looks.tri for the cut points).

package looks

text_wall:        #Glyph & { theme: "text", look: "wall", char: "#" } @family(glyphs)
text_floor:       #Glyph & { theme: "text", look: "floor", char: "." } @family(glyphs)
text_doorway:     #Glyph & { theme: "text", look: "doorway", char: "." } @family(glyphs)
text_air:         #Glyph & { theme: "text", look: "air", char: "." } @family(glyphs)
text_ground:      #Glyph & { theme: "text", look: "ground", char: "." } @family(glyphs)
text_water:       #Glyph & { theme: "text", look: "water", char: "~" } @family(glyphs)
text_thing:       #Glyph & { theme: "text", look: "thing", char: "o" } @family(glyphs)
text_body:        #Glyph & { theme: "text", look: "body", char: "o" } @family(glyphs)
text_agent:       #Glyph & { theme: "text", look: "agent", char: "A" } @family(glyphs)
text_deer:        #Glyph & { theme: "text", look: "animal.deer", char: "d" } @family(glyphs)
text_hare:        #Glyph & { theme: "text", look: "animal.hare", char: "h" } @family(glyphs)
text_carcass:     #Glyph & { theme: "text", look: "carcass", char: "x" } @family(glyphs)
text_bow:         #Glyph & { theme: "text", look: "tool.bow", char: ")" } @family(glyphs)
text_assembly:    #Glyph & { theme: "text", look: "assembly", char: "m" } @family(glyphs)
text_container:   #Glyph & { theme: "text", look: "container", char: "u" } @family(glyphs)
text_tap:         #Glyph & { theme: "text", look: "tap", char: "u" } @family(glyphs)
text_stack:       #Glyph & { theme: "text", look: "stack", char: "*" } @family(glyphs)
text_water_store: #Glyph & { theme: "text", look: "water.store", char: "w" } @family(glyphs)
text_food:        #Glyph & { theme: "text", look: "food", char: "%" } @family(glyphs)
text_spoiled:     #Glyph & { theme: "text", look: "food.spoiled", char: "~" } @family(glyphs)
text_tree:        #Glyph & { theme: "text", look: "tree", char: "T" } @family(glyphs)
text_log:         #Glyph & { theme: "text", look: "log", char: "-" } @family(glyphs)
text_tool:        #Glyph & { theme: "text", look: "tool", char: "/" } @family(glyphs)
text_plot:        #Glyph & { theme: "text", look: "plot", char: "\"" } @family(glyphs)
