// The market: stalls on the green, posted prices, and the sale, a deal
// struck at a stall (VILLAGE.md decision 9, slice 9).
//
// Cut points:
// - full:     on market day (every fourth, the scenario's), a seller keeps
//             its household's stall: it sets out a lot of its goods (its
//             trade's: grain, venison, firewood; none that would leave
//             the household short of food, cooking/'s rationing; a bigger
//             lot of grain with plenty to spare) and posts its price on the stall's
//             board, as it sets them out, and afresh each market day (what it asks moves with its
//             stock: money/coins.tri), then stands by it. Whoever comes within
//             three tiles reads the price at a glance, and knows it. A
//             buyer stocks its household's larder (or woodpile) to a
//             level: it takes the household's coins from the coffer,
//             reads the stalls, and buys a lot at a time at the cheapest
//             price it knows that is no more than what it holds the goods
//             worth (money/coins.tri's #Pricing): one whole way, what it
//             needs each a subgoal (METHODS.md), worked out by the code as
//             a #Buying where it is a lot's. A sale is three acts:
//             the buyer asks (#Buy) the seller whose price it read, if it
//             sees it by the stall, and the seller hands the goods over from
//             its stall and says what is owed (#Sold), and the buyer pays
//             into the stall. Then the buyer takes the goods home. After
//             the market, each takes its coins home to the coffer, and the
//             seller what didn't sell. Seller and buyer each take the
//             household's backpack or basket, if it is there (carrying/):
//             what is handed over goes into it, and is taken out by the
//             supply, so a buyer buys what it lacks before walking home.
//             A buyer's coins go home till none are left in its hands,
//             through the afternoon if it is kept from it.
//             A buyer whose household has a pouch (leatherwork/) carries
//             its purse in it: it hangs the pouch at its belt, puts the
//             coffer's coins into it (`pocket`), and pays out of it, both
//             hands free; after the market the pouch goes back into the
//             coffer, what is left still in it, and is taken as it is
//             next market, more put in only when it won't pay for a lot.
//             A hunter sets out leather too (tanning/), beside its
//             venison: four pieces of hare leather, its price on a second
//             board at the stall; what doesn't sell stays on the stall
//             for the next market. Other households buy it, two pieces
//             each, to sew (leatherwork/).
// - reduced:  the same, decided on the cadence's beat.
// - abstract: as reduced. A market as a clearing of households' stocks,
//             below reduced, is open (DETAIL_REGIMES.md).
// - frozen:   it doesn't decide; nothing is bought.
// - money:    coins and pricing are money/'s (coins.tri).
// - talk:     a posted price is a record's writing (talk/'s #Label), a
//             #Priced claim, believed as any claim read is; #Buy is a
//             question, waited on as any is.
// - perishing: goods set out keep spoiling where they are.
// - things:   a sale passes ownership (actions.tri's `passes`): the goods
//             handed over are the buyer's, the coins paid in the stall's
//             owners', and coins put away the coffer's owners'.
// - carrying: what is paid is coins in hand, or carried (things.tri's
//             `carriedBy`: in a pouch at the belt, a pack); a pouch is
//             belted (carrying/'s `belt_on`).
// - leather:  what leather is, and what is made of it, are tanning/'s and
//             leatherwork/'s; a second kind of goods has its own board
//             (`sign`) and its own posting (`post_beside`), since a board
//             holds one price and a posting is done once a market.
// - code:     the #Purchase step and the #Buying condition (agency_lot,
//             agency_cheapest, agency_buying; the purse it counts and pays
//             from is the coins in hand or those in what hangs at its
//             belt, whichever are more: agency_purse), the seller's weighing of a #Buy
//             (src/agency_agency.odin); a #Priced claim known
//             (src/know_knowledge_1.odin); posting (any #Posting: the
//             price is written by src/agency_agency.odin), handing over and
//             paying are declared (actions.tri); market days, the
//             stalls and the coins (src/scenario_village.odin).

package market

// A stall: a table on the green that goods are set out on; and standing
// on it, its board (talk/'s #Label), whose writing anyone within three tiles
// reads at a glance.
#Stall: #Container & {}

stall_seen: #Seen & { kindOf: "#Stall" } @family(seen)
stall_look: #Look & { kindOf: "#Stall", look: "stall", prevails: 1 } @family(looks)

stall:       #Stall & { material: "oak", mass: 20kg, capacity: 8 }
price_board: #Label & { material: "oak", mass: 2kg, legible: 3 }
board_look:  #Look & { kindOf: "price_board", look: "board" } @family(looks)

// A second board, for a second kind of goods: of birch, to tell it from
// the first.
price_sign: #Label & { material: "birch", mass: 1kg, legible: 3 }
sign_look:  #Look & { kindOf: "price_sign", look: "board" } @family(looks)

// So many coins; and a lot: so many units, for so many coins.
#Costing: { coins: int & >=0 & <=100000 }
#Lot:     #Costing & { count: int & >=0 & <=100 }

// A posted price: someone like `holder` sells something like `what`, at
// `coins` a unit, at the stall at `site`.
#Priced: #Naming & #Costing & { site: #OnTile }

// Sell me `count` of something like `what`, at `coins` each? And the
// answer: here are `count` like `what`, `coins` owed for them all.
#Buy:  #Question & #Lot & {}
#Sold: #Utterance & #Lot & {}

// Buying a lot of something like `what` at the cheapest stall the agent
// knows to sell it, `units` of it at most, if the price is no more than its
// own (src/agency_agency.odin): no more than will bring the `stocking` slot's
// referent up to `level`, with what it has in hand or in its pack.
#Buys:     { what: #Body, units: int & >=1 & <=100, stocking: text, level: mass }
#Purchase: #MethodStep & #Buys & {}

// What buying a lot like a #Purchase needs, worked out by the code
// (src/agency_agency.odin, agency_holds) as the purchase works it out;
// `buying` says which (METHODS.md decision 3):
// - "coming": so much like `what` in the `stocking` slot's referent, in
//   hand and in its pack, as `level`: nothing left to buy; or a lot of it
//   in hand, as much as it carries home this time (its pack full, or none);
// - "priced": a price for the unit it read this market, its stall there;
// - "affords": its purse (the coins in hand, or in a pouch at its belt)
//   pays for the lot it lacks, at the cheapest of those prices (knowing
//   none yet, any coins); or it believes there are no more in the
//   `coinsIn` slot's referent, the coffer, nor in anything in it (it buys
//   what they pay for);
// Nothing left to buy, each holds.
#Buying: #Condition & #Buys & { buying: "coming" | "priced" | "affords", coinsIn: text }

// The goods a household sells, what its trade makes: food, or firewood.
// (A hunter's leather is set out beside its goods: `wares`, below.)
let goods = (#Food & #Stack) | #Stack & { unit: "firewood" }

// The market's frame: the household's stall and its board, the goods, its
// supply (where it keeps them: a larder, a woodpile), its coffer, a purse
// (coins carried), a pouch to carry them in (leatherwork/), and a pack it
// carries (carrying/); and, of a household
// that sells a second kind of goods beside the first (a hunter's leather),
// those (`wares`) and the board their price is posted on (`sign`). Its ways pass the
// goods or the purse as the thing to take in hand, and the supply or the
// coffer as where it goes, to carrying/'s ways.
#Market: #Frame & {
    stall:  #Stall
    board:  #Label
    goods:  #Body
    supply: #Body
    coffer: #Body
    purse:  #Body
    pouch:  #Body
    pack:   #Body
    sign:   #Label
    wares:  #Body
}

// Keeping the stall (the seller's, through the market's hours): goods set
// out, the price posted, and minding it ten minutes at a time, again and
// again (kept), answering whoever asks to buy. A duty that outweighs the
// day's work.
stall_kept: #Goal & {
    title:   "keep the stall"
    done:    #Did & { did: "mind_stall", lately: 10min }
    kept:    true
    urgency: [{ input: 0, output: 40 }]
} @family(goals)

// A hunter's, with a second board at its stall: leather set out beside
// the venison, at its own price. With no leather to set out, the plain way.
keep_the_stall_with_leather: #Method & {
    title:    "set out, leather too, and mind it"
    goal:     "stall_kept"
    ofTrade:  "hunter"
    rank:     1
    pre:      { find: ["stall", "sign"], match: #Market & { stall: #Stall, sign: #Label } }
    sequence: true
    steps:    [#Achieve & { subgoal: "goods_set_out" }, #Achieve & { subgoal: "price_posted" },
               #Achieve & { subgoal: "leather_out" }, #Achieve & { subgoal: "leather_price_posted" },
               #Do & { op: "mind_stall", object: "stall" }]
} @family(methods)

// Leather on the stall: four pieces of hare leather from where the
// household keeps it, of two or more, put out.
leather_out: #Goal & {
    title: "set out leather"
    done: {
        find:  ["stall", "wares"]
        match: #Market & { stall: #Stall & { id: $s }, wares: #Leather & { place: #Inside & { container: $s } } }
    }
} @family(goals)

set_out_leather: #Method & {
    title: "set leather out"
    goal:  "leather_out"
    rank:  1
    pre:   { find: ["stall"], match: #Market & { stall: #Stall } }
    steps: [#Achieve & { subgoal: "leather_to_sell" }, #Do & { op: "put_in", object: "wares", target: "stall" }]
} @family(methods)

// Leather to sell in hand.
leather_to_sell: #Goal & {
    title: "fetch leather to sell"
    done:  { find: ["wares"], match: #Market & { me: #Agent & { id: $me }, wares: #Leather & { place: #Held & { by: $me, hand: <8 } } } }
} @family(goals)

fetch_leather_too: #Method & {
    title:    "fetch leather to sell"
    goal:     "leather_to_sell"
    rank:     1
    sequence: true
    pre: {
        find:  ["supply", "wares"]
        match: #Market & { me: #Agent & { freeHands: >=1 }, supply: #Body & { id: $l },
                           wares: #Stack & { unit: "hare leather", mass: >=600g, place: #Inside & { container: $l } } }
    }
    steps: [#Do & { op: "take_some", object: "wares", units: 4 }]
} @family(methods)

// Its price on the second board, this market day.
leather_price_posted: #Goal & {
    title: "post the price of the leather"
    done:  #Did & { did: "post_beside", lately: 4h }
} @family(goals)

write_the_leather_price: #Method & {
    title: "write the price of the leather"
    goal:  "leather_price_posted"
    rank:  1
    pre: {
        find:  ["stall", "wares"]
        match: #Market & { stall: #Stall & { id: $s }, wares: #Leather & { place: #Inside & { container: $s } } }
    }
    steps: [#Do & { op: "post_beside", object: "sign", regarding: "wares" }]
} @family(methods)

keep_the_stall: #Method & {
    title:    "set out and mind it"
    goal:     "stall_kept"
    rank:     2
    pre:      { find: ["stall"], match: #Market & { stall: #Stall } }
    sequence: true
    steps:    [#Achieve & { subgoal: "goods_set_out" }, #Achieve & { subgoal: "price_posted" },
               #Do & { op: "mind_stall", object: "stall" }]
} @family(methods)

// Minding a stall within reach: ten minutes by it, the hands free to hand
// goods over.
mind_stall: #Resting & {
    duration: 10min
    roles: {
        actor: #Agent
        item:  #Stall
    }
} @family(operations)

// Goods on the stall: one way, goods to sell got in hand, then put out.
goods_set_out: #Goal & {
    title: "set out the goods"
    done: {
        find:  ["stall", "goods"]
        match: #Market & { stall: #Stall & { id: $s }, goods: goods & { place: #Inside & { container: $s } } }
    }
} @family(goals)

set_them_out: #Method & {
    title: "set them out"
    goal:  "goods_set_out"
    rank:  1
    pre:   { find: ["stall"], match: #Market & { stall: #Stall } }
    steps: [#Achieve & { subgoal: "goods_to_sell" }, #Do & { op: "put_in", object: "goods", target: "stall" }]
} @family(methods)

// Goods to sell in hand.
goods_to_sell: #Goal & {
    title: "fetch goods to sell"
    done:  { find: ["goods"], match: #Market & { me: #Agent & { id: $me }, goods: goods & { place: #Held & { by: $me, hand: <8 } } } }
} @family(goals)

// A lot of what its trade makes (a recipe of the trade, ACTIONS.md decision
// 12: known only to those of it), from where the household keeps it, so
// long as the household keeps enough back: fifteen kilograms of grain, a
// lot of twenty portions leaving it ten, not short (cooking/'s rationing);
// five of venison (a lot of ten cuts, from ten kilograms), sixty of
// firewood. With twenty kilograms, a lot twice the size: two households
// buy it, each to twenty kilograms.
fetch_plenty_of_grain: #Method & {
    title:    "fetch plenty of grain to sell"
    goal:     "goods_to_sell"
    ofTrade:  "farmer"
    sequence: true
    rank:     2
    pre: {
        find:  ["supply", "goods"]
        match: #Market & { me: #Agent & { freeHands: >=1 }, supply: #Body & { id: $l },
                           goods: #Stack & { unit: "grain", mass: >=20kg, place: #Inside & { container: $l } } }
    }
    steps: [#Do & { op: "take_some", object: "goods", units: 40 }]
} @family(methods)

fetch_grain: #Method & {
    title:    "fetch grain to sell"
    goal:     "goods_to_sell"
    ofTrade:  "farmer"
    sequence: true
    rank:     3
    pre: {
        find:  ["supply", "goods"]
        match: #Market & { me: #Agent & { freeHands: >=1 }, supply: #Body & { id: $l },
                           goods: #Stack & { unit: "grain", mass: >=15kg, place: #Inside & { container: $l } } }
    }
    steps: [#Do & { op: "take_some", object: "goods", units: 20 }]
} @family(methods)

fetch_venison: #Method & {
    title:    "fetch venison to sell"
    goal:     "goods_to_sell"
    ofTrade:  "hunter"
    sequence: true
    rank:     4
    pre: {
        find:  ["supply", "goods"]
        match: #Market & { me: #Agent & { freeHands: >=1 }, supply: #Body & { id: $l },
                           goods: #Stack & { unit: "venison", mass: >=10kg, place: #Inside & { container: $l } } }
    }
    steps: [#Do & { op: "take_some", object: "goods", units: 10 }]
} @family(methods)

fetch_firewood: #Method & {
    title:    "fetch firewood to sell"
    goal:     "goods_to_sell"
    ofTrade:  "woodcutter"
    sequence: true
    rank:     5
    pre: {
        find:  ["supply", "goods"]
        match: #Market & { me: #Agent & { freeHands: >=1 }, supply: #Body & { id: $l },
                           goods: #Stack & { unit: "firewood", mass: >=60kg, place: #Inside & { container: $l } } }
    }
    steps: [#Do & { op: "take_some", object: "goods", units: 30 }]
} @family(methods)

// Not known to be there: a look in where the household keeps it.
look_in_supply: #Method & {
    title:  "look in the supply"
    goal:   "goods_to_sell"
    rank:   6
    pre:    { find: ["supply"], match: #Market & { supply: #Container } }
    search: "supply"
    steps:  [#Do & { op: "look_in", object: "supply" }]
} @family(methods)

// The price posted on the stall's board, this market day: what it asks
// moves with its stock (money/'s #Pricing), so it writes it afresh each.
price_posted: #Goal & {
    title: "post the price"
    done:  #Did & { did: "post", lately: 4h }
} @family(goals)

write_the_price: #Method & {
    title: "write the price"
    goal:  "price_posted"
    rank:  1
    pre: {
        find:  ["stall", "goods"]
        match: #Market & { stall: #Stall & { id: $s }, goods: goods & { place: #Inside & { container: $s } } }
    }
    steps: [#Do & { op: "post", object: "board", regarding: "goods" }]
} @family(methods)

// Stand by a stall, within reach of it: what walking there does when it
// gets there.
stand_by: #Looking & { roles: { item: #Stall } } @family(operations)

// Posting a price on a board within reach: what the seller holds a unit
// of the goods worth (src/agency_agency.odin writes it). What the command
// says, a #Writing, is the board's writing from then on, in place of what
// it said.
#Posting: #Operation & {
    duration: 10s
    uses:     ["hands"]
    said:     #Writing
    written:  $w
    roles: {
        actor: #Agent & { id: $a }
        item:  #Label & { id: $i }
    }
    after: { item: #Label & { writing: $w } }
    emits: [{ event: "wrote", subject: $a, other: $i, detail: $w }]
}

// Post the price of what is on the stall on its board; and of a second
// kind of goods, on a second board beside it (an operation of its own, so
// that each is done once a market).
post:        #Posting @family(operations)
post_beside: #Posting @family(operations)

// Hand `units` of a stack within reach over to someone beside, into a pack
// they carry if it fits, else a free hand of theirs.
hand_over: #Operation & {
    uses:      ["hands"]
    stow:      true
    parameter: $n & >=1
    roles: {
        actor:       #Agent
        item:        #Stack & { id: $i }
        destination: #Agent & { id: $d, freeHands: >=1 }
    }
    moves: [#Moves & { moved: $i, portion: $n, into: #Held & { by: $d }, passes: true }]
} @family(operations)

// Pay: `units` of the coins in hand, or carried (in a pouch at the belt),
// put into a container within two tiles (the stall's takings, beside its
// seller).
pay: #Operation & {
    range:     2
    uses:      ["hands"]
    parameter: $n & >=1
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Stack & { id: $i, unit: "coin", place: #Held & { by: $a } | #Inside & { carriedBy: $a } }
        destination: #Container & { id: $c }
    }
    moves: [#Moves & { moved: $i, portion: $n, exact: true, into: #Inside & { container: $c }, passes: true }]
} @family(operations)

// Stocking the household (the buyer's, through the market's hours): its
// larder holding so much grain, so much meat; its woodpile so much
// firewood. Each bought a lot at a time, and brought home. Kept: what
// can't be had now (no stall known yet, nobody minding one) is tried again
// a while later, through the market's hours.
grain_stocked: #Goal & {
    title: "buy grain"
    kept:  true
    done: {
        find:  ["supply", "goods"]
        match: #Market & { supply: #Body & { id: $l }, goods: #Stack & { unit: "grain", mass: >=20kg, place: #Inside & { container: $l } } }
    }
    urgency: [{ input: 0, output: 35 }]
} @family(goals)

meat_stocked: #Goal & {
    title: "buy meat"
    kept:  true
    done: {
        find:  ["supply", "goods"]
        match: #Market & { supply: #Body & { id: $l }, goods: #Stack & { unit: "venison", mass: >=5kg, place: #Inside & { container: $l } } }
    }
    urgency: [{ input: 0, output: 35 }]
} @family(goals)

leather_stocked: #Goal & {
    title: "buy leather"
    kept:  true
    done: {
        find:  ["supply", "goods"]
        match: #Market & { supply: #Body & { id: $l }, goods: #Stack & { unit: "hare leather", mass: >=600g, place: #Inside & { container: $l } } }
    }
    urgency: [{ input: 0, output: 30 }]
} @family(goals)

firewood_stocked: #Goal & {
    title: "buy firewood"
    kept:  true
    done: {
        find:  ["supply", "goods"]
        match: #Market & { supply: #Body & { id: $l }, goods: #Stack & { unit: "firewood", mass: >=110kg, place: #Inside & { container: $l } } }
    }
    urgency: [{ input: 0, output: 35 }]
} @family(goals)

// The ways (METHODS.md: whole ways, what they need as subgoals). Goods
// bought in hand are brought home and put in, before more are bought (a
// hand freed for more would put them down). Else stocking the supply is
// one way: enough coming (bought into its hand or pack), then in hand (out
// of its pack, by the supply), then put in. Each need is
// a goal of its own, passed over while it holds, so a buyer resumes where
// it was (at the stalls, on its way home), and a buy that fails fails the
// way, not falling to fetching coins it holds already:
// - enough coming: bought, a lot at a time: the coins in hand (the
//   coffer's, looked in first if it hasn't seen inside; with a pouch in
//   the coffer, that at its belt, and the coins into it, in no hand), a price known (a
//   round of the stalls), the coins for the lot at that price (more from
//   the coffer; those in hand will do if it believes there are no more),
//   a hand free (the seller hands the lot over into its pack if there is
//   room, but to a hand held out), then the purchase;
// - in hand: out of its pack, by the supply (carrying/'s ways, the goods
//   and the supply bound as the thing and where it goes);
// - a hand free: carrying/'s, what it carries put down.
// The goods are alike but for their unit and the level; `let`s make them.
// With a pouch: taken from the coffer to the belt, with what is in it;
// that not enough, the coffer's coins put into it.
let wear_the_pouch = {
    title: "take the pouch"
    rank:  1
    pre:   { find: ["coffer", "pouch"], match: #Market & { coffer: #Body & { id: $k }, pouch: #Pouch & { place: #Inside & { container: $k } } } }
    steps: [#Do & { op: "belt_on", object: "pouch" }]
}
let fill_the_pouch = {
    title: "fill the pouch"
    rank:  2
    pre: {
        find:  ["coffer", "purse", "pouch"]
        match: #Market & {
            me:     #Agent & { id: $me }
            coffer: #Body & { id: $k }
            purse:  #Stack & { unit: "coin", place: #Inside & { container: $k } }
            pouch:  #Pouch & { place: #Held & { by: $me, hand: 9 } }
        }
    }
    steps: [#Achieve & { subgoal: "hand_free" }, #Do & { op: "pocket", object: "purse", target: "pouch" }]
}
let fetch_coins = {
    title: "fetch the coins"
    rank:  3
    pre: {
        find:  ["coffer", "purse"]
        match: #Market & { coffer: #Body & { id: $k }, purse: #Stack & { unit: "coin", place: #Inside & { container: $k } } }
    }
    steps: [#Achieve & { subgoal: "hand_free" }, #Do & { op: "take", object: "purse" }]
}
let look_in_coffer = {
    title:  "look in the coffer"
    rank:   4
    pre:    { find: ["coffer"], match: #Market & { coffer: #Container } }
    search: "coffer"
    steps:  [#Do & { op: "look_in", object: "coffer" }]
}
let read_prices = {
    title:  "go to the stalls"
    rank:   1
    pre:    { find: ["stall"], match: #Market & { stall: #Stall } }
    order:  ["near"]
    search: "stall"
    steps:  [#Do & { op: "stand_by", object: "stall" }]
}
// The goods in its pack, as the thing to take in hand, by the supply.
let unpack_it = {
    title: "unpack it"
    rank:  1
    steps: [#Achieve & { subgoal: "thing_in_hand", with: [{ binds: "thing", to: "goods" }, { binds: "into", to: "supply" }] }]
}
let in_my_pack = #Market & { me: #Agent & { id: $me }, pack: #Pack & { id: $p, place: #Held & { by: $me } } }

// Grain: twenty kilograms in the larder, ten units a lot.
let grain_lot = { what: #Stack & { unit: "grain" }, units: 10, stocking: "supply", level: 20kg }
put_grain_in:       #Method & {
    title: "bring it home"
    goal:  "grain_stocked"
    rank:  1
    pre:   { find: ["goods"], match: #Market & { me: #Agent & { id: $me }, goods: #Stack & { unit: "grain", place: #Held & { by: $me } } } }
    steps: [#Do & { op: "put_in", object: "goods", target: "supply" }]
} @family(methods)
stock_grain:        #Method & {
    title: "buy grain"
    goal:  "grain_stocked"
    rank:  2
    pre:   { find: [], match: #Market }
    steps: [#Achieve & { subgoal: "grain_coming" }, #Achieve & { subgoal: "grain_in_hand" },
            #Do & { op: "put_in", object: "goods", target: "supply" }]
} @family(methods)
grain_coming:       #Goal & { title: "buy enough grain", done: #Buying & grain_lot & { buying: "coming" } } @family(goals)
buy_grain:          #Method & {
    title: "buy a lot of grain"
    goal:  "grain_coming"
    rank:  1
    pre:   { find: [], match: #Market }
    steps: [#Achieve & { subgoal: "coins_for_grain" }, #Achieve & { subgoal: "grain_priced" },
            #Achieve & { subgoal: "hand_free" }, #Purchase & grain_lot]
} @family(methods)
grain_priced:       #Goal & { title: "learn the price of grain", done: #Buying & grain_lot & { buying: "priced" } } @family(goals)
coins_for_grain:    #Goal & { title: "the coins for grain", done: #Buying & grain_lot & { buying: "affords", coinsIn: "coffer" } } @family(goals)
grain_in_hand:      #Goal & {
    title: "grain in hand"
    done:  { find: ["goods"], match: #Market & { me: #Agent & { id: $me }, goods: #Stack & { unit: "grain", place: #Held & { by: $me } } } }
} @family(goals)
read_grain_prices:  #Method & read_prices & { goal: "grain_priced" } @family(methods)
fetch_coins_grain:  #Method & fetch_coins & { goal: "coins_for_grain" } @family(methods)
pouch_for_grain:    #Method & wear_the_pouch & { goal: "coins_for_grain" } @family(methods)
pouch_filled_grain: #Method & fill_the_pouch & { goal: "coins_for_grain" } @family(methods)
coffer_grain:       #Method & look_in_coffer & { goal: "coins_for_grain" } @family(methods)
unpack_grain:       #Method & unpack_it & {
    goal: "grain_in_hand"
    pre:  { find: ["pack", "goods"], match: in_my_pack & { goods: #Stack & { unit: "grain", place: #Inside & { container: $p } } } }
} @family(methods)

