// Looks, the tiles theme: the watcher's window, glyph tiles in DejaVu Sans
// Mono (see looks.tri for the cut points).

package looks

tiles_wall:     #Glyph & { theme: "tiles", look: "wall", char: "#", ink: [190, 186, 176], ground: [74, 72, 68] } @family(glyphs)
tiles_floor:    #Glyph & { theme: "tiles", look: "floor", char: ".", ink: [110, 110, 100], ground: [28, 28, 26] } @family(glyphs)
tiles_plank:    #Glyph & { theme: "tiles", look: "floor.plank", char: ".", ink: [140, 104, 60], ground: [42, 30, 18] } @family(glyphs)
tiles_doorway:  #Glyph & { theme: "tiles", look: "doorway", char: "'", ink: [170, 130, 70], ground: [30, 26, 20] } @family(glyphs)
tiles_air:      #Glyph & { theme: "tiles", look: "air", char: " ", ink: [0, 0, 0], ground: [4, 4, 6] } @family(glyphs)
tiles_grass:    #Glyph & { theme: "tiles", look: "ground.grass", char: ",", ink: [84, 132, 58], ground: [20, 34, 16] } @family(glyphs)
tiles_tilled:   #Glyph & { theme: "tiles", look: "ground.tilled", char: "≈", ink: [150, 108, 62], ground: [44, 30, 18] } @family(glyphs)
tiles_woodland: #Glyph & { theme: "tiles", look: "ground.woodland", char: "\"", ink: [58, 112, 52], ground: [12, 26, 12] } @family(glyphs)
tiles_path:     #Glyph & { theme: "tiles", look: "ground.path", char: ".", ink: [156, 136, 102], ground: [42, 36, 26] } @family(glyphs)

tiles_thing:     #Glyph & { theme: "tiles", look: "thing", char: "?", ink: [200, 200, 200] } @family(glyphs)
tiles_body:      #Glyph & { theme: "tiles", look: "body", char: "o", ink: [200, 190, 170] } @family(glyphs)
tiles_agent:     #Glyph & { theme: "tiles", look: "agent", char: "@", ink: [240, 220, 120] } @family(glyphs)
tiles_farmer:    #Glyph & { theme: "tiles", look: "agent.farmer", char: "@", ink: [170, 230, 110] } @family(glyphs)
tiles_deer:      #Glyph & { theme: "tiles", look: "animal.deer", char: "d", ink: [190, 140, 90] } @family(glyphs)
tiles_hare:      #Glyph & { theme: "tiles", look: "animal.hare", char: "h", ink: [200, 180, 150] } @family(glyphs)
tiles_carcass:   #Glyph & { theme: "tiles", look: "carcass", char: "x", ink: [150, 60, 50] } @family(glyphs)
tiles_bow:       #Glyph & { theme: "tiles", look: "tool.bow", char: ")", ink: [170, 130, 80] } @family(glyphs)
tiles_woodman:   #Glyph & { theme: "tiles", look: "agent.woodcutter", char: "@", ink: [230, 170, 100] } @family(glyphs)
tiles_hunter:    #Glyph & { theme: "tiles", look: "agent.hunter", char: "@", ink: [200, 200, 210] } @family(glyphs)
tiles_stack:     #Glyph & { theme: "tiles", look: "stack", char: "*", ink: [210, 210, 220] } @family(glyphs)
tiles_container: #Glyph & { theme: "tiles", look: "container", char: "u", ink: [170, 130, 80] } @family(glyphs)
tiles_larder:    #Glyph & { theme: "tiles", look: "container.larder", char: "■", ink: [170, 130, 80] } @family(glyphs)
tiles_woodpile:  #Glyph & { theme: "tiles", look: "container.woodpile", char: "≡", ink: [160, 110, 60] } @family(glyphs)
tiles_coffer:    #Glyph & { theme: "tiles", look: "container.coffer", char: "▪", ink: [150, 110, 60] } @family(glyphs)
tiles_stall:     #Glyph & { theme: "tiles", look: "stall", char: "π", ink: [190, 150, 90] } @family(glyphs)
