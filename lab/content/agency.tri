// Goals and methods (AGENCY.md §4, §5): what an agent can want, and the ways
// it knows to get it. Agency reads them against the agent's knowledge view
// only: every slot is bound to a referent the agent believes present, and
// every condition is matched against the descriptions it last perceived.

// What a goal and its methods are about: the agent itself, as `me`, and
// slots for the things involved, each bound to a referent. A goal's frame is
// the type of its `done` pattern. A slot that a goal and its subgoal share is
// declared once, on a type both frames inherit, and its binding passes
// between them.
#Frame: { me: #Agent }

#WithNails: #Frame & { nails: #Stack }

// Wedging a lock: the lock, and the nail driven into it as a wedge.
#Wedging: #WithNails & { lock: #Assembly, wedge: #Body }

// Having nails: the nails, the containers to look in for them, and someone
// to ask.
#HavingNails: #WithNails & { box: #Container, someone: #Agent }

// Repairing: the shutoff to close, the wrench, and the pump.
#Repairing: #Frame & { shutoff: #Body, tool: #Body, pump: #Body }

// Warming: a stove to light.
#Warming: #Frame & { stove: #Body }
// Airing: a door to open, the way out.
#Airing: #Frame & { exit: #Body }
// Tightening: the spanner, and the nut.
#Tightening: #Frame & { spanner: #Body, nut: #Body }

// Fetching: a part.
#Fetching: #Frame & { part: #Body }
// Mending a latent assembly (ACTIONS.md Scenario 3's steps 3 and 4): the
// machine, the wrench, the worn part once one is seen, and its spare.
#Mending:  #Frame & { machine: #Body, wrench: #Body, worn: #Body, spare: #Body }

// Delivering: the goods, and where they are to go.
#Delivering: #Frame & { goods: #Body, dest: #Container }

// Tidying: what to put away, and the bin to put it in.
#Tidying:  #Frame & { stuff: #Body, bin: #Container }

// Getting money: the money, and a friend or someone to work for.
#Getting:  #Frame & { money: #Body, friend: #Agent, boss: #Agent }

// Repaying a loan (AGENCY.md §7: a debt is a commitment): what was lent,
// and who lent it.
#Repaying: #Frame & { loan: #Body, lender: #Agent }

// A wrong (INSTITUTIONS.md): what was taken, someone of the watch to tell,
// and who took it.
#Wronging: #Frame & { loot: #Body, officer: #Agent, culprit: #Agent }
// Under arrest: the arrested, and the one holding it.
#Custody: #Frame & { arrested: #Agent, warden: #Agent }
// Harmed: who struck.
#Harming: #Frame & { attacker: #Agent }

// Eating: the food. Watching: the spot where something stirred.
#Supper:   #Frame & { food: #Body }
#Watching: #Frame & { spot: #Container }

// A condition over the knowledge view: `find` names the slots to bind, in
// order, to referents believed present (slots already bound keep their
// referent); it holds when the frame's description, with those referents
// in its slots, is entailed by `match`. Unknown never holds.
#Condition: { find: [...text], match: #Frame }

#Intent: { title: text }

// What a goal is worth (AGENCY.md §3): its considerations, added, in the
// units of credence (dB). A consideration over a value (a need's pressure,
// a trait) may give a `curve` (AGENCY.md §3: "fixed-point curve … lookup
// tables"): its points, the worth `output` at the value `input`, straight
// between them and level beyond the ends. Without one, `per` scales the value.
#Point:         { input: int, output: int }
// A consideration that is a `veto` (AGENCY.md decision 14) rules the option
// out when it counts against it at all, whatever else scores: a deeply held
// norm.
#Consideration: { curve: [...#Point], veto: *false | true }
// a fixed worth: a duty, a meal
#Flat:      #Consideration & { value: int }
// one that scales something of the agent's: `per` tenths of a point for
// each point of it
#Scaled:    #Consideration & { per: int }
// a cost, the believed risk, as the agent's risk tolerance weighs it
#Cost:      #Consideration & { cost: int }
// how strongly the agent believes something like `suspect` is in the slot's
// referent: the credence of what it was told, with its findings of
// `evidence` about the place as a group of their own (KNOWLEDGE.md §11)
#Suspicion: #Consideration & { suspect: #Body, inside: text, evidence: text }

// What a need presses for (AGENCY.md §6): pressure over what the agent
// feels, `per` tenths of a point for each point of it.
#Need:      #Scaled & { pressure: text }

// When a need raises a goal (AGENCY.md §4's needs generator): while the
// agent feels it above `above`.
#Pressing: { need: text, above: int }

// Where a goal arises (AGENCY.md §4's reactive generator): a candidate for
// each finding of the kind about something of kind `of`, the slot bound to
// it, while the finding is salient: drawn no longer ago than `lapse`; with
// a `duty`, only for an agent whose office's badge it is (INSTITUTIONS.md:
// an officer's duty); `exempt`, never for one whose it is.
#Arising: { finding: text, slot: text, lapse: time, of: #Body, duty: text, exempt: text }

// A goal is done when `done` holds. What it `concerns` is salient to an agent
// that holds it (AGENCY.md §10): something like one of them seen moved, or
// talked of, is worth remembering. A goal with `arises` is weighed against
// what the agent is doing whenever it arises.
// A committed goal's `urgency` (AGENCY.md §7) is a curve over how much of
// its window has passed (thousandths); without one, it rises straight to 20
// by the deadline.
#Goal: #Intent & { done: #Condition, concerns: [...#Body], worth: [...#Consideration], arises: #Arising,
                   pressed: #Pressing, urgency: [...#Point] }

// Conditions of what the agent did, not of how things are: it has looked
// into the slot's referent since adopting the goal; an activity of the
// operation it started since has completed.
#Looked: #Condition & { looked: text }
#Did:    #Condition & { did: text }
// ... it is within reach of the slot's referent.
#Reached: #Condition & { reached: text }

// How a candidate's referents are ordered, for each slot as it is found:
// nearest first, most recently seen first, the one the agent has most
// often chosen for the slot (its habit, AGENCY.md §8), the one it is most
// loyal to (AGENCY.md decision 12), one it believes hiring (a #Hires
// finding: decision 15), or the one it most
// believes holds what the method `seeks` (AGENCY.md §5: "ordering the
// places to look by the belief that the item is there"), told so if not
// believing it. Ties go to the lower referent.
#Order: "near" | "recent" | "habit" | "loyal" | "hiring" | "likely"

// A method's steps, done in order and re-read at every decision: a subgoal
// whose goal is already done is passed over, and its bindings join the
// method's; the first operation is performed, after walking within reach of
// what it names. Slots name the step's roles. An operation can say something
// (talk.tri): after a question, the agent waits a while for the answer.
#MethodStep: {}
#Achieve:    #MethodStep & { subgoal: text }
#Do:         #MethodStep & { op: text, object: text, target: text, units: int, says: #Utterance, regarding: text }

// A way to achieve a goal. Its alternatives are tried by `rank`, lowest first,
// skipping those that have failed since the goal was adopted; the first whose
// `pre` holds is followed. A `search` slot is somewhere to look: a referent
// whose inside the agent has seen since the goal was adopted is passed over.
// An agent asked the same kind of thing (the method's first `says`) since
// the goal was adopted is passed over too. A search
// looks into so many `places` (0, no end), counting those seen into or asked
// since; curiosity widens it, a place more for every 25 (AGENCY.md §9).
// Against a referent with a competing hypothesis (CONTENT_LANGUAGE.md §9),
// `pre` holds when the credence mass that entails it reaches `threshold`
// (thousandths); short of that it is unknown, at the path where they part. When no
// method's `pre` holds, the goal is impossible for now: it is dropped with
// the reason, and the method that needed it has failed.
// What is weighed by its score: a method, or a lie.
#Scored: #Intent & { score: [...#Consideration] }

#Method: #Scored & {
    goal:      text
    rank:      int
    pre:       #Condition
    order:     [...#Order]
    seeks:     #Thing
    search:    text
    places:    *0 | int & >=0 & <=100
    threshold: *1000 | int & >=0 & <=1000
    steps:     [...#MethodStep]
    onUnknown: text
    sequence:  *false | true
}

// A `sequence` method is a recipe (ACTIONS.md §6): its operations are done
// in order, once each; a timed one is done when its activity has completed
// since the goal was adopted, and a suspended one is resumed.

// `onUnknown` (AGENCY.md §5): when the precondition is unknown, rather than
// false, the goal to adopt first, with the unknown match's bindings: finding
// out what is unknown.

// A method's score (AGENCY.md §5): its considerations, added. Methods are
// tried best first, then by rank; one that scores below nothing is
// unthinkable, and not tried at all.
// what a disposition or a norm of the agent's adds: `per` tenths of a point
// for each point of it
#Trait:   #Scaled & { trait: text }
// what respect for reservations costs: if the agent believes the slot's
// referent reserved for someone else, `per` tenths of a point for each point
// of its respect
#Respect: #Scaled & { reserved: text }
// a penalty if the agent believes someone, not itself, could see the slot's
// referent
#Watched: #Consideration & { watched: text, penalty: int }
// what loyalty adds (AGENCY.md decision 12): the agent's loyalty to the
// slot's referent, or to whoever it believes owns it, `per` tenths of a
// point for each point of it
#Loyal: #Scaled & { loyal: text }
// what the law weighs (INSTITUTIONS.md decision 5): if the agent knows a law
// forbidding `act` on the slot's referent as it believes it to be (another's),
// and believes itself seen, what the law weighs; unseen, nothing
#Acting:   #Consideration & { act: text }
#Unlawful: #Acting & { unlawful: text }


// --- AGENCY.md Scenario 1, as "the missing nails" -----------------------------

wedge_lock: #Goal & {
    title:    "wedge the lock"
    concerns: [#Assembly, #Stack & { unit: "iron_nail" }]
    done: {
        find:  ["lock", "wedge"]
        match: #Wedging & {
            lock:  #Assembly & { id: $l }
            wedge: #Body & { place: #Installed & { assembly: $l, role: "wedge" } }
        }
    }
} @family(goals)

have_nails: #Goal & {
    title:    "have nails"
    concerns: [#Stack & { unit: "iron_nail" }]
    done: {
        find:  ["nails"]
        match: #HavingNails & {
            me:    #Agent & { id: $me }
            nails: #Stack & { unit: "iron_nail", place: #Held & { by: $me } }
        }
    }
} @family(goals)

// Nails in hand, then drive one into the lock.
drive_a_nail: #Method & {
    title: "drive a nail in"
    goal:  "wedge_lock"
    rank:  1
    pre:   { find: ["lock"], match: #Wedging & { lock: #Assembly } }
    order: ["near"]
    steps: [
        #Achieve & { subgoal: "have_nails" },
        #Do & { op: "drive", object: "nails", target: "lock" },
    ]
}  @family(methods)

// Take two from nails believed lying about or in a container, nearest first:
// two, so what is taken stays a stack, and drive splits one off.
fetch_nails: #Method & {
    title: "fetch nails"
    goal:  "have_nails"
    rank:  1
    pre: {
        find:  ["nails"]
        match: #HavingNails & { nails: #Stack & { unit: "iron_nail", place: #Inside | #OnTile } }
    }
    order: ["near"]
    steps: [#Do & { op: "take_some", object: "nails", units: 2 }]
} @family(methods)

// Look into the containers the agent knows of, where it most believes nails
// are first, then the most recently seen, then the nearest: two of them,
// and more if it is curious.
search_for_nails: #Method & {
    title:  "search for nails"
    goal:   "have_nails"
    rank:   2
    pre:    { find: ["box"], match: #HavingNails & { box: #Container } }
    order:  ["likely", "recent", "near"]
    seeks:  #Stack & { unit: "iron_nail" }
    search: "box"
    places: 2
    steps:  [#Do & { op: "look_in", object: "box" }]
} @family(methods)

// Ask someone the agent knows of where nails are, the nearest first. What
// they answer, the agent believes (KNOWLEDGE.md §10): told where nails are,
// fetching them holds again.
ask_for_nails: #Method & {
    title:  "ask where nails are"
    goal:   "have_nails"
    rank:   3
    pre:    { find: ["someone"], match: #HavingNails & { someone: #Agent } }
    order:  ["near"]
    search: "someone"
    steps:  [#Do & { op: "say", object: "someone", says: #WhereIs & { what: #Stack & { unit: "iron_nail" } } }]
} @family(methods)


// --- AGENCY.md Scenario 2, "the false alarm" ----------------------------------

eat_supper: #Goal & {
    title: "eat supper"
    done:  #Did & { did: "eat" }
    worth: [#Flat & { value: 20 }]
} @family(goals)

eat_it: #Method & {
    title: "eat"
    goal:  "eat_supper"
    rank:  1
    pre: {
        find:  ["food"]
        match: #Supper & {
            me:   #Agent & { id: $me }
            food: #Body & { material: "food", place: #Held & { by: $me } }
        }
    }
    steps: [#Do & { op: "eat", object: "food" }]
} @family(methods)

// Arises from a disturbance: worth how strongly the agent believes someone is
// there, its duty, and less the risk.
investigate: #Goal & {
    title:    "investigate the disturbance"
    done:     #Looked & { looked: "spot" }
    arises:   { finding: "#Disturbance", slot: "spot", lapse: 30s, of: #Container }
    concerns: [#Agent]
    worth: [
        #Suspicion & { suspect: #Agent, inside: "spot", evidence: "#Disturbance" },
        #Flat & { value: 20 },
        #Cost & { cost: 5 },
    ]
} @family(goals)

look_into_it: #Method & {
    title: "look into it"
    goal:  "investigate"
    rank:  1
    pre:   { find: ["spot"], match: #Watching & { spot: #Container } }
    steps: [#Do & { op: "look_in", object: "spot" }]
} @family(methods)


// --- INSTITUTIONS.md decision 6: a wrong reported ---------------------------------

// Seen something taken from its owner (a #Taken finding): tell the watch,
// unless one is of the watch oneself; the more, the more loyal to the owner. A grievance is a claim told to an
// office holder; whether it acts is its own decision.
report_wrong: #Goal & {
    title:  "report the theft"
    done:   #Did & { did: "say" }
    arises: { finding: "#Taken", slot: "loot", lapse: 1h, of: #Body, exempt: "watch" }
    worth:  [#Flat & { value: 15 }, #Loyal & { loyal: "loot", per: 3 }]
} @family(goals)

// Go to someone wearing the watch's badge, the nearest first, and say what
// was taken, whose it was, and who took it (`regarding` the loot).
tell_the_watch: #Method & {
    title: "tell the watch"
    goal:  "report_wrong"
    rank:  1
    pre: {
        find:  ["loot", "officer"]
        match: #Wronging & { officer: #Agent & #OfficeHolder & { badge: "watch" } }
    }
    order: ["near"]
    steps: [#Do & { op: "say", object: "officer", says: #Grievance, regarding: "loot" }]
} @family(methods)


// An officer of the watch who believes something was taken (INSTITUTIONS.md
// decisions 4 and 7): its office's duty, weighed like any goal: arrest the
// taker, as the law against theft brings, and take the thing back.
enforce: #Goal & {
    title:  "recover it and arrest the taker"
    done:   #Did & { did: "confiscate" }
    arises: { finding: "#Taken", slot: "loot", lapse: 1h, of: #Body, duty: "watch" }
    worth:  [#Flat & { value: 30 }]
} @family(goals)

take_it_back: #Method & {
    title:    "take it back"
    goal:     "enforce"
    rank:     1
    sequence: true
    pre: {
        find:  ["loot", "culprit"]
        match: #Wronging & { loot: #Body & { place: #Held & { by: $t } }, culprit: #Agent & { id: $t } }
    }
    steps: [#Do & { op: "arrest", object: "culprit" }, #Do & { op: "confiscate", object: "loot" }]
} @family(methods)


// Arrested (INSTITUTIONS.md decision 7): flee, or comply by not. Escaping
// what the arrest brings is worth 40; the disposition to abide weighs
// against it, so that by default one complies.
flee_arrest: #Goal & {
    title:  "get away"
    done:   #Did & { did: "flee" }
    arises: { finding: "#Arrested", slot: "arrested", lapse: 60s, of: #Agent }
    worth:  [#Flat & { value: 40 }, #Trait & { trait: "abiding", per: -8 }]
} @family(goals)

run_off: #Method & {
    title: "run off"
    goal:  "flee_arrest"
    rank:  1
    pre:   { find: ["warden"], match: #Custody & { warden: #Agent & #OfficeHolder & { badge: "watch" } } }
    order: ["near"]
    steps: [#Do & { op: "flee", object: "warden" }]
} @family(methods)


// Or resist (decision 7, AGENCY.md §13): strike the one making the
// arrest. Worth less than getting away, but more to one with a temper;
// never, to one who holds never to strike anyone.
resist_arrest: #Goal & {
    title:  "resist"
    done:   #Did & { did: "hit" }
    arises: { finding: "#Arrested", slot: "arrested", lapse: 60s, of: #Agent }
    worth:  [#Flat & { value: 20 }, #Trait & { trait: "abiding", per: -8 }, #Trait & { trait: "temper", per: 4 },
             #Trait & { trait: "gentle", per: -1, veto: true }]
} @family(goals)

fight_off: #Method & {
    title: "fight them off"
    goal:  "resist_arrest"
    rank:  1
    pre:   { find: ["warden"], match: #Custody & { warden: #Agent & #OfficeHolder & { badge: "watch" } } }
    order: ["near"]
    steps: [#Do & { op: "hit", object: "warden" }]
} @family(methods)


// --- AGENCY.md §13, harm and threats ------------------------------------------

// Struck (a #Struck finding, about who struck): a threat, weighed against
// whatever the agent is doing. Hit back, as its temper has it, unless it
// holds never to strike anyone (a veto); or get clear, the more the more it
// hurts and the less its temper.
hit_back: #Goal & {
    title:  "hit back"
    done:   #Did & { did: "hit" }
    arises: { finding: "#Struck", slot: "attacker", lapse: 10s, of: #Agent }
    worth:  [#Flat & { value: -10 }, #Trait & { trait: "temper", per: 4 }, #Trait & { trait: "gentle", per: -1, veto: true }]
} @family(goals)

strike_back: #Method & {
    title: "strike back"
    goal:  "hit_back"
    rank:  1
    pre:   { find: ["attacker"], match: #Harming & { attacker: #Agent } }
    steps: [#Do & { op: "hit", object: "attacker" }]
} @family(methods)

get_clear: #Goal & {
    title:  "get clear"
    done:   #Did & { did: "flee" }
    arises: { finding: "#Struck", slot: "attacker", lapse: 10s, of: #Agent }
    worth:  [#Trait & { trait: "injury", per: 5 }, #Trait & { trait: "temper", per: -4 }]
} @family(goals)

back_away: #Method & {
    title: "back away"
    goal:  "get_clear"
    rank:  1
    pre:   { find: ["attacker"], match: #Harming & { attacker: #Agent } }
    steps: [#Do & { op: "flee", object: "attacker" }]
} @family(methods)


// --- AGENCY.md Scenario 3, "the tempting purse" -------------------------------

// A debt due: get money. A commitment, not a body's need.
get_money: #Goal & {
    title: "get money"
    done: {
        find:  ["money"]
        match: #Getting & {
            me:    #Agent & { id: $me }
            money: #Body & { material: "cloth", place: #Held & { by: $me } }
        }
    }
} @family(goals)

// Ask a friend to lend it: awkward, but no harm. The closest friend first;
// anyone it is not loyal to is barely worth asking.
borrow_money: #Method & {
    title:  "borrow from a friend"
    goal:   "get_money"
    rank:   1
    pre:    { find: ["friend"], match: #Getting & { friend: #Agent } }
    order:  ["loyal", "near"]
    search: "friend"
    steps:  [#Do & { op: "say", object: "friend", says: #Request & { what: #Body & { material: "cloth" } } }]
    score:  [#Loyal & { loyal: "friend", curve: [{ input: 0, output: 1 }, { input: 20, output: 10 }] }]
} @family(methods)

// A loan granted is a debt the borrower owes back: what was lent, back in
// the lender's hand, by the end of the loan's term.
repay: #Goal & {
    title: "repay the loan"
    done: {
        find:  ["loan", "lender"]
        match: #Repaying & {
            loan:   #Body & { place: #Held & { by: $l } }
            lender: #Agent & { id: $l }
        }
    }
} @family(goals)

hand_it_back: #Method & {
    title: "hand it back"
    goal:  "repay"
    rank:  1
    pre: {
        find:  ["loan", "lender"]
        match: #Repaying & { loan: #Body & { place: #Held & { by: $me } } }
    }
    steps: [#Do & { op: "give", object: "loan", target: "lender" }]
} @family(methods)

// Take the purse: worth more than borrowing, to the dishonest, unwatched.
take_the_purse: #Method & {
    title: "take the purse"
    goal:  "get_money"
    rank:  1
    pre: {
        find:  ["money"]
        match: #Getting & { money: #Body & { material: "cloth", place: #OnTile | #Inside } }
    }
    order: ["near"]
    steps: [#Do & { op: "take", object: "money" }]
    score: [
        #Flat & { value: 30 },
        #Trait & { trait: "honesty", per: -5 },
        #Trait & { trait: "scruples", per: -10 },
        #Unlawful & { unlawful: "money", act: "take" },
    ]
} @family(methods)


// --- AGENCY.md §6, needs ------------------------------------------------------

// Hunger raises eating, worth what the agent feels of it.
eat_when_hungry: #Goal & {
    title:   "eat something"
    done:    #Did & { did: "eat" }
    pressed: { need: "hunger", above: 40 }
    worth:   [#Need & { pressure: "hunger", per: 5 }]
} @family(goals)

// Cold raises getting warm, worth what the agent feels of it, and more the
// colder it gets (a curve): done once a stove it knows of is lit.
get_warm: #Goal & {
    title:   "get warm"
    done:    { find: ["stove"], match: #Warming & { stove: #Combustor & { lit: true } } }
    pressed: { need: "cold", above: 30 }
    worth:   [#Need & { pressure: "cold", curve: [{ input: 30, output: 10 }, { input: 60, output: 40 },
                                                  { input: 100, output: 60 }] }]
} @family(goals)

light_the_stove: #Method & {
    title: "light the stove"
    goal:  "get_warm"
    rank:  1
    pre:   { find: ["stove"], match: #Warming & { stove: #Combustor & #Body & { lit: false } } }
    order: ["near"]
    steps: [#Do & { op: "light", object: "stove" }]
} @family(methods)

// Stuffy air raises airing the room: done once a door it knows of is ajar.
air_the_room: #Goal & {
    title:   "air the room"
    done:    { find: ["exit"], match: #Airing & { exit: #Door & { ajar: true } } }
    pressed: { need: "stuffy", above: 30 }
    worth:   [#Need & { pressure: "stuffy", per: 5 }]
} @family(goals)

open_a_door: #Method & {
    title: "open a door"
    goal:  "air_the_room"
    rank:  1
    pre:   { find: ["exit"], match: #Airing & { exit: #Door & { ajar: false } } }
    order: ["near"]
    steps: [#Do & { op: "open_door", object: "exit" }]
} @family(methods)

// Tiredness raises resting: worth what the agent feels of it; done once a
// rest has run its course.
rest_when_tired: #Goal & {
    title:   "get some rest"
    done:    #Did & { did: "while_away" }
    pressed: { need: "tired", above: 50 }
    worth:   [#Need & { pressure: "tired", per: 5 }]
} @family(goals)

lie_down: #Method & {
    title: "lie down"
    goal:  "rest_when_tired"
    rank:  1
    pre:   { find: [], match: #Frame & { me: #Agent & { id: $me, place: #OnTile } } }
    steps: [#Do & { op: "while_away" }]
} @family(methods)

eat_what_i_have: #Method & {
    title: "eat what I have"
    goal:  "eat_when_hungry"
    rank:  1
    pre: {
        find:  ["food"]
        match: #Supper & {
            me:   #Agent & { id: $me }
            food: #Body & { material: "food", place: #Held & { by: $me } }
        }
    }
    steps: [#Do & { op: "eat", object: "food" }]
} @family(methods)


// --- AGENCY.md decision 11, lying --------------------------------------------------

// What the truth would expose (a gain from lying): what the law weighs, if
// the agent holds the slot's referent believing it another's, so that it
// must have done `act` (taken it), against a law it knows.
#Exposing: #Acting & { exposing: text }

// A lie it may tell, asked where something like `what` is, weighed like a
// method: its score, its considerations, with `what` bound to what it holds
// like it. Worth more than nothing, it says it doesn't know.
#Lie: #Scored & {}

// Escaping a consequence: the theft the truth would expose, against its
// honesty, and the risk of being found out (the thing in sight of someone).
deny_it: #Lie & {
    title: "deny it"
    score: [#Exposing & { exposing: "what", act: "take" }, #Trait & { trait: "honesty", per: -5 },
            #Watched & { watched: "what", penalty: 20 }]
} @family(lies)


// --- AGENCY.md decision 16, what things are worth ---------------------------------

// What something like `valued` is worth to an agent, in dB: its `value`,
// the most of those whose `valued` it believes the thing to be; raised by
// what it feels of a need the thing serves (`pressure`), `per` tenths of a
// point a point. With none, 10. Lending a thing costs its worth, less by
// the trust that it comes back.
#Valuing: #Flat & #Need & { valued: #Body }

money_value: #Valuing & { valued: #Body & { material: "cloth" }, value: 30 } @family(values)
food_value:  #Valuing & { valued: #Body & { material: "food" }, value: 10, pressure: "hunger", per: 5 } @family(values)


// --- AGENCY.md §8, habits -------------------------------------------------------

// Put away the nails in hand: done when both hands are free.
put_away: #Goal & {
    title: "put the nails away"
    done:  { find: [], match: #Tidying & { me: #Agent & { freeHands: 2 } } }
} @family(goals)

// Into a container: the habitual one, else the nearest.
put_them_in_a_box: #Method & {
    title: "put them in a box"
    goal:  "put_away"
    rank:  1
    pre: {
        find:  ["stuff", "bin"]
        match: #Tidying & {
            me:    #Agent & { id: $me }
            stuff: #Stack & { unit: "iron_nail", place: #Held & { by: $me } }
            bin:   #Container
        }
    }
    order: ["habit", "near"]
    steps: [#Do & { op: "put_in", object: "stuff", target: "bin" }]
} @family(methods)


// --- AGENCY.md §7, promises -----------------------------------------------------

// The goods in the destination: what a promise to put them there commits to.
deliver: #Goal & {
    title: "deliver it"
    done: {
        find:  ["goods", "dest"]
        match: #Delivering & {
            goods: #Body & { place: #Inside & { container: $c } }
            dest:  #Container & { id: $c }
        }
    }
} @family(goals)

hold_it: #Goal & {
    title: "hold it"
    done: {
        find:  ["goods"]
        match: #Delivering & {
            me:    #Agent & { id: $me }
            goods: #Body & { place: #Held & { by: $me } }
        }
    }
} @family(goals)

bring_it: #Method & {
    title: "bring it"
    goal:  "deliver"
    rank:  1
    pre:   { find: ["goods", "dest"], match: #Delivering & { dest: #Container } }
    steps: [
        #Achieve & { subgoal: "hold_it" },
        #Do & { op: "put_in", object: "goods", target: "dest" },
    ]
} @family(methods)

pick_it_up: #Method & {
    title: "pick it up"
    goal:  "hold_it"
    rank:  1
    pre:   { find: ["goods"], match: #Delivering & { goods: #Body & { place: #Inside | #OnTile } } }
    steps: [#Do & { op: "take", object: "goods" }]
} @family(methods)


// --- ACTIONS.md Scenario 2, "two hands, one seal" -------------------------------

get_the_seal: #Goal & {
    title: "get the seal"
    done: {
        find:  ["part"]
        match: #Fetching & {
            me:   #Agent & { id: $me }
            part: #Body & { material: "rubber", place: #Held & { by: $me } }
        }
    }
} @family(goals)

// Take it up from the bench, unless the agent minds that it is reserved.
take_the_seal: #Method & {
    title: "take the seal"
    goal:  "get_the_seal"
    rank:  1
    pre:   { find: ["part"], match: #Fetching & { part: #Body & { material: "rubber", place: #OnTile } } }
    steps: [#Do & { op: "take_up", object: "part" }]
    score: [#Flat & { value: 10 }, #Respect & { reserved: "part", per: -8 }]
} @family(methods)


// --- CONTENT_LANGUAGE.md Scenario 2, "the nut of unknown size" -------------------

// Committed to, it is barely urgent until the last tenth of its window.
tighten_nut: #Goal & {
    title:   "tighten the nut"
    urgency: [{ input: 0, output: 0 }, { input: 900, output: 2 }, { input: 1000, output: 30 }]
    done:  { find: ["nut"], match: #Tightening & { nut: #Fastener & { tight: true } } }
} @family(goals)

// With a spanner that fits: if whether it fits is unknown, look closer;
// sure to nine in ten is sure enough.
tighten_it: #Method & {
    title: "tighten it"
    goal:  "tighten_nut"
    rank:  1
    pre: {
        find:  ["spanner", "nut"]
        match: #Tightening & {
            me:      #Agent & { id: $me }
            spanner: #Spanner & { size: $s, place: #Held & { by: $me } }
            nut:     #Fastener & { size: $s, tight: false }
        }
    }
    onUnknown: "look_closer"
    threshold: 900
    steps:     [#Do & { op: "tighten", object: "spanner", target: "nut" }]
} @family(methods)

// Else get a spanner that fits it (AGENCY.md §5's *seek 22 mm wrench*: the
// size is the nut's, as the agent now believes it, through the frame's
// slots), and tighten it with that.
get_one_that_fits: #Method & {
    title: "get one that fits"
    goal:  "tighten_nut"
    rank:  2
    pre:   { find: ["nut"], match: #Tightening & { nut: #Fastener & { tight: false } } }
    steps: [#Achieve & { subgoal: "fitting_spanner" },
            #Do & { op: "tighten", object: "spanner", target: "nut" }]
} @family(methods)

fitting_spanner: #Goal & {
    title: "find a spanner that fits"
    done: {
        find:  ["spanner", "nut"]
        match: #Tightening & {
            me:      #Agent & { id: $me }
            spanner: #Spanner & { size: $s, place: #Held & { by: $me } }
            nut:     #Fastener & { size: $s }
        }
    }
} @family(goals)

// Pick up a spanner of the nut's size, lying about or in something.
pick_up_spanner: #Method & {
    title: "pick up one that fits"
    goal:  "fitting_spanner"
    rank:  1
    pre: {
        find:  ["spanner", "nut"]
        match: #Tightening & {
            spanner: #Spanner & { size: $s, place: #OnTile | #Inside }
            nut:     #Fastener & { size: $s }
        }
    }
    order: ["near"]
    steps: [#Do & { op: "take_up", object: "spanner" }]
} @family(methods)

look_closer: #Goal & {
    title: "look closer"
    done:  #Reached & { reached: "nut" }
} @family(goals)

go_and_peer: #Method & {
    title: "go and peer at it"
    goal:  "look_closer"
    rank:  1
    pre:   { find: ["nut"], match: #Tightening & { nut: #Fastener } }
    steps: [#Do & { op: "peer_at", object: "nut" }]
} @family(methods)


// --- ACTIONS.md Scenario 3's inspection and replacement --------------------------

// Mend the pump: done once the faulty part is replaced.
mend_pump: #Goal & {
    title: "mend the pump"
    done:  #Did & { did: "replace_part" }
} @family(goals)

// Replace a part seen worn with a spare that fits its role: once one is
// seen, better than opening further. Nothing is bound to `worn` until
// opening the pump shows one.
replace_the_worn: #Method & {
    title: "replace the worn part"
    goal:  "mend_pump"
    rank:  1
    pre: {
        find:  ["worn", "spare"]
        match: #Mending & {
            me:    #Agent & { id: $me }
            worn:  #Part & { place: #Installed, fits: $r, wear: >=60 }
            spare: #Part & { place: #Held & { by: $me }, fits: $r }
        }
    }
    score: [#Flat & { value: 10 }]
    steps: [#Do & { op: "replace_part", object: "spare", target: "worn" }]
} @family(methods)

// Else open it a level further, to see inside.
open_it_further: #Method & {
    title: "open it further"
    goal:  "mend_pump"
    rank:  2
    pre: {
        find:  ["wrench", "machine"]
        match: #Mending & {
            me:      #Agent & { id: $me }
            wrench:  #Wrench & { place: #Held & { by: $me } }
            machine: #Pump
        }
    }
    steps: [#Do & { op: "open_up", object: "wrench", target: "machine" }]
} @family(methods)


// --- ACTIONS.md Scenario 3, "the interrupted repair" ------------------------------

repair_pump: #Goal & {
    title: "repair the pump"
    done:  { find: ["pump"], match: #Repairing & { pump: #Pump & { opened: true } } }
} @family(goals)

// The recipe: shut off the pump's line, then dismantle it. Which cock is
// the shutoff comes from what the agent knows: a diagram, say.
the_recipe: #Method & {
    title:    "follow the recipe"
    goal:     "repair_pump"
    rank:     1
    sequence: true
    pre: {
        find:  ["shutoff", "tool", "pump"]
        match: #Repairing & {
            me:      #Agent & { id: $me }
            shutoff: #Cock & { serves: "pump" }
            tool:    #Wrench & { place: #Held & { by: $me } }
            pump:    #Pump & { opened: false }
        }
    }
    steps: [
        #Do & { op: "shut_off", object: "shutoff" },
        #Do & { op: "dismantle", object: "tool", target: "pump" },
    ]
} @family(methods)
