// Work: employment as a deal: asking for work, hiring, a job, and paying the
// wage (AGENCY.md decision 15).
//
// Cut points:
// - full:     an employer weighs a request for work like any request;
//             granting it, it hires the worker and says the job, and so
//             promises the pay. As the shift ends it pays, if it believes the
//             job done and its honesty has it.
// - reduced:  the same, decided on the cadence's beat; a shift's end wakes
//             the employer on the beat.
// - abstract: as reduced. Wages paid each shift as a periodic transfer are
//             planned (DETAIL_REGIMES.md).
// - frozen:   it doesn't decide.
// - bonds:    hiring makes a bond of the worker's to the employer
//             (bonds/bonds.tri's `work_bond`).
// - money:    needing money, an agent may ask for work (money/money.tri).
// - promises: a job's task is a goal, such as delivering
//             (promises/promises.tri).
// - code:     effect_hire.

// What work adds to an agent: the job it offers, by name (AGENCY.md decision
// 15), if any.
#Agent: {
    hires: text @field(content, saved, proposable, inspect)
}

// Work (AGENCY.md decision 15): employment is a deal. An employer weighs a
// request for work like any request; granting it, it hires the worker (a
// bond, with the worker's loyalty to it, AGENCY.md decision 12), says the
// job, and so promises the pay, a promise it can keep or break.

// Have you work, for something like `what`?
#AskWork: #Question & {}

// A job: said when hiring, or authored as one an employer offers (its
// `hires`). Its `task` is a goal, its first two slots (by the goal's
// `find`) bound to things like `what` and `within`; the worker's to do
// within `shift`, for pay like `pay`, paid as the shift ends if it is done.
// What having it done is worth to the employer: `gain`, in dB.
#Job: #Placing & { task: text, pay: #Body, shift: time & >=1s & <=30d, gain: int }

// A deal posted (decision 15): someone like `holder` hires, for pay like
// `what`; to answer, find them at `site`. Written on a flyer, or an ad, by
// the employer; a reader who needs work goes to them first.
#Hiring: #Naming & { site: #OnTile }

flyer: #Label & { material: "paper", mass: 5g, legible: 2 }

// Hire someone in reach: a bond of theirs to the actor, their loyalty to
// whoever employs them.
hire: #Operation & {
    effect: "hire"
    roles: {
        actor: #Agent
        item:  #Agent
    }
} @family(operations)

// Paying a worker: the wage, the worker, and the job's goods and where
// they were to go.
#Paying: #Delivering & { wage: #Body, worker: #Agent }

// The pay in the worker's hand: what the employer promised, as the shift
// ends.
pay_wage: #Goal & {
    title: "pay the worker"
    done: {
        find:  ["wage", "worker"]
        match: #Paying & { wage: #Body & { place: #Held & { by: $w } }, worker: #Agent & { id: $w } }
    }
} @family(goals)

// If the job is done, as the employer believes it, hand over the wage. The
// honest keep their word; the dishonest find a reason not to.
pay_up: #Method & {
    title: "pay up"
    goal:  "pay_wage"
    rank:  1
    pre: {
        find:  ["wage", "goods", "dest"]
        match: #Paying & {
            me:    #Agent & { id: $me }
            wage:  #Body & { place: #Held & { by: $me } }
            goods: #Body & { place: #Inside & { container: $c } }
            dest:  #Container & { id: $c }
        }
    }
    steps: [#Do & { op: "give", object: "wage", target: "worker" }]
    score: [#Flat & { value: -20 }, #Trait & { trait: "honesty", per: 5 }]
} @family(methods)

// Needing money, ask someone for work: one it read or was told is hiring
// first, else the nearest; one, then give up.
ask_for_work: #Method & {
    title:  "ask for work"
    goal:   "get_money"
    rank:   2
    pre:    { find: ["boss"], match: #Getting & { boss: #Agent } }
    order:  ["hiring", "near"]
    search: "boss"
    places: 1
    steps:  [#Do & { op: "say", object: "boss", says: #AskWork & { what: #Body & { material: "cloth" } } }]
} @family(methods)

// A foreman's job: a stone into the oak crate, within the hour, for a purse.
crate_job: #Job & { task: "deliver", what: #Body & { material: "stone" }, within: #Container & { material: "oak" },
                    pay: #Body & { material: "cloth" }, shift: 1h, gain: 40 }
