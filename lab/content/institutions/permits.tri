// Institutions, permits: informational content and its physical copies, the
// organizations that issue it and their office holders, seals, and a forged
// permit (COMPONENTS.md §8, Scenario 2, "the forged permit").
//
// Cut points:
// - full, reduced, abstract, frozen: an agent's, as reality.tri says;
//              nothing of their own here.
// - knowledge: a copy pressed with another seal than its issuer's is found
//              forged by one who has seen the real one (`forged_seal`).
// - law:       an officer of the watch is an office holder
//              (institutions/law.tri).
// - code:      effect_issue, effect_copy.

// COMPONENTS.md §8, informational content and physical copies, and its
// second scenario, "the forged permit".

// Content: what a text says, as data, including what it says of its own
// origin (`issuer`), which may be false. It has no location. Its actual
// origin is its creation event, in history.
#Content: #Thing & {
    @component(Information)
    text:   text                               @field(saved, proposable, inspect)
    issuer: text                               @field(saved, proposable, inspect)
}

// An organization: informational, with no location, though a seal or a
// ledger may stand for it.
#Organization: #Thing & {
    @component(Organization)
    orgName: text                              @field(saved, proposable, inspect)
}

// A reified authorization: it `grants` its `grantee` something `over` an
// entity. Only an organization's procedure creates one, linked
// (`authorizes`) to the content that states it.
#Authorization: #Thing & {
    @component(Authorization)
    grants:  text                              @field(saved, proposable, inspect)
    over:    ref                               @field(saved, proposable, inspect)
    grantee: ref                               @field(saved, proposable, inspect)
}

// A copy: a physical thing whose inscription references content
// (`inscribed`, developer-side) and carries physical features: the hand, the
// seal's impression, fidelity. What it `reads`, and the issuer it `claims`,
// are what anyone looking at it sees; `penned`, the hand it is in.
#Copy: #Body & {
    @component(Inscription)
    inscribed:  ref                            @field(saved, proposable, inspect)
    reads:      text                           @field(saved, proposable, inspect, perceive(sight))
    claims:     text                           @field(saved, proposable, inspect, perceive(sight))
    penned:     text                           @field(saved, proposable, inspect, perceive(sight))
    impression: text                           @field(saved, proposable, inspect, perceive(sight))
    fidelity:   *100 | int & >=0 & <=100       @field(content, saved, proposable, inspect)
}

// A seal: what it presses, and whose seal it is.
#Stamp: #Body & {
    @component(Stamp)
    presses: text                              @field(saved, proposable, inspect, perceive(sight))
    sealOf:  text                              @field(saved, proposable, inspect, perceive(sight))
}

// Who writes, and in what hand.
#Scribe: {
    @component(Scribe)
    handwriting: text                          @field(saved, proposable, inspect)
}

// An office holder (ACTIONS.md §2): the organization it holds an office
// in, which gives it that office's capabilities, issuing permits among
// them. Holding the capability to issue is not permission to act.
#OfficeHolder: {
    @component(OfficeHolder)
    office: ref                                @field(saved, proposable, inspect)
    // what shows it: a badge, a uniform, anyone can see
    badge:  text                               @field(content, saved, proposable, inspect, perceive(sight))
}

// Someone with two hands to work with.
let person = { material: "flesh", hands: 2 }

clerk:  #Agent & #Scribe & person & { mass: 65kg, coat: "black" }
forger: #Agent & #Scribe & person & { mass: 70kg, coat: "grey" }
guard:  #Agent & person & { mass: 85kg, coat: "navy" }
alun:   #Agent & person & { mass: 75kg, coat: "green" }

office_clerk: #Agent & #Scribe & #OfficeHolder & person & { mass: 65kg, coat: "black", badge: "office" }

harbour_office: #Organization & {}
content:        #Content & {}
authorization:  #Authorization & {}
paper_copy:     #Copy & { material: "paper", mass: 5g }
ledger:         #Copy & { material: "paper", mass: 2kg }
stamp:          #Stamp & { material: "wood", mass: 150g }

// Issue a permit (the office's procedure, COMPONENTS.md Scenario 2): an
// office holder, its office's seal in hand, grants someone in reach entry
// to a place, which the command's words describe (it needn't be in reach).
// It makes the permit's content, claiming the office as issuer; the
// office's authorization, linked to it; and a copy, sealed, in the
// grantee's hand.
issue_permit: #Operation & {
    effect: "issue"
    roles: {
        actor: #OfficeHolder & #Scribe & #Agent
        item:  #Agent
    }
} @family(operations)

// Copy a text held in one hand, pressing what the other holds: the copier's
// hand, the seal's impression. Copied as it is, the copy references the same
// content; with other words (the command's), it is new content derived from
// it, still claiming its issuer.
copy_out: #Operation & {
    effect: "copy"
    uses:   ["hands"]
    roles: {
        actor: #Agent & { id: $a }
        item:  #Copy & { place: #Held & { by: $a } }
    }
} @family(operations)

// A copy claiming an issuer whose seal the agent has seen, pressed with
// another: it is forged (COMPONENTS.md Scenario 2: the guard "may know what
// the office's seal should look like").
forged_seal: #Rule & {
    premises:  [#Misprinted & { misprinted: true }]
    mastery:   0
    concludes: "#Forged"
    weight:    20
} @family(rules)
