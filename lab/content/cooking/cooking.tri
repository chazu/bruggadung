// Cooking: raw food and meals, cooking at a lit stove, and the ways from a
// larder to a meal (VILLAGE.md, slice 4).
//
// Cut points:
// - full:     wanting to eat (hunger/eating.tri's goal) has more ways to
//             it: eat a meal in hand; else make one, cooking raw food in
//             hand at a lit stove (a kilogram at most: an armful is put
//             away first, or a portion of it cooked), lighting the stove
//             first, taking the
//             food from where it is believed kept (of what is its own, the
//             kind that keeps least first: meat before it spoils, then
//             grain; agency.tri's "keeps"), or looking for it in
//             the nearest containers; else eat raw food in hand. Something
//             to eat at work is the morning's commitment (scenario-bound):
//             a meal made the same way, else raw food taken along (a
//             last resort that `ends` the goal: done is a meal in hand).
//             Short of food at home (as far as it knows), hunger alone
//             makes no meal: a ration of the meal taken along and supper.
// - reduced:  the same, decided on the cadence's beat; cooking runs its
//             time.
// - abstract: as reduced. How a household eats below reduced (a larder's
//             level, at a place) is open (VILLAGE.md decision 3).
// - frozen:   it doesn't decide; a cooking under way waits.
// - hunger:   food is hunger's #Food (hunger/eating.tri); cooking adds to
//             its `nourishment` and makes it no longer `raw`. The body
//             knows nothing of it (VILLAGE.md decision 2).
// - heat:     a stove is heat/heat.tri's, lit by its `light`; cooking only
//             needs it lit. Burning its fuel is the atmosphere domain's; a
//             stove with nothing in it is stoked before it is lit
//             (firewood/firewood.tri).
// - home:     a larder is a container, village/village.tri's, one to a
//             household. One larder is told from another just like it by
//             where it is (KNOWLEDGE.md decision 18), not its looks. Whose
//             it is (an ownership claim, things.tri, each of the
//             household's people its owner) its owners know when they see
//             it, and take from their own first, then what they are used to
//             (habit, AGENCY.md §8), then the nearest.
// - perishing: a meal keeps two days from when it is cooked, whatever it
//             was made of, then spoils (perishing/); raw grain keeps.
// - carrying: a larder is a kind of its own (#Larder), so looking for food
//             doesn't look into the coffer or the packs beside it first
//             (carrying/, money/coins.tri).
// - stacks:   cooked food doesn't merge with raw of its unit: they differ
//             (the committer's merge rule, src/commit_committer.odin).
// - code:     none for cooking itself: `cook` and `cook_portion` are
//             declared (actions.tri, EFFECTS.md), and which is tried
//             first is the ways' (cook_a_portion, cook_what_i_hold); the
//             scenario stocks the
//             larders and undertakes the morning's commitment
//             (src/scenario_village.odin).

package cooking

// What cooking adds to food: raw, it wants cooking, which adds `cooking`
// to its nourishment. Raw or not is seen.
hunger.#Food: {
    raw:     *false | true          @field(content, saved, proposable, inspect, perceive(sight))
    cooking: *0 | int & >=0 & <=100 @field(content, saved, inspect)
}

food_look: #Look & { kindOf: "#Food", look: "food", prevails: 1 } @family(looks)

// Grain, by the portion: raw, a little nourishment; cooked, a meal. A
// household's larder holds a sack of it, a stack of portions.
let raw_grain = { material: "food", raw: true, nourishment: 15, cooking: 35 }
grain:      #Body & #Food & raw_grain & { mass: 250g }
grain_sack: #Stack & #Food & raw_grain & { unit: "grain", unitMass: 250g, count: 60 }

// A larder: what a household keeps its food in, told from its other
// containers (its coffer, its packs: carrying/) at a glance.
#Larder: #Container & {}

larder_seen: #Seen & { kindOf: "#Larder" } @family(seen)

// Cooking: the food, the stove it is cooked at, and where it is kept.
#Cooking: #Supper & #Warming & { larder: #Body }

// A meal in hand: food the agent holds that isn't raw.
have_a_meal: #Goal & {
    title: "have a meal"
    done: {
        find:  ["food"]
        match: #Cooking & {
            me:   #Agent & { id: $me }
            food: #Food & #Body & { raw: false, place: #Held & { by: $me } }
        }
    }
} @family(goals)

// Hunger's ways to food, after eating a meal in hand (eat_what_i_have):
// make one and eat it, or eat raw what the agent holds.
// Rationing: short of food (less than ten kilograms of it believed in its
// own larder, forty portions), hunger alone makes no meal: the agent eats
// the meal it took to work and its supper, no more.
let short_of_food = [{ input: 9999, output: -1 }, { input: 10000, output: 0 }]
cook_and_eat: #Method & {
    title: "cook and eat"
    goal:  "eat_when_hungry"
    rank:  2
    pre:   { find: [], match: #Cooking }
    score: [#AtHome & { stocked: #Food, keptIn: #Larder, curve: short_of_food }]
    steps: [#Achieve & { subgoal: "have_a_meal" }, #Do & { op: "eat", object: "food" }]
} @family(methods)

// Supper (the evening's commitment, scenario-bound) is made the same way.
cook_supper: #Method & {
    title: "cook supper"
    goal:  "eat_supper"
    rank:  2
    pre:   { find: [], match: #Cooking }
    steps: [#Achieve & { subgoal: "have_a_meal" }, #Do & { op: "eat", object: "food" }]
} @family(methods)

eat_it_raw: #Method & {
    title: "eat it raw"
    goal:  "eat_when_hungry"
    rank:  3
    pre: {
        find:  ["food"]
        match: #Cooking & {
            me:   #Agent & { id: $me }
            food: #Food & #Body & { raw: true, place: #Held & { by: $me } }
        }
    }
    steps: [#Do & { op: "eat", object: "food" }]
} @family(methods)

// The ways to a meal, each taking from, cooking at and looking in what the
// agent knows is its own first (its household's larder, sack and stove),
// then what it is used to (AGENCY.md §8), then the nearest: cook what the
// agent holds at a stove (a pot's worth; an armful with no hand free is
// put away in its larder first),
// lit first if it isn't; take raw food from where it is kept, a portion,
// a hand free, when there is a stove to cook it at (one in hand, it is
// cooked before another is taken: an earlier way comes first, however used
// the agent is to a later one, AGENCY.md §5); or,
// with a stove to cook at, look for food in the nearest containers, two
// at most.
// With a hand free, a portion of what it holds (of an armful, one; a
// portion is itself): the same food as `cook_what_i_hold` wants, so what a
// neighbour is asked for is the same (deals/).
cook_a_portion: #Method & {
    title: "cook a portion of it"
    goal:  "have_a_meal"
    rank:  1
    pre: {
        find:  ["food", "stove"]
        match: #Cooking & {
            me:    #Agent & { id: $me, freeHands: >=1 }
            food:  #Food & #Body & { raw: true, place: #Held & { by: $me } }
            stove: #Combustor & #Body
        }
    }
    order: ["own", "habit", "near"]
    steps: [#Achieve & { subgoal: "stove_lit" }, #Do & { op: "cook_portion", object: "food", target: "stove" }]
} @family(methods)

// No hand free to take a portion into, and more in hand than a pot holds
// (an armful of the harvest): put away in its larder first, a portion
// taken from there after.
put_the_armful_away: #Method & {
    title: "put the armful away"
    goal:  "have_a_meal"
    rank:  2
    pre: {
        find:  ["food", "larder"]
        match: #Cooking & {
            me:     #Agent & { id: $me, freeHands: 0 }
            food:   #Food & #Stack & { raw: true, mass: >1kg, place: #Held & { by: $me } }
            larder: #Larder
        }
    }
    order: ["own", "habit", "near"]
    steps: [#Do & { op: "put_in", object: "food", target: "larder" }]
} @family(methods)

// All of what it holds, a pot's worth at most: a portion taken to cook.
cook_what_i_hold: #Method & {
    title: "cook it"
    goal:  "have_a_meal"
    rank:  3
    pre: {
        find:  ["food", "stove"]
        match: #Cooking & {
            me:    #Agent & { id: $me }
            food:  #Food & #Body & { raw: true, mass: <=1kg, place: #Held & { by: $me } }
            stove: #Combustor & #Body
        }
    }
    order: ["own", "habit", "near"]
    steps: [#Achieve & { subgoal: "stove_lit" }, #Do & { op: "cook", object: "food", target: "stove" }]
} @family(methods)

// The stove to cook at, lit.
stove_lit: #Goal & {
    title: "light the stove"
    done:  { find: ["stove"], match: #Cooking & { stove: #Combustor & { lit: true } } }
} @family(goals)

light_to_cook: #Method & {
    title: "light it to cook"
    goal:  "stove_lit"
    rank:  1
    pre:   { find: ["stove"], match: #Cooking & { stove: #Stove & { lit: false, fuel: >=1g } } }
    steps: [#Do & { op: "light", object: "stove" }]
} @family(methods)

// Nothing in it to burn: stoked first (firewood/firewood.tri).
stoke_to_cook: #Method & {
    title: "stoke it to cook"
    goal:  "stove_lit"
    rank:  2
    pre:   { find: ["stove"], match: #Cooking & { stove: #Stove & { lit: false } } }
    steps: [#Achieve & { subgoal: "stove_stoked" }, #Do & { op: "light", object: "stove" }]
} @family(methods)

take_to_cook: #Method & {
    title: "take some to cook"
    goal:  "have_a_meal"
    rank:  4
    pre: {
        find:  ["food", "stove"]
        match: #Cooking & {
            me:    #Agent & { freeHands: >=1 }
            food:  #Food & #Stack & { raw: true, place: #Inside }
            stove: #Combustor & #Body
        }
    }
    order: ["own", "keeps", "habit", "near"]
    steps: [#Do & { op: "take_some", object: "food", units: 1 }]
} @family(methods)

look_for_food: #Method & {
    title:  "look for food"
    goal:   "have_a_meal"
    rank:   5
    pre:    { find: ["larder", "stove"], match: #Cooking & { larder: #Larder, stove: #Combustor & #Body } }
    order:  ["own", "habit", "likely", "near"]
    seeks:  #Food & #Body
    search: "larder"
    places: 2
    steps:  [#Do & { op: "look_in", object: "larder" }]
} @family(methods)

// Something to eat at work (the morning's commitment): a meal in hand; if
// none can be made, raw food taken along ends it (`ends`), and will do. Not
// food of any kind in hand: the grain taken up to cook would be that, and
// the meal given up half made (METHODS.md decision 5).
food_along: #Goal & {
    title: "take something to eat"
    done: {
        find:  ["food"]
        match: #Cooking & {
            me:   #Agent & { id: $me }
            food: #Food & #Body & { raw: false, place: #Held & { by: $me } }
        }
    }
} @family(goals)

pack_a_meal: #Method & {
    title: "pack a meal"
    goal:  "food_along"
    rank:  1
    pre:   { find: [], match: #Cooking }
    steps: [#Achieve & { subgoal: "have_a_meal" }]
} @family(methods)

take_some_along: #Method & {
    title: "take some along"
    goal:  "food_along"
    rank:  2
    pre: {
        find:  ["food"]
        match: #Cooking & {
            me:   #Agent & { freeHands: >=1 }
            food: #Food & #Stack & { place: #Inside }
        }
    }
    order:    ["own", "keeps", "habit", "near"]
    sequence: true
    ends:     true
    steps:    [#Do & { op: "take_some", object: "food", units: 1 }]
} @family(methods)

// Cook food the actor holds at a lit stove in reach: a while, with the
// hands. It is no longer raw, and nourishes by what cooking adds to it, to
// 100 at most; a meal now, it spoils its `mealKeepsFor` from now, whatever
// it was made of (perishing/). `cook` is of all the actor holds of it, a
// pot's worth (a kilogram) at most; `cook_portion`, with a hand free, is of
// one portion: of a stack held (an armful of the harvest), one into the
// free hand, the rest still raw, as eating takes one of a stack; of a
// single portion, that portion, where it is.
#Cook:        #Operation & {
    duration: 1200s
    uses:     ["hands"]
    roles: {
        actor:       #Agent & { id: $a }
        item:        #Food & #Body & { id: $i, raw: true, nourishment: $n, cooking: $c, mealKeepsFor: $k, place: #Held & { by: $a } }
        destination: #Combustor & #Body & { lit: true }
    }
    now:   $now
    after: { item: #Food & { raw: false, nourishment: math.Clamp($n + $c, 0, 100), becomesAt: $now + $k } }
}
cook:         #Cook & { roles: { item: #Body & { mass: <=1kg } } } @family(operations)
cook_portion: #Cook & {
    // (a tag is its declaration's: #Cook's $a and $i are bound again here)
    roles: { actor: #Agent & { id: $a, freeHands: >=1 }, item: #Food & { id: $i } }
    moves: [{ moved: $i, portion: 1, into: #Held & { by: $a } }]
} @family(operations)
