// Activities (ACTIONS.md §5): an action under way is an informational
// entity, with no body and no location. Being a component, it is saved like
// any other, and so are its watches.

#ActivityStatus: "running" | "suspended" | "completed" | "exhausted" | "failed" | "aborted"

#Activity: #Thing & {
    @component(Activity)
    operation:      text                       @field(saved, proposable, inspect)
    actorRef:       ref                        @field(saved, proposable, inspect)
    itemRef:        ref                        @field(saved, proposable, inspect)
    destinationRef: ref                        @field(saved, proposable, inspect)
    amount:         int & >=0 & <=1000000      @field(content, saved, proposable, inspect)
    // what is being said, for an utterance under way
    words:          text                       @field(saved, proposable, inspect)
    // how fast the stage under way goes, in percent of its declared pace,
    // from the actor as it started (ACTIONS.md §5: rate = f(capabilities,
    // shortfall, actor modifiers); provisionally, modifiers only); 0 is 100
    pace:           int & >=0 & <=100          @field(content, saved, proposable, inspect)
    // the stage under way, the work done in it, and when it last started
    // running; due is when the stage completes (0ms while suspended, or for an
    // activity that ends by a watch or an event)
    stage:          int & >=0 & <=64           @field(content, saved, proposable, inspect)
    progress:       time & >=0ms & <=100d      @field(content, saved, proposable, inspect)
    started:        time & >=0ms & <=100d      @field(content, saved, proposable, inspect)
    due:            time & >=0ms & <=100d      @field(content, saved, proposable, inspect)
    status:         #ActivityStatus            @field(content, saved, proposable, inspect)
    // a watch (DOMAIN_SIMULATION.md §5): tell this activity when the holder's
    // water reaches watchAtLeast; no holder, no watch
    watchHolder:    ref                        @field(saved, proposable, inspect)
    watchAtLeast:   volume & >=0mL & <=10m3    @field(content, saved, proposable, inspect)
    // a watch on the air (the atmosphere domain): tell this activity when
    // the holder's carbon dioxide reaches watchDioxide (mmol), or its
    // temperature falls below watchCool or rises above watchWarm (mK); 0, no
    // watch
    watchDioxide:   int & >=0 & <=100000000    @field(content, saved, proposable, inspect)
    watchCool:      int & >=0 & <=400000       @field(content, saved, proposable, inspect)
    watchWarm:      int & >=0 & <=400000       @field(content, saved, proposable, inspect)
    // a watch on the floor (ACTIONS.md Scenario 3): water on the tile at
    // (watchX, watchY, watchLevel) reaching watchFloor (mL) interrupts it; 0,
    // no watch
    watchFloor:     int & >=0 & <=1000000      @field(content, saved, proposable, inspect)
    watchX:         int & >=0 & <=1000         @field(content, saved, proposable, inspect)
    watchY:         int & >=0 & <=1000         @field(content, saved, proposable, inspect)
    watchLevel:     int & >=0 & <=64           @field(content, saved, proposable, inspect)
}

activity: #Activity & { amount: 0, stage: 0, progress: 0ms, started: 0ms, due: 0ms, status: "running", watchAtLeast: 0mL,
                        watchDioxide: 0, watchCool: 0, watchWarm: 0, watchFloor: 0, watchX: 0, watchY: 0,
                        watchLevel: 0 }
